#!/usr/bin/env bash
# Управляется Ansible. Полная проверка каскада с ENTRY: сам ENTRY, связи
# ENTRY–EXIT и ENTRY–FRONT, DNS, отчёты EXIT и FRONT по отдельному ключу, который
# разрешает только kalimera-report. Оформление как у awg-health; в конце - сводка
# по группам: серверы, связи и задержки, DNS и итог. Код возврата: 0 - всё в
# порядке, 3 - есть замечания, 1 - ошибки.
set -Eeuo pipefail

readonly report_bin={{ cascade_check_report_path | quote }}
readonly key_path={{ cascade_check_key_path | quote }}
readonly known_hosts_path={{ cascade_check_known_hosts_path | quote }}
readonly remote_user={{ cascade_check_user | quote }}
readonly exit_host={{ cascade_check_exit_host | quote }}
readonly exit_port={{ cascade_check_exit_port | int }}
readonly front_present={{ 'true' if (cascade_check_front_present | bool) else 'false' }}
readonly front_host={{ cascade_check_front_host | quote }}
readonly front_port={{ cascade_check_front_port | int }}
readonly cdn_enabled={{ 'true' if (cascade_check_cdn_enabled | bool) else 'false' }}
readonly cdn_domain={{ cascade_check_cdn_domain | quote }}

{% raw %}
usage() { echo 'Использование: cascade-check'; }

work=''
rows_file=''
exit_code=0
sum_verdict=OK
sum_title=''
plain_line=''
declare -A counts=()
# Строки итоговой сводки: цвет (или SEP - разделитель групп) и текст.
sum_color=()
sum_text=()

# >>> kalimera-report: общий блок оформления отчёта.
# Блок одинаков в awg-health, server-audit и kalimera-updates, совпадение
# проверяет tests/test_report_style.py. Цвет, итоговая рамка и рекомендации
# выводятся только в терминал. В файл, журнал, Ansible и Telegram-монитор
# уходит прежний текст: без управляющих символов, с префиксами
# OK/FAIL/WARN/UPD/INFO, по которым эти строки разбирают.
# KALIMERA_REPORT_STYLE=fancy|plain нужен тестам; sudo эту переменную не
# пропускает.
case "${KALIMERA_REPORT_STYLE:-auto}" in
    fancy) report_fancy=true ;;
    plain) report_fancy=false ;;
    *)
        report_fancy=false
        if [[ -t 1 && -z "${NO_COLOR:-}" && "${TERM:-dumb}" != dumb ]]; then
            report_fancy=true
        fi
        ;;
esac
report_reset=$'\033[0m'
# KALIMERA_REPORT_RESULTS - файл для cascade-check: report_line записывает OK,
# report_note - FAIL и WARN с рекомендацией. Переменная сбрасывается сразу, чтобы
# вложенные awg-health или server-audit не дописывали свои строки в тот же файл.
report_results_file="${KALIMERA_REPORT_RESULTS:-}"
unset KALIMERA_REPORT_RESULTS
# Замечания для итоговой рамки: "FAIL|WARN<TAB>что не так<TAB>что сделать".
# FAIL - работа каскада нарушена критически, WARN - каскад работает.
report_notes=()
report_box_lines=()

# Строка результата: OK зелёная, FAIL и WARN жёлтые, UPD голубая.
report_line() {
    local level="$1" text="$2" color=''
    if [[ "$report_fancy" == true ]]; then
        case "$level" in
            OK) color=$'\033[32m' ;;
            FAIL|WARN) color=$'\033[33m' ;;
            UPD) color=$'\033[36m' ;;
        esac
    fi
    printf '%s%-4s %s%s\n' "$color" "$level" "$text" "${color:+$report_reset}"
    [[ "$level" != OK ]] || report_export OK "$text"
}

# Строка в файл результатов: "СТАТУС<TAB>проверка<TAB>рекомендация".
report_export() {
    [[ -n "$report_results_file" ]] || return 0
    printf '%s\t%s\t%s\n' "$1" "$2" "${3:-}" >>"$report_results_file"
}

report_note() {
    report_notes+=("$1"$'\t'"$2"$'\t'"${3:-}")
    report_export "$1" "$2" "${3:-}"
}

# $1 - цвет рамки, $2 - ширина текста, $3 - строка, $4 - цвет строки.
report_box_emit() {
    local pad=$(( $2 - ${#3} ))
    (( pad > 0 )) || pad=0
    printf '%s│%s %s%s%s%*s %s│%s\n' "$1" "$report_reset" "${4:-}" "$3" \
        "${4:+$report_reset}" "$pad" '' "$1" "$report_reset"
}

# Перенос по словам. Продолжение строки с маркером (→, ✗, !) выравнивается
# по тексту после маркера.
report_box_row() {
    local lead rest hang line word has_word=false
    local -a words=()
    lead="${3%%[![:space:]]*}"
    rest="${3#"$lead"}"
    hang="$lead"
    case "$rest" in
        '→ '*|'✗ '*|'! '*) hang+='  ' ;;
    esac
    read -r -a words <<<"$rest" || true
    line="$lead"
    for word in "${words[@]}"; do
        if [[ "$has_word" == true ]] && (( ${#line} + 1 + ${#word} > $2 )); then
            report_box_emit "$1" "$2" "$line" "${4:-}"
            line="$hang$word"
        elif [[ "$has_word" == true ]]; then
            line+=" $word"
        else
            line+="$word"
        fi
        has_word=true
    done
    report_box_emit "$1" "$2" "$line" "${4:-}"
}

# Итоговая рамка: $1 - OK (зелёная), WARN (жёлтая) или FAIL (красная),
# $2 - заголовок, дальше строки содержимого.
report_box() {
    [[ "$report_fancy" == true ]] || return 0
    local LC_ALL=C.UTF-8
    local status="$1" title="$2" color width inner rule line
    shift 2
    case "$status" in
        OK) color=$'\033[1;32m' ;;
        WARN) color=$'\033[1;33m' ;;
        *) color=$'\033[1;31m' ;;
    esac
    width="$(tput cols 2>/dev/null || true)"
    [[ "$width" =~ ^[0-9]+$ ]] || width=80
    (( width <= 100 )) || width=100
    (( width >= 40 )) || width=40
    inner=$(( width - 4 ))
    printf -v rule '%*s' "$(( width - 2 ))" ''
    rule="${rule// /─}"
    printf '\n%s┌%s┐%s\n' "$color" "$rule" "$report_reset"
    report_box_row "$color" "$inner" "$status  $title" "$color"
    if (( $# > 0 )); then
        printf '%s├%s┤%s\n' "$color" "$rule" "$report_reset"
        for line in "$@"; do
            report_box_row "$color" "$inner" "$line"
        done
    fi
    printf '%s└%s┘%s\n' "$color" "$rule" "$report_reset"
}

# Замечания -> строки рамки в report_box_lines: сначала критичные (✗), потом
# остальные (!). Одинаковая рекомендация печатается один раз после всех
# замечаний, к которым она относится. Не больше 12 замечаний: остальные
# видны в строках выше.
report_note_lines() {
    local severity marker note level text hint key shown=0 hidden=0 group_shown
    local -a order=()
    local -A texts=()
    report_box_lines=()
    for severity in FAIL WARN; do
        marker='!'
        [[ "$severity" != FAIL ]] || marker='✗'
        order=()
        texts=()
        for note in "${report_notes[@]}"; do
            IFS=$'\t' read -r level text hint <<<"$note" || true
            [[ "$level" == "$severity" ]] || continue
            key="k:$hint"
            if [[ -z "${texts[$key]+set}" ]]; then
                order+=("$key")
                texts[$key]=''
            fi
            texts[$key]+="$text"$'\n'
        done
        for key in "${order[@]}"; do
            group_shown=false
            while IFS= read -r text; do
                [[ -n "$text" ]] || continue
                if (( shown < 12 )); then
                    report_box_lines+=("$marker $text")
                    shown=$((shown + 1))
                    group_shown=true
                else
                    hidden=$((hidden + 1))
                fi
            done <<<"${texts[$key]}"
            hint="${key#k:}"
            if [[ "$group_shown" == true && -n "$hint" ]]; then
                report_box_lines+=("  → $hint")
            fi
        done
    done
    if (( hidden > 0 )); then
        report_box_lines+=("… и ещё замечаний: $hidden, они отмечены в строках выше")
    fi
}
# <<< kalimera-report

# Цвета итоговой сводки: серверы - по статусу сервера, связи и задержки - голубым
# при OK, DNS - по статусу, итог - по общему статусу.
c_ok=$'\033[32m'
c_info=$'\033[36m'
c_warn=$'\033[33m'
c_fail=$'\033[31m'
c_head=$'\033[1m'

# Текст с удалённых серверов очищается от управляющих символов: чужой вывод не
# должен менять экран или подменять строки отчёта.
clean_text() {
    LC_ALL=C tr -d '\000-\010\013-\037\177' <<<"$1"
}

# Строка отчёта: СЕГМЕНТ, СТАТУС, ПРОВЕРКА, ЗНАЧЕНИЕ, РЕКОМЕНДАЦИЯ, МИЛЛИСЕКУНДЫ.
emit_row() {
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "${4:-}" "${5:-}" "${6:-}" >>"$rows_file"
}

# Разбор строки на шесть полей. Пустые поля сохраняются: read с IFS-табуляцией
# сдвинул бы их, поэтому делим вручную.
split_row() {
    local rest="$1"
    seg="${rest%%$'\t'*}"
    rest="${rest#*$'\t'}"
    status="${rest%%$'\t'*}"
    rest="${rest#*$'\t'}"
    label="${rest%%$'\t'*}"
    rest="${rest#*$'\t'}"
    value="${rest%%$'\t'*}"
    rest="${rest#*$'\t'}"
    hint="${rest%%$'\t'*}"
    ms="${rest#*$'\t'}"
}

# Строки kalimera-report: local - свой отчёт (сегменты ENTRY, LINK или DNS);
# удалённый отчёт получает сегмент от этого вызова, а связь (LINK) сохраняет.
import_rows() {
    local expected="$1" raw="$2" line tabs seg status label value hint ms
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="$(clean_text "$line")"
        tabs="${line//[^$'\t']/}"
        [[ ${#tabs} -eq 5 ]] || continue
        split_row "$line"
        case "$status" in
            OK|WARN|FAIL) ;;
            *) continue ;;
        esac
        [[ -n "$label" ]] || continue
        ms="${ms//[!0-9]/}"
        if [[ "$expected" == local ]]; then
            case "$seg" in
                ENTRY|LINK|DNS) ;;
                *) seg=ENTRY ;;
            esac
        else
            case "$seg" in
                LINK) ;;
                *) seg="$expected" ;;
            esac
        fi
        emit_row "$seg" "$status" "$label" "$value" "$hint" "$ms"
    done <"$raw"
}

# Время TCP-подключения в миллисекундах; ошибка, если порт молчит 5 с.
tcp_ms() {
    local host="$1" port="$2" started finished
    if [[ -z "$host" ]] || (( port <= 0 )); then
        return 1
    fi
    started="$(date +%s%N)"
    # shellcheck disable=SC2016
    timeout 5 bash -c 'exec 3<>"/dev/tcp/$0/$1"' "$host" "$port" 2>/dev/null || return 1
    finished="$(date +%s%N)"
    printf '%s\n' $(( (finished - started) / 1000000 ))
}

# Связь ENTRY с соседним сервером по SSH: задержка TCP-подключения к SSH-порту.
tcp_row() {
    local label="$1" host="$2" port="$3" ms
    if ms="$(tcp_ms "$host" "$port")"; then
        if (( ms > 300 )); then
            emit_row LINK WARN "$label" "TCP $ms мс: высокая задержка" 'проверьте загрузку сервера и хостинг; awg-health --strict на нём' "$ms"
        else
            emit_row LINK OK "$label" "TCP $ms мс" '' "$ms"
        fi
    else
        emit_row LINK FAIL "$label" 'порт не отвечает за 5 с' 'проверьте UFW и доступность сервера; SSH-порт должен совпадать с inventory'
    fi
}

link_rows() {
    tcp_row 'ENTRY → EXIT: SSH' "$exit_host" "$exit_port"
    if [[ "$front_present" == true ]]; then
        tcp_row 'ENTRY → FRONT: SSH' "$front_host" "$front_port"
    fi
}

collect_local() {
    local raw="$work/entry.raw" rc=0
    if [[ ! -x "$report_bin" ]]; then
        emit_row ENTRY FAIL 'kalimera-report не установлен' '' 'на ENTRY: kalimera-deploy --resume'
        return 0
    fi
    "$report_bin" --tsv >"$raw" 2>/dev/null || rc=$?
    import_rows local "$raw"
    if (( rc != 0 )); then
        emit_row ENTRY FAIL 'локальный отчёт ENTRY' "код возврата $rc" 'на ENTRY: kalimera-deploy --resume; сообщите вывод cascade-check'
    fi
}

# Удалённый отчёт: один SSH-вызов по ключу, который разрешает только kalimera-report.
# -F /dev/null отключает пользовательскую конфигурацию ssh, известный хост
# проверяется по файлу, записанному при установке.
collect_remote() {
    local segment_name="$1" host="$2" port="$3" raw="$work/$1.raw" err="$work/$1.err"
    local rc=0 count reason
    if [[ ! -r "$key_path" ]]; then
        emit_row "$segment_name" FAIL 'ключ cascade-check' 'файл ключа отсутствует' 'на ENTRY: kalimera-deploy --resume создаст ключ'
        return 0
    fi
    timeout 150 ssh -F /dev/null -n \
        -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=5 -o ServerAliveCountMax=3 \
        -o IdentitiesOnly=yes -o PasswordAuthentication=no -o KbdInteractiveAuthentication=no \
        -o StrictHostKeyChecking=yes -o UserKnownHostsFile="$known_hosts_path" -o LogLevel=ERROR \
        -i "$key_path" -p "$port" "$remote_user@$host" >"$raw" 2>"$err" || rc=$?
    import_rows "$segment_name" "$raw"
    count="$(awk -F'\t' -v s="$segment_name" '$1 == s { n++ } END { print n + 0 }' "$rows_file")"
    if (( rc != 0 || count == 0 )); then
        reason="$(clean_text "$(head -n 1 "$err" 2>/dev/null || true)")"
        [[ -n "$reason" ]] || reason="код возврата $rc, строк отчёта: $count"
        emit_row "$segment_name" FAIL 'удалённый отчёт по SSH' "$reason" 'на ENTRY: kalimera-deploy --resume восстановит ключ и доступ kalimera-report; при Permission denied проверьте authorized_keys пользователя kalimera-report'
    fi
}

# Цвет и отметка строки детального отчёта: OK - зелёный, WARN - жёлтый, FAIL -
# красный. Без терминала - прежний формат report_line.
status_line() {
    local color
    if [[ "$report_fancy" != true ]]; then
        report_line "$1" "$2"
        return 0
    fi
    case "$1" in
        OK) color=$'\033[32m' ;;
        WARN) color=$'\033[33m' ;;
        *) color=$'\033[31m' ;;
    esac
    printf '%s%-4s %s%s\n' "$color" "$1" "$2" "$report_reset"
}

# CDN с точки зрения ENTRY: TLS-рукопожатие с проверкой сертификата и ответ
# edge-узла по HTTPS без тела запроса. Аплинк через CDN проверяет FRONT: его
# строки CDN попадают в одну группу сводки.
cdn_rows() {
    local output code appconnect total tls_ms ms
    if output="$(curl -4 -sS -o /dev/null --max-time 10 -w '%{http_code} %{time_appconnect} %{time_total}' "https://$cdn_domain/" 2>/dev/null)"; then
        read -r code appconnect total <<<"$output"
        tls_ms="$(awk -v t="$appconnect" 'BEGIN { printf "%d", t * 1000 }')"
        ms="$(awk -v t="$total" 'BEGIN { printf "%d", t * 1000 }')"
        case "$code" in
            5??)
                emit_row CDN WARN 'CDN: HTTPS-ответ edge' "HTTP $code, TLS за $tls_ms мс" 'edge CDN отвечает ошибкой: проверьте origin-домен FRONT и настройки CDN в панели провайдера' "$ms"
                ;;
            *)
                emit_row CDN OK 'CDN: TLS и HTTPS' "TLS за $tls_ms мс, HTTP $code, всего $ms мс" '' "$ms"
                ;;
        esac
    else
        emit_row CDN FAIL 'CDN: TLS и HTTPS' 'нет ответа или сертификат не прошёл проверку за 10 с' 'проверьте домен CDN, сертификат origin и настройки CDN; на FRONT: awg-health --strict'
    fi
}

section_title() {
    if [[ "$report_fancy" == true ]]; then
        printf '\n\033[1;36m%s\033[0m\n' "$1"
    else
        printf '\n%s\n' "$1"
    fi
}

# Рекомендации по всем непройденным проверкам: сначала FAIL, потом WARN.
# Одинаковая рекомендация печатается один раз, без ограничения числа строк.
print_recommendations() {
    local severity note level text hint key marker color
    local printed=false
    local -a order=()
    local -A texts=()
    for severity in FAIL WARN; do
        order=()
        texts=()
        for note in "${report_notes[@]}"; do
            IFS=$'\t' read -r level text hint <<<"$note" || true
            [[ "$level" == "$severity" ]] || continue
            key="k:$hint"
            if [[ -z "${texts[$key]+set}" ]]; then
                order+=("$key")
                texts[$key]=''
            fi
            texts[$key]+="$text"$'\n'
        done
        if [[ "$severity" == FAIL ]]; then
            marker='✗'
            color=$'\033[31m'
        else
            marker='!'
            color=$'\033[33m'
        fi
        for key in "${order[@]}"; do
            if [[ "$printed" == false ]]; then
                printf '\nРекомендации:\n'
                printed=true
            fi
            while IFS= read -r text; do
                [[ -n "$text" ]] || continue
                if [[ "$report_fancy" == true ]]; then
                    printf '%s%s %s%s\n' "$color" "$marker" "$text" "$report_reset"
                else
                    printf '%s %s\n' "$marker" "$text"
                fi
            done <<<"${texts[$key]}"
            hint="${key#k:}"
            [[ -z "$hint" ]] || printf '  → %s\n' "$hint"
        done
    done
}

# Строка сводки. Заголовок группы отделяется разделителем от предыдущей группы.
sum_head() {
    if (( ${#sum_text[@]} > 0 )); then
        sum_color+=(SEP)
        sum_text+=('')
    fi
    sum_color+=("$c_head")
    sum_text+=("$1")
}

sum_add() {
    sum_color+=("$1")
    sum_text+=("$2")
}

# Цвет статуса: OK - зелёный, WARN - жёлтый, FAIL - красный.
status_color() {
    case "$1" in
        OK) printf '%s' "$c_ok" ;;
        WARN) printf '%s' "$c_warn" ;;
        *) printf '%s' "$c_fail" ;;
    esac
}

# Задержка TCP-подключения из строки связи по её названию (пусто, если нет).
rtt_of() {
    awk -F'\t' -v wanted="$1" '$3 == wanted { print $6; exit }' "$rows_file"
}

reach_text() {
    if [[ -n "$1" ]]; then
        printf 'отклик %s мс (SSH)' "$1"
    else
        printf 'отклик недоступен'
    fi
}

# Итог и строки сводки по группам: серверы (цвет по статусу, отклик по SSH),
# связи и задержки (голубой при OK), DNS (статус каждой проверки), итог.
build_summary() {
    local section seg status label value ms line text color
    local ok warn fail worst reach
    local total_ok=0 total_warn=0 total_fail=0
    local dns_total=0 dns_passed=0 dns_worst=OK

    for section in ENTRY EXIT FRONT LINK CDN DNS; do
        ok="${counts[$section:OK]:-0}"
        warn="${counts[$section:WARN]:-0}"
        fail="${counts[$section:FAIL]:-0}"
        total_ok=$((total_ok + ok))
        total_warn=$((total_warn + warn))
        total_fail=$((total_fail + fail))
    done
    if (( total_fail > 0 )); then
        sum_verdict=FAIL
        sum_title='работа каскада нарушена'
        plain_line="BAD: ошибок: $total_fail, замечаний: $total_warn"
        exit_code=1
    elif (( total_warn > 0 )); then
        sum_verdict=WARN
        sum_title='каскад работает, есть замечания'
        plain_line="WARN: каскад работает, замечаний: $total_warn"
        exit_code=3
    else
        sum_verdict=OK
        sum_title='все проверки пройдены'
        plain_line="GOOD: все проверки пройдены ($total_ok)"
        exit_code=0
    fi

    sum_head 'СЕРВЕРЫ'
    for section in ENTRY EXIT FRONT; do
        if [[ "$section" == FRONT && "$front_present" != true ]]; then
            continue
        fi
        ok="${counts[$section:OK]:-0}"
        warn="${counts[$section:WARN]:-0}"
        fail="${counts[$section:FAIL]:-0}"
        worst=OK
        if (( warn > 0 )); then
            worst=WARN
        fi
        if (( fail > 0 )); then
            worst=FAIL
        fi
        case "$section" in
            ENTRY) reach='локальный узел' ;;
            EXIT) reach="$(reach_text "$(rtt_of 'ENTRY → EXIT: SSH')")" ;;
            *) reach="$(reach_text "$(rtt_of 'ENTRY → FRONT: SSH')")" ;;
        esac
        sum_add "$(status_color "$worst")" "$section: OK $ok · WARN $warn · FAIL $fail · $reach"
    done

    sum_head 'СВЯЗИ И ЗАДЕРЖКИ'
    while IFS= read -r line; do
        split_row "$line"
        [[ "$seg" == LINK ]] || continue
        case "$status" in
            OK) color="$c_info" ;;
            WARN) color="$c_warn" ;;
            *) color="$c_fail" ;;
        esac
        text="$label"
        [[ -z "$value" ]] || text+=": $value"
        sum_add "$color" "$text"
    done <"$rows_file"

    sum_head 'CDN'
    if [[ "$cdn_enabled" != true ]]; then
        sum_add "$c_info" 'CDN не используется в каскаде'
    else
        while IFS= read -r line; do
            split_row "$line"
            [[ "$seg" == CDN ]] || [[ "$seg" == FRONT && "$label" == *CDN* ]] || continue
            case "$status" in
                OK) color="$c_info" ;;
                WARN) color="$c_warn" ;;
                *) color="$c_fail" ;;
            esac
            text="$label"
            [[ -z "$value" ]] || text+=": $value"
            sum_add "$color" "$text"
        done <"$rows_file"
    fi

    sum_head 'DNS'
    while IFS= read -r line; do
        split_row "$line"
        [[ "$seg" == DNS ]] || continue
        dns_total=$((dns_total + 1))
        case "$status" in
            OK) dns_passed=$((dns_passed + 1)) ;;
            WARN)
                if [[ "$dns_worst" == OK ]]; then
                    dns_worst=WARN
                fi
                ;;
            *) dns_worst=FAIL ;;
        esac
        text="$label"
        if [[ -n "$ms" ]]; then
            text+=": $ms мс"
        else
            [[ -z "$value" ]] || text+=": $value"
        fi
        sum_add "$(status_color "$status")" "$text"
    done <"$rows_file"
    if (( dns_total == 0 )); then
        sum_add "$c_warn" 'статус DNS: проверки не выполнены'
    else
        sum_add "$(status_color "$dns_worst")" "статус DNS: $dns_worst ($dns_passed из $dns_total)"
    fi

    sum_head 'ИТОГ'
    sum_add "$(status_color "$sum_verdict")" "ИТОГ: OK $total_ok · WARN $total_warn · FAIL $total_fail"
}

# Печать сводки. В терминале - рамка цветом итога с группами; без терминала -
# прежние строки и итог GOOD / WARN / BAD.
print_summary() {
    local i border width inner rule
    if [[ "$report_fancy" != true ]]; then
        for i in "${!sum_text[@]}"; do
            [[ "${sum_color[$i]}" != SEP ]] || continue
            printf '%s\n' "${sum_text[$i]}"
        done
        printf '%s\n' "$plain_line"
        return 0
    fi
    local LC_ALL=C.UTF-8
    case "$sum_verdict" in
        OK) border=$'\033[1;32m' ;;
        WARN) border=$'\033[1;33m' ;;
        *) border=$'\033[1;31m' ;;
    esac
    width="$(tput cols 2>/dev/null || true)"
    [[ "$width" =~ ^[0-9]+$ ]] || width=80
    (( width <= 100 )) || width=100
    (( width >= 40 )) || width=40
    inner=$(( width - 4 ))
    printf -v rule '%*s' "$(( width - 2 ))" ''
    rule="${rule// /─}"
    printf '\n%s┌%s┐%s\n' "$border" "$rule" "$report_reset"
    report_box_row "$border" "$inner" "$sum_verdict  cascade-check: $sum_title" "$border"
    printf '%s├%s┤%s\n' "$border" "$rule" "$report_reset"
    for i in "${!sum_text[@]}"; do
        if [[ "${sum_color[$i]}" == SEP ]]; then
            printf '%s├%s┤%s\n' "$border" "$rule" "$report_reset"
        else
            report_box_row "$border" "$inner" "${sum_text[$i]}" "${sum_color[$i]}"
        fi
    done
    printf '%s└%s┘%s\n' "$border" "$rule" "$report_reset"
}

render() {
    local section seg status label value hint text line
    local -a sections=(ENTRY DNS LINK CDN EXIT FRONT)
    local -A titles=()
    titles[ENTRY]='ENTRY: локальные проверки'
    titles[DNS]='DNS: резолверы и маршруты'
    titles[LINK]='СВЯЗИ КАСКАДА: задержки и выход'
    titles[EXIT]='EXIT: удалённый отчёт'
    titles[FRONT]='FRONT: удалённый отчёт'
    titles[CDN]='CDN: проверка с ENTRY'

    for section in "${sections[@]}"; do
        section_title "${titles[$section]}"
        if [[ ( "$section" == FRONT && "$front_present" != true ) || ( "$section" == CDN && "$cdn_enabled" != true ) ]]; then
            printf 'в каскаде не используется\n'
            continue
        fi
        while IFS= read -r line; do
            split_row "$line"
            [[ "$seg" == "$section" ]] || continue
            text="$label"
            [[ -z "$value" ]] || text+=": $value"
            status_line "$status" "$text"
            counts["$section:$status"]=$(( ${counts["$section:$status"]:-0} + 1 ))
            [[ "$status" == OK ]] || report_note "$status" "$text" "$hint"
        done <"$rows_file"
    done

    print_recommendations
    build_summary
    print_summary
}

main() {
    case "${1:-}" in
        '') [[ $# -eq 0 ]] || { usage >&2; exit 2; } ;;
        --help|-h) [[ $# -eq 1 ]] || { usage >&2; exit 2; }; usage; exit 0 ;;
        *) usage >&2; exit 2 ;;
    esac
    [[ $EUID -eq 0 ]] || { echo 'cascade-check запускается через управление KalimeraWG (root).' >&2; exit 1; }
    work="$(mktemp -d /run/cascade-check.XXXXXX)"
    trap 'rm -rf "$work"' EXIT
    rows_file="$work/rows.tsv"
    : >"$rows_file"

    collect_local
    link_rows
    if [[ "$cdn_enabled" == true ]]; then
        cdn_rows
    fi
    collect_remote EXIT "$exit_host" "$exit_port"
    if [[ "$front_present" == true ]]; then
        collect_remote FRONT "$front_host" "$front_port"
    fi
    render
    exit "$exit_code"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
{% endraw %}
