#!/usr/bin/env bash
# Управляется Ansible. Отчёт о роли сервера для cascade-check: одна строка на
# проверку, поля разделены табуляцией: СЕГМЕНТ, СТАТУС (OK, WARN или FAIL),
# ПРОВЕРКА, ЗНАЧЕНИЕ, РЕКОМЕНДАЦИЯ, МИЛЛИСЕКУНДЫ (пусто, если не измерялось).
# Запускается от root: локально cascade-check и удалённо по ключу, который
# разрешает через sudo только эту команду.
set -Eeuo pipefail

readonly segment={{ (awg_node_role | default('unknown')) | upper | quote }}
readonly entry_client_listen={{ (entry_client_listen_address | default('')) | quote }}
readonly entry_dns_port={{ (entry_dns_default_port | default(5353)) | int }}
readonly entry_dns_ru_port={{ (entry_dns_ru_port | default(5354)) | int }}
readonly entry_exit_iface={{ (entry_exit_interface | default('')) | quote }}
# Резервный EXIT: на ENTRY - интерфейс второго туннеля (пусто, если его нет), на
# самом резервном EXIT - признак, по которому его строки связи отличаются от основного.
readonly entry_standby_iface={{ ((entry_standby_exit_interface | default('awg4')) if (entry_standby_exit_enabled | default(false) | bool) else '') | quote }}
readonly exit_title={{ ('резервного EXIT' if (exit_standby | default(false) | bool) else 'EXIT') | quote }}
readonly ru_proxy_enabled={{ 'true' if (entry_ru_proxy_enabled | default(false) | bool) else 'false' }}
readonly ru_dot_active={{ 'true' if (entry_dns_ru_dot_active | default(false) | bool) else 'false' }}
readonly ru_proxy_selected={{ 'true' if ((entry_ru_proxy_enabled | default(false) | bool) and (entry_ru_proxy_scope | default('all')) == 'selected') else 'false' }}
# Зарубежные имена через резолвер EXIT: что задано в inventory и файл, по которому
# видно, что действует на самом деле.
readonly dns_via_exit={{ 'true' if (entry_dns_default_via_exit | default(false) | bool) else 'false' }}
readonly dot_config={{ ((entry_unbound_config_dir | default('/etc/unbound/unbound.conf.d')) ~ '/90-awg-dot.conf') | quote }}
readonly ru_proxy_service={{ (sing_box_service_name | default('sing-box.service')) | quote }}
readonly ru_proxy_manual_flag={{ (entry_ru_proxy_manual_disabled_flag | default('/var/lib/awg-routing/ru-proxy.manual-off')) | quote }}
readonly ru_proxy_failopen_flag={{ (entry_ru_proxy_disabled_flag | default('/run/awg-ru-proxy.disabled')) | quote }}
readonly front_entry_host={{ (front_entry_address | default('')) | quote }}
readonly front_entry_port={{ (front_entry_reality_port | default(0)) | int }}
readonly maintenance_state={{ (awg_maintenance_state_path | default('/run/awg-maintenance.state')) | quote }}
readonly self_heal={{ (awg_self_heal_path | default('/usr/local/sbin/self-heal')) | quote }}
readonly auto_reboot={{ 'true' if (awg_auto_reboot_enabled | default(true) | bool) else 'false' }}
readonly auto_reboot_block={{ ((awg_auto_reboot_state_dir | default('/var/lib/kalimera/cascade-reboot')) ~ '/auto-blocked') | quote }}
readonly reboot_overdue_days={{ (awg_auto_reboot_overdue_days | default(21)) | int }}
readonly updates_state={{ ((kalimera_updates_state_dir | default('/run/kalimera-updates')) ~ '/state') | quote }}
readonly telegram_enabled={{ 'true' if (awg_telegram_monitor_enabled | default(false) | bool) else 'false' }}
readonly telegram_monitor={{ (awg_telegram_monitor_path | default('/usr/local/sbin/awg-telegram-monitor')) | quote }}
readonly watchdog_enabled={{ 'true' if (awg_watchdog_enabled | default(true) | bool) else 'false' }}
readonly watchdog_sysfs={{ (awg_watchdog_sysfs_dir | default('/sys/class/watchdog/watchdog0')) | quote }}
readonly vmstat_file={{ (awg_memory_vmstat_path | default('/proc/vmstat')) | quote }}
readonly meminfo_file={{ (awg_memory_meminfo_path | default('/proc/meminfo')) | quote }}
readonly controller_backup={{ 'true' if ((runtime_secrets_enabled | default(false) | bool) and ((runtime_secrets_controller_vault_password_path | default('')) | length > 0)) else 'false' }}
readonly controller_backup_status={{ ((awg_controller_backup_dir | default('/var/lib/kalimera/controller-backup')) ~ '/status') | quote }}
readonly controller_backup_stale_days={{ (awg_controller_backup_stale_days | default(3)) | int }}

{% raw %}
usage() { echo 'Использование: kalimera-report --tsv'; }

work=''
ru_state=off

# Строка отчёта: СЕГМЕНТ, СТАТУС, ПРОВЕРКА, ЗНАЧЕНИЕ, РЕКОМЕНДАЦИЯ, МИЛЛИСЕКУНДЫ.
# Табуляции и переводы строк в тексте заменяются пробелом, миллисекунды - только
# цифры, поэтому полей всегда шесть.
emit() {
    local seg="$1" status="$2" label="$3" value="${4:-}" hint="${5:-}" ms="${6:-}"
    label="${label//$'\t'/ }"
    value="${value//$'\t'/ }"
    hint="${hint//$'\t'/ }"
    label="${label//$'\n'/ }"
    value="${value//$'\n'/ }"
    hint="${hint//$'\n'/ }"
    ms="${ms//[!0-9]/}"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$seg" "$status" "$label" "$value" "$hint" "$ms"
}

# Строка текущего сервера.
add() {
    emit "$segment" "$@"
}

# Строки awg-health и server-audit: "СТАТУС<TAB>проверка<TAB>рекомендация".
# Строка "строгая проверка роли" дублирует awg-health и пропускается.
import_rows() {
    local file="$1" status label hint
    [[ -r "$file" ]] || return 0
    while IFS=$'\t' read -r status label hint; do
        case "$status" in
            OK|WARN|FAIL) ;;
            *) continue ;;
        esac
        case "$label" in
            'строгая проверка роли'*) continue ;;
        esac
        add "$status" "$label" '' "${hint:-}"
    done <"$file"
}

# Запуск команды без её вывода: awg-health и server-audit пишут строки в файл
# результатов, а ненулевой код возврата - обычный итог проверки.
run_report() {
    local file="$1"
    shift
    KALIMERA_REPORT_STYLE=plain KALIMERA_REPORT_RESULTS="$file" "$@" >/dev/null 2>&1 || true
}

# Итог последнего ночного обслуживания, если оно не прошло: время, этап и названия
# проверок. Журнал службы в RAM вытесняется раньше, чем его успевают посмотреть.
maintenance_failure() {
    local status='' when='' stage='' details=''
    [[ -r "$maintenance_state" ]] || return 0
    IFS=$'\t' read -r status when stage details <"$maintenance_state" || true
    [[ "$status" == FAIL ]] || return 0
    printf '%s, этап «%s»%s' "$when" "$stage" "${details:+: $details}"
}

# Неисправный модуль - замечание, а не отказ каскада: у каждой службы, через
# которую идёт трафик, есть своя проверка. Раньше из-за одного неудачного ночного
# обслуживания отчёт сообщал «работа каскада нарушена» при исправном каскаде.
check_services() {
    local failed units hint reason
    failed="$(systemctl --failed --no-legend --plain --no-pager 2>/dev/null |
        awk 'NF && $1 != "awg-server-audit.service" { print $1 }' || true)"
    if [[ -z "$failed" ]]; then
        add OK 'неисправные модули systemd отсутствуют'
    else
        units="$(paste -sd ',' <<<"$failed" | sed 's/,/, /g')"
        hint='причина: sudo journalctl -u ИМЯ -b --no-pager; затем sudo systemctl restart ИМЯ'
        if grep -Fxq awg-maintenance.service <<<"$failed"; then
            reason="$(maintenance_failure)"
            if [[ -n "$reason" ]]; then
                hint="ночное обслуживание $reason; повторить: sudo systemctl start awg-maintenance.service"
                [[ "$failed" == awg-maintenance.service ]] ||
                    hint+='; остальные модули: sudo journalctl -u ИМЯ -b --no-pager'
            fi
        fi
        add WARN 'неисправные модули systemd' "$units" "$hint"
    fi
}

# Итог самовосстановления за неделю: сколько было сбоев, сколько восстановлено и
# какие ошибки не устранены. Строку собирает сама служба: счёт ведётся в одном
# месте. Поля разделены символом US (0x1f), а не табуляцией: read склеивает
# соседние табуляции, и пустое значение сдвинуло бы рекомендацию на его место.
check_self_heal() {
    local line status='' label='' value='' hint=''
    [[ -x "$self_heal" ]] || return 0
    line="$("$self_heal" --report 2>/dev/null || true)"
    [[ -n "$line" ]] || return 0
    IFS=$'\x1f' read -r status label value hint <<<"$line" || true
    case "$status" in
        OK|WARN|FAIL) add "$status" "$label" "$value" "$hint" ;;
    esac
}

# Перезагрузка после обновления. При включённой автоматической перезагрузке
# ожидание еженедельного окна - обычное состояние, а не замечание: иначе отчёт
# почти всегда показывал бы WARN. Замечание появляется, когда автоматика
# остановлена после неудачи или перезагрузка ждёт дольше положенного.
check_reboot() {
    local marker=/var/run/reboot-required age_days=0
    if [[ "$segment" == ENTRY && -e "$auto_reboot_block" ]]; then
        add WARN 'автоматическая перезагрузка каскада остановлена' "$(head -n 1 "$auto_reboot_block" 2>/dev/null || true)" \
            'подробности: cascade-reboot status; возобновить после устранения причины: cascade-reboot auto on'
    fi
    if [[ ! -e "$marker" ]]; then
        add OK 'перезагрузка не требуется'
        return 0
    fi
    if [[ "$auto_reboot" != true ]]; then
        add WARN 'требуется перезагрузка после обновления системы' 'файл /var/run/reboot-required' \
            'на ENTRY: cascade-reboot --yes перезагрузит серверы каскада по одному с проверкой'
        return 0
    fi
    age_days=$(( ($(date +%s) - $(stat -c %Y "$marker" 2>/dev/null || date +%s)) / 86400 ))
    if (( age_days > reboot_overdue_days )); then
        add WARN 'требуется перезагрузка после обновления системы' "ждёт $age_days дн., автоматическая не выполнена" \
            'причина: на ENTRY cascade-reboot status; вручную: cascade-reboot --yes'
    else
        add OK 'перезагрузка после обновления выполнится автоматически' 'ожидает еженедельного окна'
    fi
}

# Сторож зависания: без него зависшая система остаётся висеть до ручного сброса.
# Строка сообщает, что есть на самом деле: сторож взведён, не взведён или его нет.
# Отсутствие сторожа - не замечание: модуля softdog нет в части облачных ядер, и
# исправить это на сервере нечем.
check_watchdog() {
    local identity='' state='' timeout=''
    [[ "$watchdog_enabled" == true ]] || return 0
    if [[ ! -d "$watchdog_sysfs" ]]; then
        add OK 'сторож зависания недоступен' 'в ядре нет устройства сторожа и модуля softdog'
        return 0
    fi
    identity="$(cat "$watchdog_sysfs/identity" 2>/dev/null || true)"
    identity="${identity:-устройство сторожа}"
    if [[ ! -r "$watchdog_sysfs/state" ]]; then
        add OK 'сторож зависания установлен' "$identity; состояние ядро не сообщает"
        return 0
    fi
    state="$(cat "$watchdog_sysfs/state" 2>/dev/null || true)"
    timeout="$(cat "$watchdog_sysfs/timeout" 2>/dev/null || true)"
    if [[ "$state" == active ]]; then
        add OK 'сторож зависания взведён' "$identity, ${timeout:-?} с"
    else
        add WARN 'сторож зависания не взведён' "$identity" \
            'sudo systemctl daemon-reexec; если строка осталась - на ENTRY: kalimera-deploy --resume'
    fi
}

# Нехватка памяти. Счётчик oom_kill ядро ведёт с загрузки: сколько раз оно
# завершало процессы, потому что память кончилась. Журнал в RAM к моменту проверки
# уже вытеснен, а счётчик остаётся до перезагрузки.
check_memory() {
    local kills total available now_text
    kills="$(awk '$1 == "oom_kill" { print $2 }' "$vmstat_file" 2>/dev/null || true)"
    [[ "$kills" =~ ^[0-9]+$ ]] || return 0
    total="$(awk '$1 == "MemTotal:" { print int($2 / 1024) }' "$meminfo_file" 2>/dev/null || true)"
    available="$(awk '$1 == "MemAvailable:" { print int($2 / 1024) }' "$meminfo_file" 2>/dev/null || true)"
    now_text="доступно ${available:-?} из ${total:-?} МБ"
    if (( kills == 0 )); then
        add OK 'нехватки памяти с загрузки сервера не было' "$now_text"
    else
        add WARN 'ядро завершало процессы из-за нехватки памяти' "с загрузки сервера: $kills; сейчас $now_text" \
            'службы каскада перезапускаются сами; если повторяется - увеличьте память сервера. Отметка снимается перезагрузкой'
    fi
}

# Резервная копия состояния контроллера. ENTRY - единственное место, где лежат
# inventory, пароль Vault и состояние клиентов; копия на EXIT и FRONT позволяет
# восстановить его на новом сервере. Строка есть только на ENTRY, который сам
# управляет каскадом. Поля итога разделены табуляцией и никогда не пусты подряд,
# кроме двух списков: они разбираются отдельно от времени.
check_controller_backup() {
    local line epoch when stored failed rest age_days
    [[ "$controller_backup" == true ]] || return 0
    line="$(head -n 1 "$controller_backup_status" 2>/dev/null || true)"
    epoch="${line%%$'\t'*}"
    if [[ ! "$epoch" =~ ^[0-9]+$ ]]; then
        add WARN 'резервная копия состояния контроллера не создана' '' \
            'на ENTRY: controller-backup; затем сохраните ключ: controller-backup key'
        return 0
    fi
    rest="${line#*$'\t'}"
    when="${rest%%$'\t'*}"
    rest="${rest#*$'\t'}"
    rest="${rest#*$'\t'}"
    stored="${rest%%$'\t'*}"
    rest="${rest#*$'\t'}"
    failed="${rest%%$'\t'*}"
    stored="${stored^^}"
    failed="${failed^^}"
    age_days=$(( ($(date +%s) - epoch) / 86400 ))
    if [[ -n "$failed" || -z "$stored" ]]; then
        add WARN 'резервная копия состояния контроллера сохранена не на всех серверах' \
            "$when: нет на ${failed//,/, }" \
            'проверьте связь с сервером, затем на ENTRY: controller-backup'
    elif (( age_days >= controller_backup_stale_days )); then
        add WARN 'резервная копия состояния контроллера устарела' "$when" \
            'на ENTRY: controller-backup; причина: sudo systemctl --no-pager status kalimera-controller-backup.service'
    else
        add OK 'резервная копия состояния контроллера сохранена' "$when: ${stored//,/, }"
    fi
}

# Строка о TLS-сертификате каскада из последней проверки kalimera-updates на FRONT.
# Срок виден всегда, а не только при замечании: по нему сводка составляет группу
# «СЕРТИФИКАТЫ». Остаток дней считается на момент отчёта, до конца дня окончания.
# $1 - итог проверки (OK, WARN или INFO), $2 - её текст, $3 - как продлить.
cert_row() {
    local level="$1" message="$2" action="$3" title verb expiry epoch days value
    local re='^(сертификат .+) (действует до|истекает|истёк) ([0-9]{4}-[0-9]{2}-[0-9]{2})'
    if [[ ! "$message" =~ $re ]]; then
        # Срок не определён: домен не ответил по TLS. Сертификат без известного
        # срока - замечание: ради срока строка и существует.
        add WARN "$message" '' "$action"
        return 0
    fi
    title="${BASH_REMATCH[1]}"
    verb="${BASH_REMATCH[2]}"
    expiry="${BASH_REMATCH[3]}"
    value="$verb $expiry"
    epoch="$(date -u -d "$expiry" +%s 2>/dev/null || true)"
    if [[ "$verb" != 'истёк' && "$epoch" =~ ^[0-9]+$ ]]; then
        days=$(( (epoch + 86400 - $(date +%s)) / 86400 ))
        (( days < 0 )) || value+=", осталось $days дн."
    fi
    if [[ "$level" == OK ]]; then
        add OK "$title" "$value"
    else
        add WARN "$title" "$value" "$action"
    fi
}

# Новые версии AmneziaWG и Xray из последней проверки kalimera-updates. Это не
# ошибка: строка идёт со статусом OK и попадает в группу «ОБНОВЛЕНИЯ» сводки.
# Новое ядро сюда не входит: его ставит ночное обслуживание.
check_updates() {
    local level component message action
    [[ -r "$updates_state" ]] || return 0
    while IFS=$'\t' read -r level component message action; do
        case "$level:$component" in
            UPD:amneziawg|UPD:xray) add OK "обновление компонента: $message" "${action:-}" ;;
            # Срок регистрации домена: замечание появляется заранее, за месяц.
            WARN:domain) add WARN "$message" '' "${action:-}" ;;
            OK:cert|WARN:cert|INFO:cert) cert_row "$level" "$message" "${action:-}" ;;
        esac
    done <"$updates_state"
}

# Доставка уведомлений: без неё молчание Telegram не отличить от исправной работы.
check_telegram() {
    [[ "$telegram_enabled" == true && -x "$telegram_monitor" ]] || return 0
    if "$telegram_monitor" --check >/dev/null 2>&1; then
        add OK 'Telegram-уведомления: API доступен с этого сервера'
    else
        add WARN 'Telegram-уведомления не доставляются' 'API Telegram не отвечает или токен отклонён' \
            'проверка: telegram-test; заменить бота: на ENTRY kalimera-deploy --resume --enable-telegram'
    fi
}

check_health() {
    if [[ ! -x /usr/local/sbin/awg-health ]]; then
        add FAIL 'awg-health не установлен' '' 'на ENTRY: kalimera-deploy --resume'
        return 0
    fi
    run_report "$work/health" /usr/local/sbin/awg-health --strict
    import_rows "$work/health"
}

check_audit() {
    if [[ ! -x /usr/local/sbin/server-audit ]]; then
        add FAIL 'server-audit не установлен' '' 'на ENTRY: kalimera-deploy --resume'
        return 0
    fi
    run_report "$work/audit" /usr/local/sbin/server-audit
    import_rows "$work/audit"
}

# Состояние RU-прокси: active, failopen или manual. Прокси не настроен - off.
check_ru_proxy() {
    if [[ "$ru_proxy_enabled" != true ]]; then
        return 0
    fi
    local traffic='РФ-трафик клиентов'
    # Область selected: через прокси идут только списки proxy-domain и proxy-address.
    [[ "$ru_proxy_selected" != true ]] || traffic='трафик к выбранным доменам и адресам'
    if [[ -e "$ru_proxy_manual_flag" ]]; then
        ru_state=manual
        add WARN 'RU-прокси (sing-box)' "выключен вручную; $traffic идёт напрямую с ENTRY" 'ru-proxy status; включить: ru-proxy on'
    elif [[ -e "$ru_proxy_failopen_flag" ]] || ! systemctl is-active --quiet "$ru_proxy_service"; then
        ru_state=failopen
        add WARN 'RU-прокси (sing-box)' "fail-open: $traffic идёт напрямую с ENTRY" 'ru-proxy status; если SOCKS5 снова доступен: ru-proxy on'
    else
        ru_state=active
        add OK 'RU-прокси (sing-box)' "активен: $traffic идёт через SOCKS5/TUN"
    fi
}

# Ответ A-запроса: "адрес миллисекунды" или ошибка. Время берётся из dig +stats.
# До трёх попыток с паузой: на рабочем каскаде единственный потерянный ответ DoH
# через прокси давал «работа каскада нарушена», а повторный запуск проходил.
dns_probe() {
    local server="$1" port="$2" name="$3" output ip ms attempt
    for attempt in 1 2 3; do
        output="$(dig +time=3 +tries=1 +stats "@$server" -p "$port" "$name" A 2>/dev/null || true)"
        ip="$(awk '$4 == "A" { print $5; exit }' <<<"$output")"
        ms="$(awk '/Query time:/ { print $4; exit }' <<<"$output")"
        if [[ -n "$ip" ]]; then
            printf '%s %s\n' "$ip" "${ms:-0}"
            return 0
        fi
        (( attempt == 3 )) || sleep 2
    done
    return 1
}

# Одна строка DNS: $1 - проверка, $2 - резолвер, $3 - порт, $4 - имя,
# $5 - маршрут для успешного ответа, $6 - рекомендация при ошибке,
# $7 - статус при ошибке (по умолчанию FAIL).
# Строка идёт в сегмент DNS: в сводке она попадает в свою группу.
dns_row() {
    local label="$1" server="$2" port="$3" name="$4" route="$5" hint="$6" failed="${7:-FAIL}" answer ip ms
    if answer="$(dns_probe "$server" "$port" "$name")"; then
        read -r ip ms <<<"$answer"
        emit DNS OK "$label" "$ip за $ms мс; $route" '' "$ms"
    else
        emit DNS "$failed" "$label" 'нет ответа' "$hint"
    fi
}

# Пересылка Unbound на резолвер EXIT идёт без TLS: шифрует её сам туннель. По
# этому признаку режим виден в файле конфигурации.
foreign_dns_via_exit() {
    grep -Eq '^[[:space:]]*forward-addr:' "$dot_config" 2>/dev/null &&
        ! grep -Eq '^[[:space:]]*forward-tls-upstream:[[:space:]]*yes' "$dot_config" 2>/dev/null
}

check_dns() {
    local route_ru route_foreign dns_hint='sudo systemctl restart unbound.service dnsmasq.service; текущие DNS-серверы: dns-status'
    if foreign_dns_via_exit; then
        route_foreign='маршрут: Unbound → резолвер EXIT внутри туннеля, с ENTRY наружу запрос не уходит'
    else
        route_foreign='маршрут: Unbound → серверы DoT напрямую с ENTRY'
    fi
    if [[ "$ru_state" == active && "$ru_proxy_selected" != true ]]; then
        route_ru='маршрут: RU DoH через RU-прокси'
    elif [[ "$ru_dot_active" == true && "$ru_proxy_selected" == true ]]; then
        route_ru='маршрут: Unbound → российский DoT напрямую с ENTRY (через RU-прокси идут только выбранные адреса)'
    elif [[ "$ru_dot_active" == true ]]; then
        route_ru='маршрут: Unbound → российский DoT напрямую с ENTRY (RU-прокси не используется)'
    else
        route_ru='маршрут: Unbound (RU DoH недоступен, RU-прокси выключен)'
    fi
    dns_row 'DNS: yandex.ru (РФ) через клиентский резолвер' "$entry_client_listen" 53 yandex.ru "$route_ru" "$dns_hint"
    dns_row 'DNS: example.com (не РФ) через клиентский резолвер' "$entry_client_listen" 53 example.com "$route_foreign" "$dns_hint"
    dns_row 'DNS: example.com напрямую через Unbound' 127.0.0.1 "$entry_dns_port" example.com 'маршрут: Unbound на 127.0.0.1' "$dns_hint"
    # Режим включён, а действует прежний: при deploy резолвер EXIT не ответил, и
    # зарубежные имена остались на серверах DoT.
    if [[ "$dns_via_exit" == true ]] && ! foreign_dns_via_exit; then
        emit DNS WARN 'зарубежные имена: режим «через резолвер EXIT» включён, но не действует' \
            'запросы идут с ENTRY на серверы DoT' \
            'резолвер EXIT не ответил при deploy: awg-health --strict на EXIT, затем на ENTRY kalimera-deploy --resume'
    fi
    if [[ "$ru_state" == active ]]; then
        # RU DoH отвечает через внешний SOCKS5-прокси. В области selected через
        # него идут только выбранные домены и адреса: его сбой - замечание, а не
        # отказ каскада, и при длительном сбое сторож сам переводит их напрямую.
        if [[ "$ru_proxy_selected" == true ]]; then
            dns_row 'DNS: yandex.ru напрямую через RU DoH' 127.0.0.1 "$entry_dns_ru_port" yandex.ru 'маршрут: RU DoH на 127.0.0.1' \
                'затронуты только домены и адреса из proxy-domain и proxy-address; ru-proxy status; если SOCKS5 недоступен - ru-proxy-set или ru-proxy off' WARN
        else
            dns_row 'DNS: yandex.ru напрямую через RU DoH' 127.0.0.1 "$entry_dns_ru_port" yandex.ru 'маршрут: RU DoH на 127.0.0.1' 'ru-proxy status; если SOCKS5 недоступен - ru-proxy-set или ru-proxy off'
        fi
    fi
}

# Задержка через туннель: три TCP-подключения к example.com через интерфейс AWG
# ENTRY–EXIT, то есть выход через EXIT. Считается только установление
# соединения, без DNS. Рекурсивный DNS EXIT здесь не нужен: по умолчанию он
# выключен (entry_dns_default_via_exit: false), и его адрес не отвечает.
# Дальний маршрут замедляет все три подключения одинаково. Если же одно из них
# дольше другого на секунду и более, оно ждало повторной отправки первого
# пакета: ядро повторяет его через 1 с. Это потери в туннеле, а не расстояние.
check_tunnel() {
    local iface="${1:-$entry_exit_iface}" pair="${2:-ENTRY–EXIT}" target="${3:-EXIT}"
    local ssh_row="${4:-ENTRY → EXIT: SSH}"
    local output code lookup connect ms ok=0 sum=0 avg min=0 max=0
    [[ -n "$iface" ]] || return 0
    for _ in 1 2 3; do
        if output="$(curl -4 -sS -o /dev/null --max-time 10 --interface "$iface" -w '%{http_code} %{time_namelookup} %{time_connect}' https://example.com/ 2>/dev/null)"; then
            read -r code lookup connect <<<"$output"
            case "$code" in
                2??|3??)
                    ms="$(awk -v c="$connect" -v l="$lookup" 'BEGIN { printf "%d", (c - l) * 1000 }')"
                    ok=$((ok + 1))
                    sum=$((sum + ms))
                    if (( ok == 1 || ms < min )); then min="$ms"; fi
                    if (( ms > max )); then max="$ms"; fi
                    ;;
            esac
        fi
    done
    if (( ok == 0 )); then
        emit LINK FAIL "туннель $pair: TCP через туннель" 'ни одного подключения за 10 с' 'проверьте handshake туннеля: awg-health --strict; затем на ENTRY: kalimera-deploy --resume'
        return 0
    fi
    avg=$((sum / ok))
    if (( ok < 3 )); then
        emit LINK WARN "туннель $pair: TCP через туннель" "$ok из 3 подключений, среднее $avg мс: часть подключений не прошла" "проверьте канал до $target и нагрузку: awg-health --strict" "$avg"
    elif (( max - min >= 900 )); then
        emit LINK WARN "туннель $pair: TCP через туннель" "3 из 3 подключений, от $min до $max мс: неустойчиво, похоже на потери пакетов" "подключение, которое дольше остальных на секунду и более, ждало повторной отправки первого пакета: в туннеле до $target теряются пакеты (потери или ограничение UDP между хостингами), сами серверы исправны - повторите проверку позже" "$avg"
    elif (( avg > 250 )); then
        emit LINK WARN "туннель $pair: TCP через туннель" "3 из 3 подключений, среднее $avg мс: высокая задержка" "сравните со строкой «$ssh_row»: если задержка высока и там, медленный маршрут между хостингами ENTRY и $target, серверы исправны - повторите проверку позже; если только здесь - нагрузка $target: awg-health --strict на этом сервере" "$avg"
    else
        emit LINK OK "туннель $pair: TCP через туннель" "3 из 3 подключений, среднее $avg мс (без DNS)" '' "$avg"
    fi
}

# HTTPS-проверка: $1 - сегмент, $2 - проверка, $3 - интерфейс (пусто - прямой
# маршрут узла), $4 - адрес, $5 - рекомендация при ошибке. Время - до ответа.
report_http() {
    local seg="$1" label="$2" interface="$3" url="$4" hint="$5" output code secs ms
    local -a args=(-4 -sS -o /dev/null --max-time 10 -w '%{http_code} %{time_total}')
    if [[ -n "$interface" ]]; then
        args+=(--interface "$interface")
    fi
    if output="$(curl "${args[@]}" "$url" 2>/dev/null)"; then
        read -r code secs <<<"$output"
        ms="$(awk -v t="$secs" 'BEGIN { printf "%d", t * 1000 }')"
        case "$code" in
            2??|3??) emit "$seg" OK "$label" "HTTP $code за $secs с" '' "$ms" ;;
            *) emit "$seg" FAIL "$label" "HTTP $code" "$hint" "$ms" ;;
        esac
    else
        emit "$seg" FAIL "$label" 'нет ответа за 10 с' "$hint"
    fi
}

# Время установления TCP-соединения в миллисекундах; ошибка, если порт молчит 5 с.
tcp_ms() {
    local host="$1" port="$2" started finished
    if [[ -z "$host" ]] || (( port <= 0 )); then
        return 1
    fi
    started="$(date +%s%N)"
    # shellcheck disable=SC2016
    timeout 5 bash -c 'exec 3<>"/dev/tcp/$0/$1"' "$host" "$port" 2>/dev/null || return 1
    finished="$(date +%s%N)"
    printf '%s\n' $(( (finished - started) / 1000000 ))
}

# Связь FRONT с REALITY-портом ENTRY: строка связи, измеряется TCP-подключением.
check_front_backend() {
    local ms
    if [[ -z "$front_entry_host" ]]; then
        emit LINK FAIL 'backend FRONT → ENTRY (REALITY)' 'адрес ENTRY не задан' 'на FRONT: kalimera-deploy --resume'
        return 0
    fi
    if ms="$(tcp_ms "$front_entry_host" "$front_entry_port")"; then
        emit LINK OK 'backend FRONT → ENTRY (REALITY)' "TCP $ms мс" '' "$ms"
    else
        emit LINK FAIL 'backend FRONT → ENTRY (REALITY)' 'порт недоступен' 'на ENTRY: awg-health --strict (служба backend FRONT и правило UFW для адреса FRONT)'
    fi
}

main() {
    case "${1:-}" in
        --tsv) [[ $# -eq 1 ]] || { usage >&2; exit 2; } ;;
        --help|-h) [[ $# -eq 1 ]] || { usage >&2; exit 2; }; usage; exit 0 ;;
        *) usage >&2; exit 2 ;;
    esac
    [[ $EUID -eq 0 ]] || { echo 'kalimera-report запускается от root.' >&2; exit 1; }
    work="$(mktemp -d /run/kalimera-report.XXXXXX)"
    trap 'rm -rf "$work"' EXIT

    check_services
    check_reboot
    check_watchdog
    check_memory
    check_self_heal
    check_updates
    check_telegram
    check_health
    check_audit
    case "$segment" in
        ENTRY)
            check_controller_backup
            check_ru_proxy
            check_dns
            check_tunnel
            report_http LINK 'выход через EXIT: example.com' "$entry_exit_iface" https://example.com/ 'туннель и NAT EXIT: awg-health --strict на ENTRY и EXIT'
            if [[ -n "$entry_standby_iface" ]]; then
                check_tunnel "$entry_standby_iface" 'ENTRY–EXIT резервный' 'резервного EXIT' 'ENTRY → EXIT резервный: SSH'
                report_http LINK 'выход через EXIT резервный: example.com' "$entry_standby_iface" https://example.com/ 'туннель и NAT резервного EXIT: awg-health --strict на ENTRY и на резервном EXIT'
            fi
            report_http LINK 'выход напрямую с ENTRY: yandex.ru' '' https://yandex.ru/ 'проверьте WAN ENTRY и DNS: dns-status'
            ;;
        EXIT)
            report_http LINK "выход в Интернет с $exit_title: example.com" '' https://example.com/ 'проверьте WAN EXIT и NAT: awg-health --strict'
            ;;
        FRONT)
            check_front_backend
            ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
