[Unit]
Description=Проверка маршрутизации RU SOCKS/TUN
After={{ sing_box_service_name }} {{ entry_routing_service_name }}

[Service]
Type=oneshot
ExecStart={{ entry_ru_proxy_watch_script_path }}
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run -{{ entry_dnsmasq_config_dir }} -{{ awg_domain_policy_dir }}
