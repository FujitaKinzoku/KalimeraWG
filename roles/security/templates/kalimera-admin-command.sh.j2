#!/usr/bin/env bash
set -Eeuo pipefail

[[ $EUID -eq 0 ]] || { echo 'Внутренняя команда должна запускаться через sudo.' >&2; exit 1; }
command_name="${1:-}"
[[ -n "$command_name" ]] || { echo 'Не указана команда KalimeraWG.' >&2; exit 2; }
shift

case "$command_name" in
    kalimera-status|kalimera-test|awg-health|server-audit|maintenance|update-all|vpn-user|vless-user|awg-mobile|awg-old|dns-status|dot-switch|doh-switch|reality-dest-switch|ru-domain|se-domain|entry-domain|proxy-domain|proxy-address|ru-proxy|ru-proxy-set|ru-direct-ports|f2b-reset|ssh-key-audit|telegram-test|exit-path|transport-guard|kalimera-secretctl|self-heal|cascade-check|kalimera-updates)
        executable="/usr/local/sbin/$command_name"
        [[ -x "$executable" ]] || { echo "Команда $command_name не установлена на этом сервере." >&2; exit 127; }
        exec "$executable" "$@"
        ;;
    fail2ban-client)
        if [[ $# -eq 1 && $1 == status ]] || [[ $# -eq 2 && $1 == status && $2 == sshd ]]; then
            exec /usr/bin/fail2ban-client "$@"
        fi
        echo 'Разрешено: fail2ban-client status [sshd]' >&2
        exit 2
        ;;
    kalimera-deploy)
{% if awg_node_role == 'entry' %}
        case "${*:-}" in
            '--resume'|'--resume --update-components'|'--resume --update-amneziawg'|'--resume --update-xray'|'--resume --rotate-front-disguise'|'--resume --replace-front'|'--resume --commit-front-replacement'|'--resume --rollback-front-replacement'|'--resume --enable-ru-proxy'|'--resume --disable-ru-proxy'|'--resume --enable-telegram'|'--resume --disable-telegram'|'--resume --enable-standby-exit'|'--resume --disable-standby-exit'|'--resume --replace-exit'|'--resume --enable-dns-via-exit'|'--resume --disable-dns-via-exit'|'--resume --enable-fallback-transport'|'--resume --disable-fallback-transport'|'--resume --enable-loss-switch'|'--resume --disable-loss-switch'|'--resume --enable-front-site'|'--resume --disable-front-site'|'--summary'|'--terminal-only') ;;
            *) echo 'Разрешено: kalimera-deploy --resume, обновления компонентов, операции FRONT, --enable-ru-proxy, --disable-ru-proxy, --enable-telegram, --disable-telegram, --enable-standby-exit, --disable-standby-exit, --replace-exit, --enable-dns-via-exit, --disable-dns-via-exit, --enable-fallback-transport, --disable-fallback-transport, --enable-loss-switch, --disable-loss-switch, --enable-front-site, --disable-front-site, --summary или --terminal-only' >&2; exit 2 ;;
        esac
        [[ -x {{ (security_controller_repo_path ~ '/deploy') | quote }} ]] || {
            echo 'Управляющий репозиторий не найден.' >&2
            exit 127
        }
        cd {{ security_controller_repo_path | quote }}
        exec {{ (security_controller_repo_path ~ '/deploy') | quote }} "$@"
{% else %}
        echo 'Deploy запускается только на ENTRY сервере.' >&2
        exit 2
{% endif %}
        ;;
    cascade-reboot)
{% if awg_node_role == 'entry' %}
        case "${*:-}" in
            '') reboot_args=(--cascade-reboot) ;;
            '--yes') reboot_args=(--cascade-reboot --yes) ;;
            '--yes --force') reboot_args=(--cascade-reboot --yes --force) ;;
            'status') reboot_args=(--cascade-reboot-status) ;;
            'auto on') reboot_args=(--cascade-reboot-auto on) ;;
            'auto off') reboot_args=(--cascade-reboot-auto off) ;;
            *) echo 'Разрешено: cascade-reboot, cascade-reboot --yes, cascade-reboot --yes --force, cascade-reboot status, cascade-reboot auto on, cascade-reboot auto off' >&2; exit 2 ;;
        esac
        [[ -x {{ (security_controller_repo_path ~ '/deploy') | quote }} ]] || {
            echo 'Управляющий репозиторий не найден.' >&2
            exit 127
        }
        cd {{ security_controller_repo_path | quote }}
        exec {{ (security_controller_repo_path ~ '/deploy') | quote }} "${reboot_args[@]}"
{% else %}
        echo 'cascade-reboot запускается только на ENTRY сервере.' >&2
        exit 2
{% endif %}
        ;;
    controller-backup)
{% if awg_node_role == 'entry' %}
        case "${*:-}" in
            '') backup_args=(--controller-backup) ;;
            'key') backup_args=(--controller-backup-key) ;;
            *) echo 'Разрешено: controller-backup (создать копию и сохранить на EXIT и FRONT), controller-backup key (показать ключ восстановления)' >&2; exit 2 ;;
        esac
        [[ -x {{ (security_controller_repo_path ~ '/deploy') | quote }} ]] || {
            echo 'Управляющий репозиторий не найден.' >&2
            exit 127
        }
        cd {{ security_controller_repo_path | quote }}
        exec {{ (security_controller_repo_path ~ '/deploy') | quote }} "${backup_args[@]}"
{% else %}
        # Файл копии зашифрован ключом восстановления, которого на этом сервере нет.
        # Команда печатает его как есть: так владелец забирает копию после потери ENTRY.
        if [[ "${*:-}" != export ]]; then
            echo 'Разрешено: controller-backup export > ФАЙЛ (забрать зашифрованную копию состояния контроллера)' >&2
            exit 2
        fi
        backup_file={{ ((awg_controller_backup_dir | default('/var/lib/kalimera/controller-backup')) ~ '/controller.kbk') | quote }}
        [[ -s "$backup_file" ]] || { echo 'Копии состояния контроллера на этом сервере нет.' >&2; exit 1; }
        if [[ -t 1 ]]; then
            echo 'Перенаправьте вывод в файл: controller-backup export > controller.kbk' >&2
            exit 2
        fi
        exec cat -- "$backup_file"
{% endif %}
        ;;
    maintenance-time)
{% if awg_node_role == 'entry' %}
        if [[ $# -eq 1 && $1 == show ]]; then
            maintenance_args=(--maintenance-show)
        elif [[ $# -eq 2 && $1 =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ && $2 =~ ^[A-Za-z][A-Za-z0-9_+-]*(/[A-Za-z0-9_+-]+)+$ ]]; then
            maintenance_args=(--maintenance-time "$1" --maintenance-zone "$2")
        else
            echo 'Использование: maintenance-time show или maintenance-time ЧЧ:ММ ЗОНА, например: maintenance-time 02:20 Asia/Manila' >&2
            exit 2
        fi
        [[ -x {{ (security_controller_repo_path ~ '/deploy') | quote }} ]] || {
            echo 'Управляющий репозиторий не найден.' >&2
            exit 127
        }
        cd {{ security_controller_repo_path | quote }}
        exec {{ (security_controller_repo_path ~ '/deploy') | quote }} "${maintenance_args[@]}"
{% else %}
        echo 'maintenance-time запускается только на ENTRY сервере.' >&2
        exit 2
{% endif %}
        ;;
    *)
        echo "Команда $command_name не входит в ограниченный список KalimeraWG." >&2
        exit 2
        ;;
esac
