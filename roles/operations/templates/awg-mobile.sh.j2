#!/usr/bin/env bash
set -Eeuo pipefail

[[ $EUID -eq 0 ]] || { echo 'Запустите команду от root.' >&2; exit 1; }

readonly iface={{ entry_mobile_client_interface | quote }}
readonly service={{ awg3_mobile_service_name | quote }}
readonly peer_dir={{ awg_mobile_local_peer_dir | quote }}
readonly routing={{ entry_routing_script_path | quote }}
readonly firewall={{ entry_mobile_firewall_path | quote }}
readonly listen_port={{ entry_mobile_client_listen_port | quote }}

peer_count() {
    find "$peer_dir" -maxdepth 1 -type f -name '*.peer' -printf '.' 2>/dev/null | wc -c
}

refresh_network() {
    "$routing" apply
}

case "${1:-status}" in
    status)
        [[ $# -le 1 ]] || { echo 'Использование: awg-mobile {status|on|off}' >&2; exit 2; }
        if systemctl is-active --quiet "$service"; then
            state=ON
            "$firewall" check >/dev/null 2>&1 && access=OK || access=FAIL
        else
            state=OFF
            access=OFF
        fi
        printf 'Мобильный интерфейс %s (AWG 3.1): %s; прямой внешний UDP/%s; доступ: %s; клиентов: %s\n' \
            "$iface" "$state" "$listen_port" "$access" "$(peer_count)"
        ;;
    on)
        [[ $# -eq 1 || ( $# -eq 2 && "${2:-}" == --allow-empty ) ]] || { echo 'Использование: awg-mobile {status|on|off}' >&2; exit 2; }
        [[ "$(peer_count)" -gt 0 || "${2:-}" == --allow-empty ]] || {
            echo 'Интерфейс не включён: сначала создайте клиента командой vpn-user NAME mobile.' >&2
            exit 1
        }
        started_here=false
        if ! systemctl is-active --quiet "$service"; then
            systemctl enable --now "$service"
            started_here=true
        else
            systemctl enable "$service"
            "$firewall" apply
        fi
        if [[ "$(peer_count)" -gt 0 ]] && ! systemctl restart awg-local-peer-apply.service; then
            if [[ "$started_here" == true ]]; then
                systemctl disable --now "$service" || true
            fi
            echo "Не удалось применить peers интерфейса $iface." >&2
            exit 1
        fi
        if ! refresh_network; then
            if [[ "$started_here" == true ]]; then
                systemctl disable --now "$service" || true
                "$routing" apply || true
            fi
            echo "Не удалось полностью включить интерфейс $iface." >&2
            exit 1
        fi
        [[ "${2:-}" == --allow-empty ]] || echo "Мобильный интерфейс $iface включён на публичном UDP/$listen_port."
        ;;
    off)
        [[ $# -eq 1 ]] || { echo 'Использование: awg-mobile {status|on|off}' >&2; exit 2; }
        systemctl disable --now "$service"
        "$firewall" remove || true
        refresh_network
        echo "Мобильный интерфейс $iface выключен; клиентские файлы сохранены."
        ;;
    --help|-h)
        [[ $# -eq 1 ]] || { echo 'Использование: awg-mobile {status|on|off}' >&2; exit 2; }
        echo 'Использование: awg-mobile {status|on|off}'
        ;;
    *)
        echo 'Использование: awg-mobile {status|on|off}' >&2
        exit 2
        ;;
esac
