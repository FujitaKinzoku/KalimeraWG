#!/usr/bin/env bash
set -Eeuo pipefail

usage() { echo 'Использование: server-audit [--quiet]'; }
quiet=false
case "${1:-}" in
    '') ;;
    --quiet) [[ $# -eq 1 ]] || { usage >&2; exit 2; }; quiet=true ;;
    --help|-h) [[ $# -eq 1 ]] || { usage >&2; exit 2; }; usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
esac
failures=0
critical=0
warnings=0

{% raw %}
# >>> kalimera-report: общий блок оформления отчёта.
# Блок одинаков в awg-health, server-audit и kalimera-updates, совпадение
# проверяет tests/test_report_style.py. Цвет, итоговая рамка и рекомендации
# выводятся только в терминал. В файл, журнал, Ansible и Telegram-монитор
# уходит прежний текст: без управляющих символов, с префиксами
# OK/FAIL/WARN/UPD/INFO, по которым эти строки разбирают.
# KALIMERA_REPORT_STYLE=fancy|plain нужен тестам; sudo эту переменную не
# пропускает.
case "${KALIMERA_REPORT_STYLE:-auto}" in
    fancy) report_fancy=true ;;
    plain) report_fancy=false ;;
    *)
        report_fancy=false
        if [[ -t 1 && -z "${NO_COLOR:-}" && "${TERM:-dumb}" != dumb ]]; then
            report_fancy=true
        fi
        ;;
esac
report_reset=$'\033[0m'
# KALIMERA_REPORT_RESULTS - файл для cascade-check: report_line записывает OK,
# report_note - FAIL и WARN с рекомендацией. Переменная сбрасывается сразу, чтобы
# вложенные awg-health или server-audit не дописывали свои строки в тот же файл.
report_results_file="${KALIMERA_REPORT_RESULTS:-}"
unset KALIMERA_REPORT_RESULTS
# Замечания для итоговой рамки: "FAIL|WARN<TAB>что не так<TAB>что сделать".
# FAIL - работа каскада нарушена критически, WARN - каскад работает.
report_notes=()
report_box_lines=()

# Строка результата: OK зелёная, FAIL и WARN жёлтые, UPD голубая.
report_line() {
    local level="$1" text="$2" color=''
    if [[ "$report_fancy" == true ]]; then
        case "$level" in
            OK) color=$'\033[32m' ;;
            FAIL|WARN) color=$'\033[33m' ;;
            UPD) color=$'\033[36m' ;;
        esac
    fi
    printf '%s%-4s %s%s\n' "$color" "$level" "$text" "${color:+$report_reset}"
    [[ "$level" != OK ]] || report_export OK "$text"
}

# Строка в файл результатов: "СТАТУС<TAB>проверка<TAB>рекомендация".
report_export() {
    [[ -n "$report_results_file" ]] || return 0
    printf '%s\t%s\t%s\n' "$1" "$2" "${3:-}" >>"$report_results_file"
}

report_note() {
    report_notes+=("$1"$'\t'"$2"$'\t'"${3:-}")
    report_export "$1" "$2" "${3:-}"
}

# $1 - цвет рамки, $2 - ширина текста, $3 - строка, $4 - цвет строки.
report_box_emit() {
    local pad=$(( $2 - ${#3} ))
    (( pad > 0 )) || pad=0
    printf '%s│%s %s%s%s%*s %s│%s\n' "$1" "$report_reset" "${4:-}" "$3" \
        "${4:+$report_reset}" "$pad" '' "$1" "$report_reset"
}

# Перенос по словам. Продолжение строки с маркером (→, ✗, !) выравнивается
# по тексту после маркера.
report_box_row() {
    local lead rest hang line word has_word=false
    local -a words=()
    lead="${3%%[![:space:]]*}"
    rest="${3#"$lead"}"
    hang="$lead"
    case "$rest" in
        '→ '*|'✗ '*|'! '*) hang+='  ' ;;
    esac
    read -r -a words <<<"$rest" || true
    line="$lead"
    for word in "${words[@]}"; do
        if [[ "$has_word" == true ]] && (( ${#line} + 1 + ${#word} > $2 )); then
            report_box_emit "$1" "$2" "$line" "${4:-}"
            line="$hang$word"
        elif [[ "$has_word" == true ]]; then
            line+=" $word"
        else
            line+="$word"
        fi
        has_word=true
    done
    report_box_emit "$1" "$2" "$line" "${4:-}"
}

# Итоговая рамка: $1 - OK (зелёная), WARN (жёлтая) или FAIL (красная),
# $2 - заголовок, дальше строки содержимого.
report_box() {
    [[ "$report_fancy" == true ]] || return 0
    local LC_ALL=C.UTF-8
    local status="$1" title="$2" color width inner rule line
    shift 2
    case "$status" in
        OK) color=$'\033[1;32m' ;;
        WARN) color=$'\033[1;33m' ;;
        *) color=$'\033[1;31m' ;;
    esac
    width="$(tput cols 2>/dev/null || true)"
    [[ "$width" =~ ^[0-9]+$ ]] || width=80
    (( width <= 100 )) || width=100
    (( width >= 40 )) || width=40
    inner=$(( width - 4 ))
    printf -v rule '%*s' "$(( width - 2 ))" ''
    rule="${rule// /─}"
    printf '\n%s┌%s┐%s\n' "$color" "$rule" "$report_reset"
    report_box_row "$color" "$inner" "$status  $title" "$color"
    if (( $# > 0 )); then
        printf '%s├%s┤%s\n' "$color" "$rule" "$report_reset"
        for line in "$@"; do
            report_box_row "$color" "$inner" "$line"
        done
    fi
    printf '%s└%s┘%s\n' "$color" "$rule" "$report_reset"
}

# Замечания -> строки рамки в report_box_lines: сначала критичные (✗), потом
# остальные (!). Одинаковая рекомендация печатается один раз после всех
# замечаний, к которым она относится. Не больше 12 замечаний: остальные
# видны в строках выше.
report_note_lines() {
    local severity marker note level text hint key shown=0 hidden=0 group_shown
    local -a order=()
    local -A texts=()
    report_box_lines=()
    for severity in FAIL WARN; do
        marker='!'
        [[ "$severity" != FAIL ]] || marker='✗'
        order=()
        texts=()
        for note in "${report_notes[@]}"; do
            IFS=$'\t' read -r level text hint <<<"$note" || true
            [[ "$level" == "$severity" ]] || continue
            key="k:$hint"
            if [[ -z "${texts[$key]+set}" ]]; then
                order+=("$key")
                texts[$key]=''
            fi
            texts[$key]+="$text"$'\n'
        done
        for key in "${order[@]}"; do
            group_shown=false
            while IFS= read -r text; do
                [[ -n "$text" ]] || continue
                if (( shown < 12 )); then
                    report_box_lines+=("$marker $text")
                    shown=$((shown + 1))
                    group_shown=true
                else
                    hidden=$((hidden + 1))
                fi
            done <<<"${texts[$key]}"
            hint="${key#k:}"
            if [[ "$group_shown" == true && -n "$hint" ]]; then
                report_box_lines+=("  → $hint")
            fi
        done
    done
    if (( hidden > 0 )); then
        report_box_lines+=("… и ещё замечаний: $hidden, они отмечены в строках выше")
    fi
}
# <<< kalimera-report
{% endraw %}

# record - проверка, без которой каскад не работает или открыта граница
# безопасности (красная рамка FAIL); record_minor - замечание, каскад
# работает (жёлтая рамка WARN). Обе печатают FAIL и входят в код возврата,
# как раньше: его разбирают Telegram-монитор и обслуживание. WARN-строки
# record_warn_result на код возврата по-прежнему не влияют.
record() { record_as FAIL "$@"; }
record_minor() { record_as WARN "$@"; }

record_as() {
    local severity="$1" label="$2"
    shift 2
    if "$@" >/dev/null 2>&1; then
        audit_passed "$label"
    else
        audit_failed "$severity" "$label" "$(audit_hint "$label")"
    fi
}

audit_passed() {
    [[ "$quiet" == true ]] || report_line OK "$1"
}

# $1 - FAIL или WARN, $2 - проверка, $3 - рекомендация.
audit_failed() {
    [[ "$quiet" == true ]] || report_line FAIL "$2"
    failures=$((failures + 1))
    [[ "$1" != FAIL ]] || critical=$((critical + 1))
    report_note "$1" "$2" "$3"
}

record_warn_result() {
    local success_label="$1"
    local failure_label="$2"
    shift 2
    if "$@" >/dev/null 2>&1; then
        audit_passed "$success_label"
    else
        [[ "$quiet" == true ]] || report_line WARN "$failure_label"
        warnings=$((warnings + 1))
        report_note WARN "$failure_label" "$(audit_hint "$failure_label")"
    fi
}

# Строгая проверка роли: awg-health --strict возвращает 1 при критичных
# ошибках и 3, если есть только замечания.
record_health() {
    local label='строгая проверка роли сервера' rc=0
    {{ awg_health_script_path | quote }} --strict >/dev/null 2>&1 || rc=$?
    if (( rc == 0 )); then
        audit_passed "$label"
    elif (( rc == 3 )); then
        audit_failed WARN "$label: только замечания" 'подробности и рекомендации: awg-health --strict'
    else
        audit_failed FAIL "$label" 'подробности и рекомендации: awg-health --strict'
    fi
}

# Рекомендация для непройденной проверки. Команды kalimera запускаются без
# sudo; kalimera-deploy - на ENTRY, он настраивает весь каскад.
audit_hint() {
    local hint=''
    case "$1" in
        *'корневой раздел'*)
            hint='освободите место: sudo apt-get clean; sudo apt-get autoremove --purge; крупные каталоги: sudo du -xh / --max-depth=2 | sort -h | tail' ;;
        *'модулей systemd'*)
            hint='модули перечислены ниже; причина: sudo journalctl -u ИМЯ -b --no-pager; после исправления: sudo systemctl reset-failed ИМЯ' ;;
        *'постоянные журналы'*)
            hint='на ENTRY: kalimera-deploy --resume; найденные журналы и истории команд удалите вручную' ;;
        *'только в RAM'*|*'журналирование UFW'*|*rsyslog*|*coredump*)
            hint='на ENTRY: kalimera-deploy --resume восстановит политику без журналов' ;;
        *Fail2Ban*)
            hint='sudo systemctl restart fail2ban.service; если не помогло - на ENTRY: kalimera-deploy --resume' ;;
        *'runtime-секретов'*)
            hint='kalimera-secretctl status; если хранилище закрыто - на ENTRY: kalimera-deploy --resume' ;;
        *'целостность'*)
            hint='управляемые файлы изменены вне KalimeraWG; если это сделали не вы - проверьте сервер, иначе на ENTRY: kalimera-deploy --resume' ;;
        *'authorized_keys'*)
            hint='ssh-key-audit status, лишний ключ: ssh-key-audit delete SHA256:...' ;;
        *AppArmor*)
            hint='AppArmor включается ядром хостинга; на работу каскада не влияет' ;;
        *'контейнерный runtime'*)
            hint='если Docker/Podman не нужны: sudo systemctl disable --now docker.service podman.service containerd.service' ;;
        *'внешние слушатели'*)
            hint='владелец порта: sudo ss -lntup; лишнюю службу остановите и отключите' ;;
    esac
    printf '%s\n' "${hint:-на ENTRY: kalimera-deploy --resume восстановит настройки KalimeraWG}"
}

disk_ok() {
    local used
    used="$(df --output=pcent / | tail -n 1 | tr -dc '0-9')"
    [[ -n "$used" && "$used" -lt 90 ]]
}

no_failed_units() {
    ! systemctl --failed --no-legend --plain |
        awk '$1 != "awg-server-audit.service" { found=1 } END { exit !found }'
}

sensitive_modes_ok() {
    local file mode
    while IFS= read -r file; do
        [[ -e "$file" ]] || continue
        if [[ -L "$file" ]]; then
            [[ "$(readlink -f "$file")" == /run/kalimera-secrets/* ]] || return 1
            file="$(readlink -f "$file")"
        fi
        mode="$(stat -c '%a' "$file")"
        case "$mode" in
            600|400) ;;
            *) return 1 ;;
        esac
    done <<'EOF'
/etc/awg-telegram-monitor.env
/etc/sing-box/config.json
/etc/sing-box/front-backend.json
{% if awg_node_role == 'front' %}
{{ front_vless_users_path | default('/usr/local/etc/xray/users.json') }}
{{ front_vless_client_settings_path | default('/usr/local/etc/xray/client-settings.json') }}
{{ front_origin_key_path | default('/etc/letsencrypt/live/invalid/privkey.pem') }}
{% endif %}
EOF

    for file in /etc/amnezia/amneziawg/*.conf /etc/awg/*.conf; do
        [[ -e "$file" ]] || continue
        if [[ -L "$file" ]]; then
            [[ "$(readlink -f "$file")" == /run/kalimera-secrets/* ]] || return 1
            file="$(readlink -f "$file")"
        fi
        mode="$(stat -c '%a' "$file")"
        case "$mode" in
            600|400) ;;
            *) return 1 ;;
        esac
    done
}

{% if awg_node_role == 'front' %}
xray_read_only_config_ok() {
    local file group mode owner target
    for file in \
        {{ front_xray_base_config_path | default('/usr/local/etc/xray/config.base.json') | quote }} \
        {{ front_xray_config_path | default('/usr/local/etc/xray/config.json') | quote }}; do
        [[ -e "$file" ]] || return 1
        target="$(readlink -f -- "$file")"
        [[ -n "$target" && -f "$target" ]] || return 1
        if [[ "$target" == /run/kalimera-secrets/* ]]; then
            owner="$(stat -c '%U' "$target")"
            group="$(stat -c '%G' "$target")"
            mode="$(stat -c '%a' "$target")"
            [[ "$owner" == root && "$mode" == 640 ]] || return 1
            [[ "$group" == root || "$group" == xray ]] || return 1
        else
            [[ "$target" == "$file" ]] || return 1
            [[ "$(stat -c '%U:%G:%a' "$target")" == 'root:xray:640' ]] || return 1
        fi
        ! runuser -u xray -- test -w "$target" || return 1
    done
}
{% endif %}

{% if runtime_secrets_enabled | default(false) | bool %}
runtime_secrets_ok() {
    systemctl is-enabled --quiet {{ runtime_secrets_service_name | quote }} &&
        systemctl is-active --quiet {{ runtime_secrets_service_name | quote }} &&
        {{ runtime_secrets_ctl_path | quote }} verify >/dev/null 2>&1
}
{% endif %}

ssh_baseline_ok() {
    local effective
    effective="$(sshd -T -C user=root,host=localhost,addr=127.0.0.1)"
    grep -qx 'passwordauthentication no' <<<"$effective" &&
        grep -qx 'kbdinteractiveauthentication no' <<<"$effective" &&
        grep -qx 'authenticationmethods publickey' <<<"$effective" &&
        grep -qx 'authorizedkeysfile .ssh/authorized_keys' <<<"$effective" &&
        grep -qx 'requiredrsasize 2048' <<<"$effective" &&
        ! grep -Eq '^pubkeyacceptedalgorithms .*([,[:space:]])ssh-rsa([,[:space:]]|$)' <<<"$effective" &&
        grep -qx 'x11forwarding no' <<<"$effective" &&
        grep -qx 'disableforwarding yes' <<<"$effective" &&
        grep -qx 'allowagentforwarding no' <<<"$effective" &&
        grep -qx 'allowtcpforwarding no' <<<"$effective" &&
        grep -qx 'allowstreamlocalforwarding no' <<<"$effective" &&
        grep -qx 'permituserenvironment no' <<<"$effective" &&
        grep -qx 'permituserrc no' <<<"$effective" &&
        grep -qx 'usedns no' <<<"$effective" &&
        ! grep -qx 'hostkey /etc/ssh/ssh_host_dsa_key' <<<"$effective"
}

fail2ban_sshd_policy_ok() {
    local jail=/etc/fail2ban/jail.d/zz-awg-sshd.local
    fail2ban-client -t >/dev/null 2>&1 &&
        fail2ban-client status sshd >/dev/null 2>&1 &&
        [[ "$(fail2ban-client get sshd maxretry 2>/dev/null)" == "{{ fail2ban_sshd.maxretry | int }}" ]] &&
        grep -Eq '^[[:space:]]*mode[[:space:]]*=[[:space:]]*aggressive[[:space:]]*$' "$jail" &&
        grep -Eq '^[[:space:]]*backend[[:space:]]*=[[:space:]]*systemd[[:space:]]*$' "$jail" &&
        grep -Eq '^[[:space:]]*banaction[[:space:]]*=[[:space:]]*ufw[[:space:]]*$' "$jail" &&
        grep -Eq '^[[:space:]]*usedns[[:space:]]*=[[:space:]]*no[[:space:]]*$' "$jail" &&
        grep -Fqx {{ ('ignoreip = 127.0.0.1/8 ::1 ' ~ security_automation_source_ipv4) | quote }} "$jail"
}

{% if security_manage_admin_account | default(false) | bool %}
managed_admin_ok() {
    id {{ security_admin_user | quote }} >/dev/null 2>&1 &&
        id -nG {{ security_admin_user | quote }} | tr ' ' '\n' | grep -Fxq sudo &&
        passwd -S {{ security_admin_user | quote }} | grep -Eq '^[^ ]+[[:space:]]+P[[:space:]]' &&
        passwd -S root | grep -Eq '^root[[:space:]]+P[[:space:]]' &&
        test -s {{ ('/home/' ~ security_admin_user ~ '/.ssh/authorized_keys') | quote }} &&
        test -x {{ security_admin_command_path | quote }} &&
        visudo -cf /etc/sudoers.d/90-kalimera-admin >/dev/null 2>&1 &&
        ! grep -Eq 'NOPASSWD:[[:space:]]+ALL([[:space:]]|$)' /etc/sudoers.d/90-kalimera-admin
}

root_ssh_policy_ok() {
    local effective
    effective="$(sshd -T -C user=root,host=localhost,addr={{ security_automation_source_ipv4 | quote }})"
    grep -qx 'permitrootlogin no' <<<"$effective" &&
        ! grep -Eq '^allowusers .*root(@|[[:space:]]|$)' <<<"$effective"
}

root_authorized_keys_clean() {
    local keys={{ security_root_authorized_keys_path | quote }}
    [[ ! -s "$keys" ]] ||
        ! awk '
            /^[[:space:]]*($|#)/ { next }
            { found=1; exit }
            END { exit !found }
        ' "$keys"
}
{% endif %}

ppa_key_isolated() {
    grep -Fxq 'Signed-By: /etc/apt/keyrings/amnezia-ppa.asc' \
        /etc/apt/sources.list.d/amnezia-ppa.sources &&
        gpg --batch --show-keys --with-colons /etc/apt/keyrings/amnezia-ppa.asc |
        grep -Fq 'fpr:::::::::75C9DD72C799870E310542E24166F2C257290828:'
}

apparmor_enabled() {
    command -v aa-status >/dev/null 2>&1 && aa-status --enabled
}

no_container_runtime() {
    local service
    for service in docker.service podman.service containerd.service; do
        systemctl is-active --quiet "$service" && return 1
    done
    return 0
}

# Внешние сокеты вне ожидаемого списка, по строке proto/port, без повторов.
unexpected_public_listeners() {
    local proto endpoint address port
    local known_tcp='{{ ssh_listen_port | int }} {{ ansible_port | default(22) | int }}'
{% if awg_node_role == 'entry' %}
{% if front_backend_enabled | default(false) | bool %}
    known_tcp="$known_tcp {{ reality_fallback_port | default(8444) | int }}"
{% endif %}
    local known_udp='{{ entry_awg0_listen_port | int }} {{ entry_mobile_client_listen_port | default(8443) | int }} {{ entry_legacy_client_listen_port | default(39744) | int }} {{ awg3_transit_listen_port | default(39745) | int }}'
{% elif awg_node_role == 'front' %}
    known_tcp="$known_tcp 80 443"
    local known_udp=''
{% else %}
    local known_udp='{{ awg3_transit_listen_port | default(exit_awg_listen_port | default(443)) | int }}'
{% endif %}
    local process
{% if awg_node_role == 'entry' %}
    # sing-box на ENTRY сам отправляет UDP клиентов (QUIC, DNS, игры) напрямую
    # и держит для каждого потока сокет 0.0.0.0:<временный порт> минутами.
    # ss показывает такой сокет как UNCONN, будто это слушатель. Это не он:
    # входящие на эти порты закрыты UFW. Пропускаются только UDP-сокеты
    # управляемых служб sing-box (по MainPID) в диапазоне временных портов
    # ядра; постоянный порт или чужой процесс по-прежнему дают предупреждение.
    local unit pid outbound_pids='' port_low=32768 port_high=60999
    for unit in {{ sing_box_service_name | default('sing-box.service') | quote }} {{ front_backend_service_name | default('kalimera-front-backend.service') | quote }}; do
        pid="$(systemctl show -p MainPID --value "$unit" 2>/dev/null || true)"
        [[ ! "$pid" =~ ^[1-9][0-9]*$ ]] || outbound_pids="$outbound_pids $pid"
    done
    read -r port_low port_high </proc/sys/net/ipv4/ip_local_port_range || true
{% endif %}

    while read -r proto _ _ _ endpoint _ process; do
        [[ -n "$endpoint" ]] || continue
        port="${endpoint##*:}"
        address="${endpoint%:*}"
        address="${address#[}"
        address="${address%]}"
        case "$address" in
            127.*|::1|10.*|192.168.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*) continue ;;
        esac
{% if awg_node_role == 'entry' %}
        if [[ "$proto" == udp && "$process" =~ pid=([0-9]+), ]] &&
            [[ " $outbound_pids " == *" ${BASH_REMATCH[1]} "* ]] &&
            (( port >= port_low && port <= port_high )); then
            continue
        fi
{% endif %}
        case "$proto" in
            tcp) [[ " $known_tcp " == *" $port "* ]] || printf 'tcp/%s\n' "$port" ;;
            udp) [[ " $known_udp " == *" $port "* ]] || printf 'udp/%s\n' "$port" ;;
        esac
    done < <(ss -H -lntup) | sort -u
}

unexpected_listeners=''

# Исходящий UDP-запрос (DNS, проверки) на мгновение держит сокет на случайном
# порту, и ss показывает его как UNCONN 0.0.0.0:порт - так же, как слушателя.
# Настоящий слушатель есть в обоих снимках, временный сокет почти никогда.
known_public_listeners_only() {
    local first second
    unexpected_listeners=''
    first="$(unexpected_public_listeners)" || return 1
    [[ -n "$first" ]] || return 0
    sleep "${SERVER_AUDIT_LISTENER_RECHECK_SECONDS:-3}"
    second="$(unexpected_public_listeners)" || return 1
    unexpected_listeners="$(comm -12 <(printf '%s\n' "$first") <(printf '%s\n' "$second"))"
    [[ -z "$unexpected_listeners" ]]
}

systemd_config_last_value() {
    local config="$1" key="$2"
    systemd-analyze cat-config "$config" |
        awk -F= -v wanted="$key" '
            {
                name = $1
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", name)
                if (name == wanted) {
                    value = substr($0, index($0, "=") + 1)
                    gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
                    last = value
                }
            }
            END { if (last != "") print last }
        '
}

journald_is_volatile() {
    [[ "$(systemd_config_last_value systemd/journald.conf Storage)" == volatile ]] &&
        [[ "$(systemd_config_last_value systemd/journald.conf ForwardToSyslog)" == no ]]
}

rsyslog_is_disabled() {
    local enabled
    ! systemctl is-active --quiet rsyslog.service &&
        enabled="$(systemctl is-enabled rsyslog.service 2>/dev/null || true)" &&
        [[ "$enabled" == masked || "$enabled" == not-found ]]
}

coredump_storage_is_disabled() {
    [[ "$(systemd_config_last_value systemd/coredump.conf Storage)" == none ]] &&
        [[ "$(systemd_config_last_value systemd/coredump.conf ProcessSizeMax)" == 0 ]]
}

login_accounting_is_volatile() {
    local name target
    for name in wtmp btmp lastlog faillog; do
        target="$(readlink -f "/var/log/$name")"
        [[ "$target" == "/run/kalimerawg-accounting/$name" ]] || return 1
    done
}

fail2ban_state_is_volatile() {
    grep -Eq '^[[:space:]]*logtarget[[:space:]]*=[[:space:]]*SYSTEMD-JOURNAL[[:space:]]*$' \
        /etc/fail2ban/fail2ban.local &&
        grep -Eq '^[[:space:]]*dbfile[[:space:]]*=[[:space:]]*:memory:[[:space:]]*$' \
            /etc/fail2ban/fail2ban.local
}

no_persistent_activity_logs() {
    local file history_file
    if [[ -d /var/log/journal ]] &&
       find /var/log/journal -type f -print -quit | grep -q .; then
        return 1
    fi
    for file in /var/log/auth.log* /var/log/syslog* /var/log/kern.log* \
                /var/log/ufw.log* /var/log/fail2ban.log* \
                /var/log/nginx/access.log* /var/log/nginx/error.log* \
                /var/lib/fail2ban/fail2ban.sqlite3*; do
        [[ ! -s "$file" ]] || return 1
    done
    for history_file in \
        /root/.bash_history \
        /root/.lesshst \
        /root/.viminfo \
        /root/.nano_history \
        /root/.python_history \
        /root/.mysql_history \
        /root/.psql_history \
        /root/.sqlite_history \
        /root/.wget-hsts; do
        [[ "$(readlink -f "$history_file")" == /dev/null ]] || return 1
    done
}

record_health
record_minor 'корневой раздел заполнен менее чем на 90%' disk_ok
record_minor 'нет неисправных модулей systemd' no_failed_units
record 'UFW активен' bash -c "ufw status | grep -q '^Status: active$'"
record_minor 'журналирование UFW отключено' bash -c "ufw status verbose | grep -Eq '^Logging:[[:space:]]+off'"
record_minor 'Fail2Ban активен' systemctl is-active --quiet fail2ban.service
record_minor 'строгая политика Fail2Ban применяется' fail2ban_sshd_policy_ok
record_minor 'systemd journal хранится только в RAM' journald_is_volatile
record_minor 'постоянный rsyslog отключён' rsyslog_is_disabled
record_minor 'coredump не сохраняются' coredump_storage_is_disabled
record_minor 'учёт входов хранится только в RAM' login_accounting_is_volatile
record_minor 'состояние Fail2Ban хранится только в RAM' fail2ban_state_is_volatile
record_minor 'постоянные журналы активности отсутствуют' no_persistent_activity_logs
record 'секретные конфигурации имеют права 0600/0400' sensitive_modes_ok
{% if awg_node_role == 'front' %}
record_minor 'Xray имеет только чтение рабочей конфигурации' xray_read_only_config_ok
{% endif %}
{% if runtime_secrets_enabled | default(false) | bool %}
record 'пороговое хранилище runtime-секретов исправно' runtime_secrets_ok
{% endif %}
record 'усиленная конфигурация SSH применяется' ssh_baseline_ok
{% if security_manage_admin_account | default(false) | bool %}
record_minor 'рабочий администратор kalimera настроен безопасно' managed_admin_ok
record 'root SSH полностью отключён' root_ssh_policy_ok
record_warn_result \
    'root authorized_keys не содержит посторонних ключей' \
    'root authorized_keys содержит посторонние ключи; выполните ssh-key-audit' \
    root_authorized_keys_clean
{% endif %}
{% if awg_node_role | default('') in ['entry', 'exit'] %}
record_minor 'PPA AmneziaWG использует отдельный проверенный Signed-By keyring' ppa_key_isolated
{% endif %}
record 'целостность управляемых файлов подтверждена' {{ awg_managed_integrity_path | quote }} check
record_warn_result \
    'AppArmor доступен и включён ядром хостинга' \
    'AppArmor недоступен или выключен ядром хостинга' \
    apparmor_enabled
record_warn_result \
    'контейнерный runtime не расширяет поверхность атаки' \
    'обнаружен активный контейнерный runtime' \
    no_container_runtime
record_warn_result \
    'неожиданные внешние слушатели не обнаружены' \
    'обнаружены неожиданные внешние слушатели' \
    known_public_listeners_only
if [[ "$quiet" == false && -n "$unexpected_listeners" ]]; then
    printf '     порты: %s; владелец: sudo ss -lntup\n' "$(paste -sd ' ' <<<"$unexpected_listeners")"
fi

# Доступные обновления - не ошибка и не предупреждение: строки UPD берутся из
# последней проверки kalimera-updates (RAM) и на код возврата не влияют.
updates=0
updates_state={{ (kalimera_updates_state_dir | default('/run/kalimera-updates') ~ '/state') | quote }}
if [[ "$quiet" == false && -r "$updates_state" ]]; then
    while IFS=$'\t' read -r level _ message action; do
        [[ "$level" == UPD ]] || continue
        updates=$((updates + 1))
        report_line UPD "$message"
        [[ -z "$action" ]] || printf '     → %s\n' "$action"
    done <"$updates_state"
fi

if [[ "$quiet" == false && "$failures" -gt 0 ]] && ! no_failed_units; then
    printf 'Неисправные модули systemd:\n'
    systemctl --failed --no-legend --plain --no-pager |
        awk '$1 != "awg-server-audit.service"' || true
fi
if [[ "$quiet" == true ]]; then
    :
elif [[ "$report_fancy" == true ]]; then
    report_note_lines
    title={{ ('server-audit ' ~ (awg_node_role | default(''))) | quote }}
    if (( updates > 0 )); then
        report_box_lines+=("Доступно обновлений: $updates; подробнее: kalimera-updates")
    fi
    if (( critical > 0 )); then
        report_box FAIL "$title: работа каскада нарушена, критичных ошибок: $critical; всего ошибок: $failures, предупреждений: $warnings" \
            "${report_box_lines[@]}"
    elif (( failures > 0 || warnings > 0 )); then
        report_box WARN "$title: каскад работает; ошибок: $failures, предупреждений: $warnings" \
            "${report_box_lines[@]}"
    else
        report_box OK "$title: все проверки пройдены" "${report_box_lines[@]}"
    fi
else
    printf 'Ошибок аудита: %d; предупреждений: %d\n' "$failures" "$warnings"
    if [[ "$updates" -gt 0 ]]; then
        printf 'Доступно обновлений: %d; подробнее: kalimera-updates\n' "$updates"
    fi
fi
if [[ "$failures" -eq 0 ]]; then
    systemctl reset-failed {{ awg_server_audit_service_name | quote }} 2>/dev/null || true
fi
exit "$failures"
