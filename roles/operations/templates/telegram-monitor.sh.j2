#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

ENV_FILE={{ awg_telegram_monitor_env_path | quote }}
if [[ -n "${CREDENTIALS_DIRECTORY:-}" &&
      -r "${CREDENTIALS_DIRECTORY}/telegram.env" ]]; then
    ENV_FILE="${CREDENTIALS_DIRECTORY}/telegram.env"
fi
readonly ENV_FILE
readonly STATE_DIR={{ awg_telegram_monitor_state_dir | quote }}
readonly NODE_ROLE={{ awg_node_role | quote }}
# Метка каскада в начале каждого сообщения: по ней различают несколько каскадов
# в одном чате. Имя сервера и адреса в сообщения не попадают.
readonly LABEL={{ (awg_telegram_label | default('')) | string | quote }}
# Сообщение «проверка состояния не пройдена» уходит, когда ошибка держится дольше
# этого срока: за это время служба самовосстановления успевает её устранить и
# сообщить об этом сама. Разовый сбой проверки тревогу не поднимает.
readonly FAIL_DELAY={{ awg_telegram_monitor_fail_delay | default(480) | int }}
{% if awg_node_role == 'entry' and entry_ru_proxy_enabled | bool %}
readonly PROXY_MONITORED=true
readonly PROXY_DISABLED_FLAG={{ entry_ru_proxy_disabled_flag | quote }}
readonly PROXY_MANUAL_FLAG={{ entry_ru_proxy_manual_disabled_flag | quote }}
{% else %}
readonly PROXY_MONITORED=false
readonly PROXY_DISABLED_FLAG=''
readonly PROXY_MANUAL_FLAG=''
{% endif %}

test_mode=false
check_mode=false
notify_text=''
case "${0##*/}:${1:-}" in
    *:--notify)
        # Готовое сообщение от службы самовосстановления: что сломалось и что сделано.
        [[ $# -eq 2 && -n "$2" ]] || { echo 'Использование: awg-telegram-monitor --notify ТЕКСТ' >&2; exit 2; }
        notify_text="$2"
        ;;
    *:--check)
        # Доставка возможна: API отвечает и принимает токен. Ничего не отправляет.
        [[ $# -eq 1 ]] || { echo 'Использование: awg-telegram-monitor --check' >&2; exit 2; }
        check_mode=true
        ;;
    telegram-test:)
        [[ $# -eq 0 ]] || { echo 'Использование: telegram-test' >&2; exit 2; }
        test_mode=true
        ;;
    telegram-test:--help|telegram-test:-h)
        [[ $# -eq 1 ]] || { echo 'Использование: telegram-test' >&2; exit 2; }
        echo 'Использование: telegram-test'
        exit 0
        ;;
    *:)
        [[ $# -eq 0 ]] || { echo 'Использование: awg-telegram-monitor [--test]' >&2; exit 2; }
        ;;
    *:--test)
        [[ $# -eq 1 ]] || { echo 'Использование: awg-telegram-monitor [--test]' >&2; exit 2; }
        test_mode=true
        ;;
    *:--help|*:-h)
        [[ $# -eq 1 ]] || { echo 'Использование: awg-telegram-monitor [--test]' >&2; exit 2; }
        echo 'Использование: awg-telegram-monitor [--test]'
        exit 0
        ;;
    *) echo 'Использование: awg-telegram-monitor [--test]' >&2; exit 2 ;;
esac

if [[ ! -r "$ENV_FILE" ]]; then
    # Готовое сообщение не отправлено: код 3 отличает это от доставки, и служба,
    # которая его передала, повторит попытку позже.
    [[ -z "$notify_text" && "$check_mode" == false ]] || exit 3
    [[ "$test_mode" == false ]] && exit 0
    echo 'Telegram-мониторинг не настроен.' >&2
    exit 1
fi

# shellcheck disable=SC1090
source "$ENV_FILE"
: "${TELEGRAM_BOT_TOKEN:?}"
: "${TELEGRAM_CHAT_ID:?}"

send_message() {
    local message="$1"
    [[ -z "$LABEL" ]] || message="[$LABEL] $message"
    printf 'url = "https://api.telegram.org/bot%s/sendMessage"\n' \
        "$TELEGRAM_BOT_TOKEN" |
        curl --silent --show-error --fail --max-time 30 --config - \
            --data-urlencode "chat_id=${TELEGRAM_CHAT_ID}" \
            --data-urlencode "text=${message}" >/dev/null
}

# Две попытки: единственный потерянный ответ не должен давать замечание в отчёте.
if [[ "$check_mode" == true ]]; then
    for attempt in 1 2; do
        if printf 'url = "https://api.telegram.org/bot%s/getMe"\n' "$TELEGRAM_BOT_TOKEN" |
                curl --silent --fail --max-time 10 --config - >/dev/null 2>&1; then
            exit 0
        fi
        (( attempt == 2 )) || sleep 2
    done
    exit 1
fi

# Готовое сообщение уходит без общей блокировки: оно не должно пропасть из-за
# того, что в этот момент идёт очередная проверка состояния. Адреса и токены
# вырезаются так же, как из строк аудита.
if [[ -n "$notify_text" ]]; then
    send_message "$(sed -E \
        -e 's/([0-9]{1,3}\.){3}[0-9]{1,3}/[IP]/g' \
        -e 's/[0-9]{6,20}:[A-Za-z0-9_-]{20,}/[BOT_TOKEN]/g' <<<"$notify_text")"
    exit 0
fi

install -d -m 0700 "$STATE_DIR"
exec 9>"$STATE_DIR/lock"
flock -n 9 || exit 0

node="${NODE_ROLE^^}"
# Перевод строки в тексте уведомления. В двойных кавычках запись \n остаётся двумя
# символами, и Telegram показывал её буквально.
readonly newline=$'\n'

if [[ "$test_mode" == true ]]; then
    send_message "AWG ${node}: тестовое уведомление получено; мониторинг доступен"
    echo 'Тестовое уведомление Telegram отправлено.'
    exit 0
fi

current=healthy
reason=''
audit_output=''
security_warning=''
if ! audit_output="$({{ awg_server_audit_path | quote }} 2>&1)"; then
    current=failed
    reason="$(printf '%s\n' "$audit_output" |
        awk '/^FAIL / {print; count++} count == 8 {exit}' |
        sed -E \
            -e 's/([0-9]{1,3}\.){3}[0-9]{1,3}/[IP]/g' \
            -e 's/[0-9]{6,20}:[A-Za-z0-9_-]{20,}/[BOT_TOKEN]/g')"
else
    security_warning="$(printf '%s\n' "$audit_output" |
        awk '/^WARN root authorized_keys / {print; exit}')"
    if [[ -n "$security_warning" ]]; then
        current=security
        reason="${security_warning}${newline}Проверьте fingerprint: ssh-key-audit status"
    elif [[ "$PROXY_MONITORED" == true &&
            -e "$PROXY_DISABLED_FLAG" && ! -e "$PROXY_MANUAL_FLAG" ]]; then
        current=degraded
        reason='RU-прокси недоступен; активирован fail-open напрямую через ENTRY'
    fi
fi
unset audit_output security_warning

# Ошибка проверки подтверждается временем: пока она моложе FAIL_DELAY, состояние
# не меняется и сообщение не уходит. Запись о загрузке тоже не трогается, поэтому
# после перезагрузки сообщение «сервер перезапущен» придёт уже с итогом: служба
# могла ещё не успеть запуститься.
failed_since_file="$STATE_DIR/failed-since"
if [[ "$current" == failed ]]; then
    now="$(date +%s)"
    failed_since="$(cat "$failed_since_file" 2>/dev/null || true)"
    if [[ ! "$failed_since" =~ ^[0-9]+$ ]]; then
        failed_since="$now"
        printf '%s\n' "$failed_since" >"$failed_since_file"
        chmod 0600 "$failed_since_file"
    fi
    if (( now - failed_since < FAIL_DELAY )); then
        exit 0
    fi
else
    rm -f "$failed_since_file"
fi

previous="$(cat "$STATE_DIR/status" 2>/dev/null || true)"
boot_id="$(cat /proc/sys/kernel/random/boot_id)"
previous_boot_id="$(cat "$STATE_DIR/boot-id" 2>/dev/null || true)"
boot_changed=false
if [[ -n "$previous_boot_id" && "$boot_id" != "$previous_boot_id" ]]; then
    boot_changed=true
fi

message=''
if [[ "$boot_changed" == true ]]; then
    case "$current" in
        healthy)
            message="AWG ${node}: сервер перезапущен; состояние исправно"
            ;;
        degraded)
            message="AWG ${node}: сервер перезапущен${newline}${reason}"
            ;;
        security)
            message="AWG ${node}: сервер перезапущен; обнаружен посторонний root SSH-ключ${newline}${reason}"
            ;;
        failed)
            message="AWG ${node}: сервер перезапущен; проверка состояния не пройдена${newline}${reason}"
            ;;
    esac
elif [[ "$current" != "$previous" ]]; then
    case "$current" in
        failed)
            message="AWG ${node}: проверка состояния не пройдена${newline}${reason}"
            ;;
        degraded)
            message="AWG ${node}: работа в резервном режиме${newline}${reason}"
            ;;
        security)
            message="AWG ${node}: обнаружен посторонний root SSH-ключ${newline}${reason}"
            ;;
        healthy)
            if [[ "$previous" == degraded ]]; then
                message="AWG ${node}: RU-прокси восстановлен; штатная маршрутизация включена"
            elif [[ -n "$previous" ]]; then
                message="AWG ${node}: состояние восстановлено"
            fi
            ;;
    esac
fi

if [[ -n "$message" ]]; then
    send_message "$message"
fi

printf '%s\n' "$current" >"$STATE_DIR/status"
printf '%s\n' "$boot_id" >"$STATE_DIR/boot-id"
chmod 0600 "$STATE_DIR/status" "$STATE_DIR/boot-id" "$STATE_DIR/lock"
