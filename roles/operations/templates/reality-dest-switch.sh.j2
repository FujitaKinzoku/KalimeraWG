#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
    echo 'Использование: reality-dest-switch {status|list|set DOMAIN [PORT]|reset}'
}

[[ $EUID -eq 0 ]] || { echo 'Запустите команду от root.' >&2; exit 1; }
readonly config={{ sing_box_config_path | quote }}
readonly override={{ sing_box_reality_dest_override_path | quote }}
readonly backup_dir=/root/config-backups/entry/sing-box
readonly service={{ sing_box_service_name | quote }}
readonly reality_port={{ reality_fallback_port }}
readonly secretctl={{ runtime_secrets_ctl_path | default('/usr/local/sbin/kalimera-secretctl') | quote }}

# Список проверен вручную: TLS 1.3 + стабильный сертификат в трёх пробах
# подряд. mail.ru сюда намеренно не включён — отклоняет TLS 1.3 (alert 70).
# www.microsoft.com исключён — отдаётся через сторонний CDN (Akamai), что на
# практике повышало долю сорванных REALITY-хендшейков сильнее прочих
# кандидатов. www.debian.org тоже исключён — резолвится в несколько IP (DNS
# round-robin), сертификат нестабилен между пробами (см. preflight-проверку
# на живом каскаде). yandex.ru первым — RU-правдоподобный и подтверждённо
# стабильный.
readonly -a candidates=(
    yandex.ru
    vk.ru
    vk.com
    kinopoisk.ru
    market.yandex.ru
    maps.yandex.ru
    music.yandex.ru
    dzen.ru
    tinkoff.ru
)

reality_in_present() {
    [[ -f "$config" ]] || return 1
    jq -e '.inbounds[] | select(.tag == "reality-in")' "$config" >/dev/null 2>&1
}

validate_domain() {
    local value="$1" label
    local -a labels=()
    [[ "$(printf '%s' "$value" | wc -c)" -le 253 ]] || return 1
    [[ "$value" != .* && "$value" != *. && "$value" != *..* ]] || return 1
    IFS=. read -ra labels <<<"$value"
    for label in "${labels[@]}"; do
        [[ "$label" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$ ]] || return 1
    done
}

# Три пробы TLS-рукопожатия: dest должен стабильно согласовывать TLS 1.3
# одним и тем же сертификатом (см. roles/sing_box/tasks/main.yml — та же
# логика применяется во время deploy). sni по умолчанию равен connect-хосту;
# отдельный третий аргумент нужен только для самопроверки REALITY-порта, где
# TCP-подключение идёт на 127.0.0.1, а SNI — на замаскированный dest.
probe_dest() {
    local connect_host="$1" port="$2" sni="${3:-$1}" output proto_ok fingerprint
    local -a fingerprints=()
    for _ in 1 2 3; do
        output="$(timeout 10 openssl s_client -connect "${connect_host}:${port}" -servername "$sni" -tls1_3 </dev/null 2>/dev/null)" || true
        proto_ok=false
        grep -Eq 'New,[[:space:]]*TLSv1\.3,[[:space:]]*Cipher is[[:space:]]*TLS_' <<<"$output" && proto_ok=true
        fingerprint="$(openssl x509 -noout -fingerprint -sha256 <<<"$output" 2>/dev/null | cut -d= -f2)" || true
        [[ "$proto_ok" == true && -n "$fingerprint" ]] || return 1
        fingerprints+=("$fingerprint")
    done
    [[ "${fingerprints[0]}" == "${fingerprints[1]}" && "${fingerprints[1]}" == "${fingerprints[2]}" ]] || return 1
    printf '%s\n' "${fingerprints[0]}"
}

action="${1:---help}"
case "$action" in
    --help|-h)
        [[ $# -eq 1 ]] || { usage >&2; exit 2; }
        usage
        exit 0
        ;;
    status)
        [[ $# -eq 1 ]] || { usage >&2; exit 2; }
        reality_in_present || { echo 'REALITY выключен в текущей конфигурации.'; exit 0; }
        jq -r '.inbounds[] | select(.tag == "reality-in") |
            "dest: \(.tls.reality.handshake.server):\(.tls.reality.handshake.server_port)"' "$config"
        [[ -e "$override" ]] && echo 'Источник: локальное переопределение reality-dest-switch' || echo 'Источник: зашифрованный inventory'
        exit 0
        ;;
    list)
        [[ $# -eq 1 ]] || { usage >&2; exit 2; }
        echo 'Проверка кандидатов маскировочного dest-сайта REALITY (TLS 1.3, три пробы)...'
        for host in "${candidates[@]}"; do
            if fingerprint="$(probe_dest "$host" 443)"; then
                printf 'OK   %-24s %s\n' "$host" "$fingerprint"
            else
                printf 'FAIL %-24s не прошёл проверку (TLS 1.3 не согласован или сертификат нестабилен)\n' "$host"
            fi
        done
        echo 'Также можно указать любой другой домен: reality-dest-switch set DOMAIN [PORT]'
        exit 0
        ;;
    set)
        [[ $# -eq 2 || $# -eq 3 ]] || { usage >&2; exit 2; }
        reality_in_present || { echo 'REALITY выключен в текущей конфигурации.' >&2; exit 1; }
        new_dest="$2"
        new_port="${3:-443}"
        [[ "$new_port" =~ ^[0-9]+$ && "$new_port" -ge 1 && "$new_port" -le 65535 ]] || { echo 'Некорректный порт.' >&2; exit 2; }
        validate_domain "$new_dest" || { echo 'Некорректный домен.' >&2; exit 2; }
        ;;
    reset)
        [[ $# -eq 1 ]] || { usage >&2; exit 2; }
        reality_in_present || { echo 'REALITY выключен в текущей конфигурации.' >&2; exit 1; }
        new_dest={{ reality_fallback_dest | quote }}
        new_port={{ reality_fallback_dest_port }}
        ;;
    *) usage >&2; exit 2 ;;
esac

echo "Проверка dest-сайта ${new_dest}:${new_port}..."
new_fingerprint="$(probe_dest "$new_dest" "$new_port")" || {
    echo "dest-сайт ${new_dest}:${new_port} непригоден: TLS 1.3 не согласован стабильно или сертификат меняется между пробами." >&2
    exit 1
}
echo "dest-сайт проверен, сертификат стабилен (${new_fingerprint})."

install -d -m 0700 "$backup_dir" "$(dirname "$override")"
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
config_backup="$backup_dir/config.json.reality.$timestamp"
override_backup="$backup_dir/reality-dest-override.json.$timestamp"
cp -a "$config" "$config_backup"
override_existed=false
if [[ -e "$override" ]]; then
    cp -a "$override" "$override_backup"
    override_existed=true
fi

tmp="$(mktemp /run/sing-box-reality.XXXXXX)"
override_tmp="$(mktemp /run/sing-box-reality-override.XXXXXX)"
committed=false
service_was_active=false
systemctl is-active --quiet "$service" && service_was_active=true
cleanup() {
    local rc=$?
    if (( rc != 0 )) && [[ "$committed" == true ]]; then
        install -m 0600 "$config_backup" "$config" || true
        if [[ "$override_existed" == true ]]; then
            install -m 0600 "$override_backup" "$override" || true
        else
            rm -f "$override"
        fi
        [[ "$service_was_active" == false ]] || systemctl restart "$service" >/dev/null 2>&1 || true
        echo 'Изменение dest-сайта REALITY отменено; предыдущая конфигурация восстановлена.' >&2
    fi
    rm -f "$tmp" "$override_tmp"
    return "$rc"
}
trap cleanup EXIT

jq --arg dest "$new_dest" --argjson port "$new_port" '
  (.inbounds[] | select(.tag == "reality-in")) |=
    (.tls.server_name = $dest | .tls.reality.handshake.server = $dest | .tls.reality.handshake.server_port = $port)
' "$config" >"$tmp"
jq -n --arg dest "$new_dest" --argjson port "$new_port" '{dest:$dest,dest_port:$port}' >"$override_tmp"
sing-box check --config "$tmp" >/dev/null

committed=true
install -m 0600 "$tmp" "$config"
if [[ "$action" == reset ]]; then
    rm -f "$override"
else
    install -m 0600 "$override_tmp" "$override"
fi

if [[ "$service_was_active" == true ]]; then
    systemctl restart "$service"
    for _ in {1..15}; do
        ss -H -ltn "( sport = :${reality_port} )" | grep -q . && break
        sleep 1
    done
    ss -H -ltn "( sport = :${reality_port} )" | grep -q . || {
        echo "REALITY-инбаунд не начал слушать порт ${reality_port} после перезапуска." >&2
        exit 1
    }
    # Непрошедшее авторизацию соединение к собственному REALITY-порту должно
    # прозрачно проксироваться на настоящий dest и вернуть ТОТ ЖЕ сертификат,
    # что и прямое подключение к dest выше — так проверяется маскировка
    # целиком, а не только валидность JSON.
    self_fingerprint="$(probe_dest 127.0.0.1 "$reality_port" "$new_dest" || true)"
    if [[ "$self_fingerprint" == "$new_fingerprint" ]]; then
        echo 'REALITY проверен: собственный порт прозрачно маскируется под новый dest.'
    else
        echo 'ВНИМАНИЕ: не удалось подтвердить маскировку через собственный порт REALITY (сертификат не совпал или соединение не удалось). Конфигурация применена, но проверьте вручную.' >&2
    fi
    echo 'dest-сайт REALITY применён.'
    echo 'ВАЖНО: SNI на клиентах (serverName в конфиге VLESS+REALITY) нужно обновить на новое значение вручную.'
else
    echo 'dest-сайт REALITY проверен и сохранён; sing-box остаётся выключенным.'
fi
{% if runtime_secrets_enabled | default(false) | bool %}
"$secretctl" seal
{% endif %}
committed=false
