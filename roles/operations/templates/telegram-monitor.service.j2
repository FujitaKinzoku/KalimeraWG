[Unit]
Description=Telegram-уведомление об изменениях состояния AWG
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart={{ awg_telegram_monitor_path }}
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths={{ awg_telegram_monitor_env_path }}
ReadWritePaths={{ awg_telegram_monitor_state_dir }}
ProtectClock=true
ProtectControlGroups=true
ProtectKernelModules=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0077
