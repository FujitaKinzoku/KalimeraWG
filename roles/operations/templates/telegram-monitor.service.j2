[Unit]
Description=Telegram-уведомление об изменениях состояния AWG
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart={{ awg_telegram_monitor_path }}
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
# Мониторинг запускает server-audit, и тот должен видеть то же, что при запуске
# администратором: /root и /home (ссылки историй, authorized_keys), индекс модулей
# ядра в /usr/lib/modules и /run. С ProtectHome=true и ProtectKernelModules=true
# аудит не проходил на исправном сервере: состояние навсегда оставалось "ошибка",
# и уведомления о настоящих изменениях не приходили. Подробности - в
# server-audit.service.
ProtectHome=read-only
ProtectSystem=strict
ReadOnlyPaths={{ awg_telegram_monitor_env_path }}
ReadWritePaths={{ awg_telegram_monitor_state_dir }} /run
ProtectClock=true
ProtectControlGroups=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0077
