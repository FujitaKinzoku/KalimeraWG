#!/usr/bin/env bash
# Проверка и установка обновлений ядра, AmneziaWG и Xray-core.
# Найденное обновление - это не ошибка и не предупреждение: строка UPD
# сообщает, что доступно и какой командой это применить. Ничего не
# устанавливается автоматически; состояние живёт только в RAM (/run).
#
# Конвейеры здесь не обрывают чтение раньше времени (awk ... exit, grep -q):
# при set -o pipefail писатель получил бы SIGPIPE и команда завершилась бы
# с кодом 141 в интерактивном сеансе, хотя из systemd работала бы.
set -Eeuo pipefail

readonly STATE_DIR={{ kalimera_updates_state_dir | quote }}
readonly STATE_FILE="$STATE_DIR/state"
readonly ROLE={{ awg_node_role | quote }}
readonly APT_LOCK={{ kalimera_updates_apt_lock_path | default('/run/awg-apt-maintenance.lock') | quote }}
{% if awg_node_role == 'front' %}
readonly XRAY_BINARY={{ front_xray_binary_path | default('/usr/local/bin/xray') | quote }}
readonly XRAY_RELEASES_API={{ kalimera_updates_xray_releases_api | quote }}
{% endif %}

usage() {
    cat <<'EOF'
Использование (без sudo):
  kalimera-updates                 обновить списки пакетов, проверить и показать
                                   доступные обновления; ничего не устанавливает
  kalimera-updates install kernel  установить новое ядро; перезагрузка вручную

Та же проверка выполняется раз в сутки по таймеру; её результат показывают
server-audit и экран входа.
EOF
}

[[ $EUID -eq 0 ]] || {
    echo 'Нужны права root: в SSH-сеансе kalimera запускайте просто kalimera-updates, без sudo.' >&2
    exit 1
}

record() {
    printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "${4:-}"
}

# 0, если версия $1 строго новее $2 (сравнение как у sort -V).
version_gt() {
    [[ "$1" != "$2" ]] &&
        [[ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1)" == "$1" ]]
}

# Метапакет, который тянет новые ядра той же сборки, что работает сейчас.
# Для generic берём облегчённый linux-image-virtual: то же ядро без драйверов
# железа и прошивок, которые VPS не нужны.
kernel_meta_package() {
    local flavour="${1##*-}"
    if [[ "$flavour" == generic ]]; then
        printf 'linux-image-virtual\n'
    else
        printf 'linux-image-%s\n' "$flavour"
    fi
}

latest_kernel_release() {
    apt-cache depends "$1" 2>/dev/null |
        awk '!found && $1 == "Depends:" && $2 ~ /^linux-image-[0-9]/ {
            sub(/^linux-image-/, "", $2); print $2; found = 1
        }'
}

# Перед проверкой списки пакетов обновляются, иначе новое ядро или пакет
# AmneziaWG не были бы видны до следующего apt-get update. Недоступный
# репозиторий не ошибка проверки: он показывается строкой INFO.
refresh_package_lists() {
    local output hosts
    [[ ! -t 2 ]] || printf '%s\n' 'Обновление списков пакетов и проверка версий...' >&2
    exec 9>"$APT_LOCK"
    if ! flock -w 60 9; then
        exec 9>&-
        record INFO apt 'списки пакетов не обновлены: идёт другое обслуживание пакетов; результат может быть устаревшим'
        return
    fi
    output="$(LC_ALL=C apt-get -o DPkg::Lock::Timeout=60 -q update 2>&1)" ||
        output+=$'\nE: apt-get update failed'
    flock -u 9
    exec 9>&-
    hosts="$(grep -oE '^(W|E): Failed to fetch [a-z+]+://[^/ ]+' <<<"$output" |
        sed -E 's#^.*://##' | sort -u | paste -sd, - || true)"
    if [[ -n "$hosts" ]]; then
        record INFO apt "не ответили репозитории: ${hosts//,/, }; результат может быть устаревшим"
    elif grep -E '^E:' <<<"$output" >/dev/null; then
        record INFO apt 'apt-get update завершился с ошибкой; результат может быть устаревшим'
    fi
}

check_kernel() {
    local running meta latest
    running="$(uname -r)"
    meta="$(kernel_meta_package "$running")"
    latest="$(latest_kernel_release "$meta")"
    if [[ -z "$latest" ]]; then
        record INFO kernel "ядро $running; новые версии не определены: в репозиториях нет $meta"
        return
    fi
    if ! version_gt "${latest%-*}" "${running%-*}"; then
        record OK kernel "ядро $running актуально"
        return
    fi
    if [[ "$(dpkg-query -W -f='${db:Status-Abbrev}' "linux-image-$latest" 2>/dev/null || true)" == ii* ]]; then
{% if awg_node_role in ['entry', 'exit'] %}
        record UPD kernel "ядро $latest установлено, работает $running" \
            "sudo /usr/local/sbin/awg-kernel-guard && sudo reboot (серверы одного каскада по очереди)"
{% else %}
        record UPD kernel "ядро $latest установлено, работает $running" \
            "sudo reboot (серверы одного каскада по очереди)"
{% endif %}
    else
        record UPD kernel "доступно ядро $latest, работает $running" \
            "kalimera-updates install kernel или дождитесь ночного обслуживания, затем перезагрузка"
    fi
}

{% if awg_node_role in ['entry', 'exit'] %}
check_amneziawg() {
    # Счётчик вместо длины массива: "решётка" сразу после фигурной скобки
    # открывает комментарий Jinja и сломала бы шаблон.
    local package installed candidate current='' count=0
    local -a found=()
    for package in amneziawg-dkms amneziawg-tools; do
        installed="$(dpkg-query -W -f='${Version}' "$package" 2>/dev/null || true)"
        [[ -n "$installed" ]] || continue
        [[ -n "$current" ]] || current="$installed"
        candidate="$(apt-cache policy "$package" 2>/dev/null |
            awk '!found && $1 == "Candidate:" { print $2; found = 1 }')"
        if [[ -n "$candidate" && "$candidate" != '(none)' ]] &&
            dpkg --compare-versions "$candidate" gt "$installed"; then
            found+=("$package $installed → $candidate")
            count=$((count + 1))
        fi
    done
    if [[ -z "$current" ]]; then
        record INFO amneziawg 'пакеты AmneziaWG не установлены'
    elif (( count > 0 )); then
        record UPD amneziawg "доступен AmneziaWG: $(IFS=';'; printf '%s' "${found[*]}")" \
            'на ENTRY: kalimera-deploy --resume --update-amneziawg (ENTRY и EXIT вместе, с откатом; клиентские конфиги не меняются)'
    else
        record OK amneziawg "AmneziaWG $current актуален"
    fi
}
{% endif %}

{% if awg_node_role == 'front' %}
check_xray() {
    local installed latest
    installed="$("$XRAY_BINARY" version 2>/dev/null | awk 'NR == 1 { print $2 }' || true)"
    latest="$(curl -fsS --max-time 15 -A KalimeraWG \
        -H 'Accept: application/vnd.github+json' "$XRAY_RELEASES_API" 2>/dev/null |
        jq -er '.tag_name' 2>/dev/null || true)"
    latest="${latest#v}"
    if [[ ! "$latest" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        record INFO xray "Xray ${installed:-?}; новые версии не проверены: GitHub недоступен"
    elif [[ -n "$installed" ]] && version_gt "$latest" "$installed"; then
        record UPD xray "доступен Xray $latest, работает $installed" \
            'на ENTRY: kalimera-deploy --resume --update-xray (с проверкой через CDN и откатом)'
    else
        record OK xray "Xray ${installed:-?} актуален"
    fi
}
{% endif %}

run_checks() {
    local temporary refresh="${1:-refresh}"
    install -d -m 0700 "$STATE_DIR"
    temporary="$(mktemp "$STATE_DIR/.state.XXXXXX")"
    {
        printf '#checked\t%s\n' "$(date -u '+%Y-%m-%d %H:%M UTC')"
        [[ "$refresh" != refresh ]] || refresh_package_lists
        check_kernel
{% if awg_node_role in ['entry', 'exit'] %}
        check_amneziawg
{% endif %}
{% if awg_node_role == 'front' %}
        check_xray
{% endif %}
    } >"$temporary"
    chmod 0600 "$temporary"
    mv -f "$temporary" "$STATE_FILE"
}

show_state() {
    local level component message action checked='' updates=0
    while IFS=$'\t' read -r level component message action; do
        case "$level" in
            '#checked') checked="$component" ;;
            UPD)
                updates=$((updates + 1))
                printf 'UPD  %s\n' "$message"
                [[ -z "$action" ]] || printf '     → %s\n' "$action"
                ;;
            OK|INFO) printf '%-4s %s\n' "$level" "$message" ;;
        esac
    done <"$STATE_FILE"
    printf 'Доступно обновлений: %d; проверено: %s (%s)\n' "$updates" "${checked:-?}" "$ROLE"
}

install_kernel() {
    local running meta
    local -a packages=()
    running="$(uname -r)"
    meta="$(kernel_meta_package "$running")"
    packages+=("$meta")
{% if awg_node_role in ['entry', 'exit'] %}
    # Заголовки нужны DKMS, чтобы собрать модуль AmneziaWG под новое ядро.
    packages+=("${meta/linux-image-/linux-headers-}")
{% endif %}
    export DEBIAN_FRONTEND=noninteractive
    exec 9>"$APT_LOCK"
    flock -w 600 9 || { echo 'Другое обслуживание пакетов не завершилось за 10 минут.' >&2; exit 75; }
    apt-get -o DPkg::Lock::Timeout=600 update
    apt-get -o DPkg::Lock::Timeout=600 install -y "${packages[@]}"
{% if awg_node_role in ['entry', 'exit'] %}
    /usr/local/sbin/awg-kernel-guard
{% endif %}
    flock -u 9
    exec 9>&-
    run_checks no-refresh
    show_state
    printf '%s\n' \
        'Ядро установлено, но начнёт работать после перезагрузки: sudo reboot' \
        'Серверы одного каскада перезагружайте по очереди: следующий - только после awg-health --strict на предыдущем.'
}

case "${1:-}" in
    # check - прежнее имя той же команды; оставлено для совместимости.
    ''|check) [[ $# -le 1 ]] || { usage >&2; exit 2; }; run_checks; show_state ;;
    install)
        [[ $# -eq 2 && "$2" == kernel ]] || { usage >&2; exit 2; }
        install_kernel
        ;;
    --help|-h) [[ $# -eq 1 ]] || { usage >&2; exit 2; }; usage ;;
    *) usage >&2; exit 2 ;;
esac
