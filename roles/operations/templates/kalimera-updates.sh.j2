#!/usr/bin/env bash
# Проверка и установка обновлений ядра, AmneziaWG и Xray-core.
# Найденное обновление - это не ошибка и не предупреждение: строка UPD
# сообщает, что доступно и какой командой это применить. Ничего не
# устанавливается автоматически; состояние живёт только в RAM (/run).
#
# Конвейеры здесь не обрывают чтение раньше времени (awk ... exit, grep -q):
# при set -o pipefail писатель получил бы SIGPIPE и команда завершилась бы
# с кодом 141 в интерактивном сеансе, хотя из systemd работала бы.
set -Eeuo pipefail

readonly STATE_DIR={{ kalimera_updates_state_dir | quote }}
readonly STATE_FILE="$STATE_DIR/state"
readonly ROLE={{ awg_node_role | quote }}
readonly APT_LOCK={{ kalimera_updates_apt_lock_path | default('/run/awg-apt-maintenance.lock') | quote }}
# Уведомления Telegram о найденном: программа отправки и каталог отметок «уже
# сообщено». Отметки переживают перезагрузку, иначе одно и то же обновление
# объявлялось бы заново после каждой загрузки сервера.
readonly NOTIFIER={{ awg_telegram_monitor_path | default('/usr/local/sbin/awg-telegram-monitor') | quote }}
readonly NOTIFIED_DIR={{ awg_telegram_monitor_state_dir | default('/var/lib/awg-telegram-monitor') | quote }}
{% if awg_node_role == 'front' %}
readonly XRAY_BINARY={{ front_xray_binary_path | default('/usr/local/bin/xray') | quote }}
readonly XRAY_RELEASES_API={{ kalimera_updates_xray_releases_api | quote }}
# Домены каскада: срок регистрации проверяется на FRONT, потому что его адрес и
# так связан с доменом записью DNS; запрос с ENTRY раскрыл бы реестру его адрес.
readonly ORIGIN_DOMAIN={{ front_origin_domain | default('') | quote }}
readonly CDN_DOMAIN={{ front_cdn_domain | default('') | quote }}
readonly DOMAIN_WARN_DAYS={{ kalimera_updates_domain_warn_days | default(30) | int }}
readonly RDAP_BOOTSTRAP={{ kalimera_updates_rdap_bootstrap | default('https://data.iana.org/rdap/dns.json') | quote }}
# TLS-сертификаты каскада. Их два: сертификат origin-домена на самом FRONT (его
# выпускает certbot; им FRONT отвечает CDN и клиентам прямого режима) и сертификат
# домена CDN (его выпускает CDN, на FRONT он не хранится). Проверяется
# сертификат, который сервер отдаёт на деле, а не файл на диске. Остальные узлы
# каскада сертификатов не имеют: AmneziaWG и REALITY работают на ключах.
readonly CERT_CDN_DOMAIN={% if 'cdn' in (front_access_modes | default([])) %}{{ front_cdn_domain | default('') | quote }}{% else %}''{% endif %}

# Замечание появляется, когда до конца срока осталось меньше стольких дней.
readonly CERT_WARN_DAYS={{ kalimera_updates_cert_warn_days | default(10) | int }}
readonly CERT_ATTEMPTS=3
{% endif %}

{% raw %}
# >>> kalimera-report: общий блок оформления отчёта.
# Блок одинаков в awg-health, server-audit и kalimera-updates, совпадение
# проверяет tests/test_report_style.py. Цвет, итоговая рамка и рекомендации
# выводятся только в терминал. В файл, журнал, Ansible и Telegram-монитор
# уходит прежний текст: без управляющих символов, с префиксами
# OK/FAIL/WARN/UPD/INFO, по которым эти строки разбирают.
# KALIMERA_REPORT_STYLE=fancy|plain нужен тестам; sudo эту переменную не
# пропускает.
case "${KALIMERA_REPORT_STYLE:-auto}" in
    fancy) report_fancy=true ;;
    plain) report_fancy=false ;;
    *)
        report_fancy=false
        if [[ -t 1 && -z "${NO_COLOR:-}" && "${TERM:-dumb}" != dumb ]]; then
            report_fancy=true
        fi
        ;;
esac
report_reset=$'\033[0m'
# KALIMERA_REPORT_RESULTS - файл для cascade-check: report_line записывает OK,
# report_note - FAIL и WARN с рекомендацией. Переменная сбрасывается сразу, чтобы
# вложенные awg-health или server-audit не дописывали свои строки в тот же файл.
report_results_file="${KALIMERA_REPORT_RESULTS:-}"
unset KALIMERA_REPORT_RESULTS
# Замечания для итоговой рамки: "FAIL|WARN<TAB>что не так<TAB>что сделать".
# FAIL - работа каскада нарушена критически, WARN - каскад работает.
report_notes=()
report_box_lines=()

# Строка результата: OK зелёная, FAIL и WARN жёлтые, UPD голубая.
report_line() {
    local level="$1" text="$2" color=''
    if [[ "$report_fancy" == true ]]; then
        case "$level" in
            OK) color=$'\033[32m' ;;
            FAIL|WARN) color=$'\033[33m' ;;
            UPD) color=$'\033[36m' ;;
        esac
    fi
    printf '%s%-4s %s%s\n' "$color" "$level" "$text" "${color:+$report_reset}"
    [[ "$level" != OK ]] || report_export OK "$text"
}

# Строка в файл результатов: "СТАТУС<TAB>проверка<TAB>рекомендация".
report_export() {
    [[ -n "$report_results_file" ]] || return 0
    printf '%s\t%s\t%s\n' "$1" "$2" "${3:-}" >>"$report_results_file"
}

report_note() {
    report_notes+=("$1"$'\t'"$2"$'\t'"${3:-}")
    report_export "$1" "$2" "${3:-}"
}

# $1 - цвет рамки, $2 - ширина текста, $3 - строка, $4 - цвет строки.
report_box_emit() {
    local pad=$(( $2 - ${#3} ))
    (( pad > 0 )) || pad=0
    printf '%s│%s %s%s%s%*s %s│%s\n' "$1" "$report_reset" "${4:-}" "$3" \
        "${4:+$report_reset}" "$pad" '' "$1" "$report_reset"
}

# Перенос по словам. Продолжение строки с маркером (→, ✗, !) выравнивается
# по тексту после маркера.
report_box_row() {
    local lead rest hang line word has_word=false
    local -a words=()
    lead="${3%%[![:space:]]*}"
    rest="${3#"$lead"}"
    hang="$lead"
    case "$rest" in
        '→ '*|'✗ '*|'! '*) hang+='  ' ;;
    esac
    read -r -a words <<<"$rest" || true
    line="$lead"
    for word in "${words[@]}"; do
        if [[ "$has_word" == true ]] && (( ${#line} + 1 + ${#word} > $2 )); then
            report_box_emit "$1" "$2" "$line" "${4:-}"
            line="$hang$word"
        elif [[ "$has_word" == true ]]; then
            line+=" $word"
        else
            line+="$word"
        fi
        has_word=true
    done
    report_box_emit "$1" "$2" "$line" "${4:-}"
}

# Итоговая рамка: $1 - OK (зелёная), WARN (жёлтая) или FAIL (красная),
# $2 - заголовок, дальше строки содержимого.
report_box() {
    [[ "$report_fancy" == true ]] || return 0
    local LC_ALL=C.UTF-8
    local status="$1" title="$2" color width inner rule line
    shift 2
    case "$status" in
        OK) color=$'\033[1;32m' ;;
        WARN) color=$'\033[1;33m' ;;
        *) color=$'\033[1;31m' ;;
    esac
    width="$(tput cols 2>/dev/null || true)"
    [[ "$width" =~ ^[0-9]+$ ]] || width=80
    (( width <= 100 )) || width=100
    (( width >= 40 )) || width=40
    inner=$(( width - 4 ))
    printf -v rule '%*s' "$(( width - 2 ))" ''
    rule="${rule// /─}"
    printf '\n%s┌%s┐%s\n' "$color" "$rule" "$report_reset"
    report_box_row "$color" "$inner" "$status  $title" "$color"
    if (( $# > 0 )); then
        printf '%s├%s┤%s\n' "$color" "$rule" "$report_reset"
        for line in "$@"; do
            report_box_row "$color" "$inner" "$line"
        done
    fi
    printf '%s└%s┘%s\n' "$color" "$rule" "$report_reset"
}

# Замечания -> строки рамки в report_box_lines: сначала критичные (✗), потом
# остальные (!). Одинаковая рекомендация печатается один раз после всех
# замечаний, к которым она относится. Не больше 12 замечаний: остальные
# видны в строках выше.
report_note_lines() {
    local severity marker note level text hint key shown=0 hidden=0 group_shown
    local -a order=()
    local -A texts=()
    report_box_lines=()
    for severity in FAIL WARN; do
        marker='!'
        [[ "$severity" != FAIL ]] || marker='✗'
        order=()
        texts=()
        for note in "${report_notes[@]}"; do
            IFS=$'\t' read -r level text hint <<<"$note" || true
            [[ "$level" == "$severity" ]] || continue
            key="k:$hint"
            if [[ -z "${texts[$key]+set}" ]]; then
                order+=("$key")
                texts[$key]=''
            fi
            texts[$key]+="$text"$'\n'
        done
        for key in "${order[@]}"; do
            group_shown=false
            while IFS= read -r text; do
                [[ -n "$text" ]] || continue
                if (( shown < 12 )); then
                    report_box_lines+=("$marker $text")
                    shown=$((shown + 1))
                    group_shown=true
                else
                    hidden=$((hidden + 1))
                fi
            done <<<"${texts[$key]}"
            hint="${key#k:}"
            if [[ "$group_shown" == true && -n "$hint" ]]; then
                report_box_lines+=("  → $hint")
            fi
        done
    done
    if (( hidden > 0 )); then
        report_box_lines+=("… и ещё замечаний: $hidden, они отмечены в строках выше")
    fi
}
# <<< kalimera-report
{% endraw %}

usage() {
    cat <<'EOF'
Использование (без sudo):
  kalimera-updates                 обновить списки пакетов, проверить и показать
                                   доступные обновления; ничего не устанавливает
  kalimera-updates install kernel  установить новое ядро; перезагрузка вручную

Та же проверка выполняется раз в сутки по таймеру; её результат показывают
server-audit и экран входа.
EOF
}

[[ $EUID -eq 0 ]] || {
    echo 'Нужны права root: в SSH-сеансе kalimera запускайте просто kalimera-updates, без sudo.' >&2
    exit 1
}

record() {
    printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "${4:-}"
}

# 0, если версия $1 строго новее $2 (сравнение как у sort -V).
version_gt() {
    [[ "$1" != "$2" ]] &&
        [[ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1)" == "$1" ]]
}

# Метапакет, который тянет новые ядра той же сборки, что работает сейчас.
# Для generic берём облегчённый linux-image-virtual: то же ядро без драйверов
# железа и прошивок, которые VPS не нужны.
kernel_meta_package() {
    local flavour="${1##*-}"
    if [[ "$flavour" == generic ]]; then
        printf 'linux-image-virtual\n'
    else
        printf 'linux-image-%s\n' "$flavour"
    fi
}

latest_kernel_release() {
    apt-cache depends "$1" 2>/dev/null |
        awk '!found && $1 == "Depends:" && $2 ~ /^linux-image-[0-9]/ {
            sub(/^linux-image-/, "", $2); print $2; found = 1
        }'
}

# Перед проверкой списки пакетов обновляются, иначе новое ядро или пакет
# AmneziaWG не были бы видны до следующего apt-get update. Недоступный
# репозиторий не ошибка проверки: он показывается строкой INFO.
refresh_package_lists() {
    local output hosts
    [[ ! -t 2 ]] || printf '%s\n' 'Обновление списков пакетов и проверка версий...' >&2
    exec 9>"$APT_LOCK"
    if ! flock -w 60 9; then
        exec 9>&-
        record INFO apt 'списки пакетов не обновлены: идёт другое обслуживание пакетов; результат может быть устаревшим'
        return
    fi
    output="$(LC_ALL=C apt-get -o DPkg::Lock::Timeout=60 -q update 2>&1)" ||
        output+=$'\nE: apt-get update failed'
    flock -u 9
    exec 9>&-
    hosts="$(grep -oE '^(W|E): Failed to fetch [a-z+]+://[^/ ]+' <<<"$output" |
        sed -E 's#^.*://##' | sort -u | paste -sd, - || true)"
    if [[ -n "$hosts" ]]; then
        record INFO apt "не ответили репозитории: ${hosts//,/, }; результат может быть устаревшим"
    elif grep -E '^E:' <<<"$output" >/dev/null; then
        record INFO apt 'apt-get update завершился с ошибкой; результат может быть устаревшим'
    fi
}

check_kernel() {
    local running meta latest
    running="$(uname -r)"
    meta="$(kernel_meta_package "$running")"
    latest="$(latest_kernel_release "$meta")"
    if [[ -z "$latest" ]]; then
        record INFO kernel "ядро $running; новые версии не определены: в репозиториях нет $meta"
        return
    fi
    if ! version_gt "${latest%-*}" "${running%-*}"; then
        record OK kernel "ядро $running актуально"
        return
    fi
    if [[ "$(dpkg-query -W -f='${db:Status-Abbrev}' "linux-image-$latest" 2>/dev/null || true)" == ii* ]]; then
{% if awg_node_role in ['entry', 'exit'] %}
        record UPD kernel "ядро $latest установлено, работает $running" \
            "sudo /usr/local/sbin/awg-kernel-guard && sudo reboot (серверы одного каскада по очереди)"
{% else %}
        record UPD kernel "ядро $latest установлено, работает $running" \
            "sudo reboot (серверы одного каскада по очереди)"
{% endif %}
    else
        record UPD kernel "доступно ядро $latest, работает $running" \
            "kalimera-updates install kernel или дождитесь ночного обслуживания, затем перезагрузка"
    fi
}

{% if awg_node_role in ['entry', 'exit'] %}
check_amneziawg() {
    # Счётчик вместо длины массива: "решётка" сразу после фигурной скобки
    # открывает комментарий Jinja и сломала бы шаблон.
    local package installed candidate current='' count=0 found_list
    local -a found=()
    for package in amneziawg-dkms amneziawg-tools; do
        installed="$(dpkg-query -W -f='${Version}' "$package" 2>/dev/null || true)"
        [[ -n "$installed" ]] || continue
        [[ -n "$current" ]] || current="$installed"
        candidate="$(apt-cache policy "$package" 2>/dev/null |
            awk '!found && $1 == "Candidate:" { print $2; found = 1 }')"
        if [[ -n "$candidate" && "$candidate" != '(none)' ]] &&
            dpkg --compare-versions "$candidate" gt "$installed"; then
            found+=("$package $installed → $candidate")
            count=$((count + 1))
        fi
    done
    if [[ -z "$current" ]]; then
        record INFO amneziawg 'пакеты AmneziaWG не установлены'
    elif (( count > 0 )); then
        # Соединение через IFS берёт только первый символ разделителя: пакеты
        # печатались слитно, через точку с запятой без пробела.
        found_list="$(printf '%s; ' "${found[@]}")"
        record UPD amneziawg "доступен AmneziaWG: ${found_list%; }" \
            'на ENTRY: kalimera-deploy --resume --update-amneziawg (ENTRY и EXIT вместе, с откатом; клиентские конфиги не меняются)'
    else
        record OK amneziawg "AmneziaWG $current актуален"
    fi
}
{% endif %}

{% if awg_node_role == 'front' %}
check_xray() {
    local installed latest
    installed="$("$XRAY_BINARY" version 2>/dev/null | awk 'NR == 1 { print $2 }' || true)"
    latest="$(curl -fsS --max-time 15 -A KalimeraWG \
        -H 'Accept: application/vnd.github+json' "$XRAY_RELEASES_API" 2>/dev/null |
        jq -er '.tag_name' 2>/dev/null || true)"
    latest="${latest#v}"
    if [[ ! "$latest" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        record INFO xray "Xray ${installed:-?}; новые версии не проверены: GitHub недоступен"
    elif [[ -n "$installed" ]] && version_gt "$latest" "$installed"; then
        record UPD xray "доступен Xray $latest, работает $installed" \
            'на ENTRY: kalimera-deploy --resume --update-xray (с проверкой через CDN и откатом)'
    else
        record OK xray "Xray ${installed:-?} актуален"
    fi
}

# Адрес RDAP-сервера реестра зоны $1 из списка IANA (на входе - сам список).
rdap_base() {
    python3 -c '
import json
import sys

try:
    for zones, urls in json.load(sys.stdin).get("services", []):
        if sys.argv[1] in zones:
            for url in urls:
                if str(url).startswith("https://"):
                    print(url)
                    raise SystemExit(0)
except (ValueError, TypeError, AttributeError):
    pass
raise SystemExit(1)
' "$1"
}

# Дата окончания регистрации из ответа RDAP о домене.
rdap_expiry() {
    python3 -c '
import json
import sys

try:
    for event in json.load(sys.stdin).get("events", []):
        if event.get("eventAction") == "expiration":
            print(str(event.get("eventDate", ""))[:10])
            raise SystemExit(0)
except (ValueError, TypeError, AttributeError):
    pass
raise SystemExit(1)
'
}

# "зарегистрированный-домен дата" для имени $1. Запросы идут от короткого имени к
# длинному (example.uk, затем origin.example.uk): реестр отвечает на имя самого
# домена, а имя поддомена ему не раскрывается.
domain_expiry() {
    local name="$1" bootstrap="$2" base candidate answer expiry count index
    local -a labels=()
    base="$(rdap_base "${name##*.}" <<<"$bootstrap" 2>/dev/null || true)"
    [[ -n "$base" ]] || return 1
    IFS=. read -r -a labels <<<"$name"
    count=0
    for candidate in "${labels[@]}"; do
        count=$((count + 1))
    done
    candidate="${labels[count - 1]}"
    for (( index = count - 2; index >= 0; index-- )); do
        candidate="${labels[index]}.$candidate"
        answer="$(curl -fsS --max-time 15 -A KalimeraWG -H 'Accept: application/rdap+json' \
            "${base%/}/domain/$candidate" 2>/dev/null || true)"
        expiry="$(rdap_expiry <<<"$answer" 2>/dev/null || true)"
        if [[ "$expiry" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
            printf '%s %s\n' "$candidate" "$expiry"
            return 0
        fi
    done
    return 1
}

# Срок регистрации доменов каскада. Недоступный реестр или зона без RDAP - не
# ошибка: срок просто не определён (INFO). Замечание появляется заранее, за
# DOMAIN_WARN_DAYS дней: домен, не продлённый вовремя, каскад сам не вернёт.
check_domains() {
    local name result registered expiry expiry_epoch days now bootstrap='' seen=' '
    now="$(date +%s)"
    for name in "$ORIGIN_DOMAIN" "$CDN_DOMAIN"; do
        [[ "$name" == *.* ]] || continue
        if [[ -z "$bootstrap" ]]; then
            bootstrap="$(curl -fsS --max-time 15 -A KalimeraWG "$RDAP_BOOTSTRAP" 2>/dev/null || true)"
        fi
        result="$(domain_expiry "$name" "$bootstrap" || true)"
        if [[ -z "$result" ]]; then
            [[ "$seen" == *" $name "* ]] ||
                record INFO domain "срок регистрации домена $name не определён: реестр зоны не ответил или не публикует срок"
            seen+="$name "
            continue
        fi
        read -r registered expiry <<<"$result"
        [[ "$seen" != *" $registered "* ]] || continue
        seen+="$registered "
        # Дата из ответа реестра может оказаться несуществующей: это тоже «срок не
        # определён», а не причина оборвать всю проверку обновлений.
        expiry_epoch="$(date -u -d "$expiry" +%s 2>/dev/null || true)"
        if [[ ! "$expiry_epoch" =~ ^[0-9]+$ ]]; then
            record INFO domain "срок регистрации домена $registered не определён: реестр вернул непонятную дату"
            continue
        fi
        days=$(( (expiry_epoch - now) / 86400 ))
        if (( days < 0 )); then
            record WARN domain "регистрация домена $registered истекла $expiry" \
                'продлите домен у регистратора: без него перестанут работать CDN и сертификат FRONT'
        elif (( days <= DOMAIN_WARN_DAYS )); then
            record WARN domain "регистрация домена $registered истекает $expiry (через $days дн.)" \
                'продлите домен у регистратора: без него перестанут работать CDN и сертификат FRONT'
        else
            record OK domain "домен $registered зарегистрирован до $expiry"
        fi
    done
}

# "начало конец" действия сертификата в секундах. $1 - имя домена (SNI), $2 -
# адрес, к которому идёт подключение. Попыток несколько: итог проверки хранится
# сутки, и один потерянный ответ давал бы замечание на весь день.
served_certificate_dates() {
    local name="$1" host="$2" attempt answer dates start end
    for (( attempt = 1; attempt <= CERT_ATTEMPTS; attempt++ )); do
        (( attempt == 1 )) || sleep 3
        answer="$(timeout 20 openssl s_client -connect "$host:443" -servername "$name" </dev/null 2>/dev/null || true)"
        dates="$(openssl x509 -noout -startdate -enddate <<<"$answer" 2>/dev/null || true)"
        start="$(sed -n 's/^notBefore=//p' <<<"$dates")"
        end="$(sed -n 's/^notAfter=//p' <<<"$dates")"
        [[ -n "$start" && -n "$end" ]] || continue
        start="$(date -u -d "$start" +%s 2>/dev/null || true)"
        end="$(date -u -d "$end" +%s 2>/dev/null || true)"
        [[ "$start" =~ ^[0-9]+$ && "$end" =~ ^[0-9]+$ ]] || continue
        printf '%s %s\n' "$start" "$end"
        return 0
    done
    return 1
}

# Строка о сертификате: $1 - чей он ("CDN-домена ИМЯ"), $2 - имя для TLS, $3 -
# адрес подключения, $4 - как продлить. Команда продления записывается и для
# действующего сертификата: cascade-check показывает срок всегда.
#
# Замечание появляется, когда до конца срока осталось меньше CERT_WARN_DAYS дней:
# certbot и CDN продлевают сертификат на 90 дней за месяц до конца срока, поэтому
# такой остаток значит, что продление не сработало. У короткоживущих сертификатов
# порог - пятая часть их срока: иначе исправный сертификат на 45 дней давал бы
# замечание перед каждым продлением.
check_certificate() {
    local title="$1" name="$2" host="$3" action="$4" dates start end now days limit expiry
    dates="$(served_certificate_dates "$name" "$host" || true)"
    if [[ -z "$dates" ]]; then
        record INFO cert "срок сертификата $title не определён: домен не ответил по TLS" \
            'повторить: на FRONT kalimera-updates; доступность домена проверяет awg-health --strict'
        return 0
    fi
    read -r start end <<<"$dates"
    now="$(date +%s)"
    expiry="$(date -u -d "@$end" +%Y-%m-%d)"
    days=$(( (end - now) / 86400 ))
    limit=$(( (end - start) / 86400 / 5 ))
    (( limit <= CERT_WARN_DAYS )) || limit=$CERT_WARN_DAYS
    if (( end <= now )); then
        record WARN cert "сертификат $title истёк $expiry" "$action"
    elif (( days < limit )); then
        record WARN cert "сертификат $title истекает $expiry (через $days дн.)" "$action"
    else
        record OK cert "сертификат $title действует до $expiry" "$action"
    fi
}

check_certificates() {
    # Сертификат origin-домена запрашивается у своего же Nginx по loopback: в облаке
    # с внешним адресом через NAT сервер до собственного публичного адреса не дойдёт.
    if [[ "$ORIGIN_DOMAIN" == *.* ]]; then
        check_certificate "origin-домена FRONT $ORIGIN_DOMAIN" "$ORIGIN_DOMAIN" 127.0.0.1 \
            'на FRONT: sudo systemctl start certbot.service, затем sudo systemctl reload nginx; причина отказа: sudo journalctl -u certbot -b --no-pager'
    fi
    if [[ "$CERT_CDN_DOMAIN" == *.* ]]; then
        check_certificate "CDN-домена $CERT_CDN_DOMAIN" "$CERT_CDN_DOMAIN" "$CERT_CDN_DOMAIN" \
            "сертификат выпускает CDN: в личном кабинете CDN откройте ресурс и перевыпустите сертификат Let's Encrypt или загрузите новый собственный"
    fi
}
{% endif %}

# Сообщение в Telegram уходит один раз на каждое новое содержание ($2); $1 - файл
# отметки. Без настроенного Telegram отметка не ставится, и сообщение уйдёт,
# когда уведомления включат.
notify_once() {
    local digest file="$NOTIFIED_DIR/$1"
    [[ -x "$NOTIFIER" ]] || return 0
    digest="$(printf '%s' "$2" | sha256sum | cut -d ' ' -f 1)"
    [[ "$(cat "$file" 2>/dev/null || true)" != "$digest" ]] || return 0
    if "$NOTIFIER" --notify "$3" >/dev/null 2>&1; then
        install -d -m 0700 "$NOTIFIED_DIR"
        printf '%s\n' "$digest" >"$file"
        chmod 0600 "$file"
    fi
}

# Порог напоминания о сроке домена: сообщение повторяется за 30, 14, 7, 3 дня и
# за день, а не каждый день.
domain_bucket() {
    local days="$1" bucket
    for bucket in 1 3 7 14; do
        if (( days <= bucket )); then
            echo "$bucket"
            return 0
        fi
    done
    echo 30
}

# Уведомления по итогам плановой проверки: новые версии AmneziaWG и Xray с
# командой установки, срок регистрации домена и срок TLS-сертификата. Новое ядро сюда не входит: его
# ставит ночное обслуживание, а перезагрузку выполняет cascade-reboot.
notify_news() {
    local level component message action node updates='' domains='' key='' certs='' cert_key=''
    local newline=$'\n' days_re='через ([0-9]+) дн'
    node="${ROLE^^}"
    while IFS=$'\t' read -r level component message action; do
        case "$level:$component" in
            UPD:amneziawg)
                # AmneziaWG на ENTRY и EXIT ставится из одного репозитория и
                # обновляется одной командой с ENTRY: сообщает только ENTRY.
                [[ "$ROLE" == entry ]] || continue
                updates+="${updates:+$newline}${message}${newline}→ ${action}"
                ;;
            UPD:xray)
                updates+="${updates:+$newline}${message}${newline}→ ${action}"
                ;;
            WARN:domain)
                domains+="${domains:+$newline}${message}${newline}→ ${action}"
                if [[ "$message" =~ $days_re ]]; then
                    key+="${message%% (через*} порог $(domain_bucket "${BASH_REMATCH[1]}")$newline"
                else
                    key+="$message$newline"
                fi
                ;;
            WARN:cert)
                # Те же пороги, что у домена: сообщение повторяется за 14, 7, 3 дня
                # и за день, а не каждый день.
                certs+="${certs:+$newline}${message}${newline}→ ${action}"
                if [[ "$message" =~ $days_re ]]; then
                    cert_key+="${message%% (через*} порог $(domain_bucket "${BASH_REMATCH[1]}")$newline"
                else
                    cert_key+="$message$newline"
                fi
                ;;
        esac
    done <"$STATE_FILE"
    if [[ -n "$updates" ]]; then
        notify_once updates-notified "$updates" "AWG ${node}: доступно обновление компонентов${newline}${updates}"
    else
        rm -f "$NOTIFIED_DIR/updates-notified"
    fi
    if [[ -n "$domains" ]]; then
        notify_once domain-notified "$key" "AWG ${node}: заканчивается регистрация домена${newline}${domains}"
    else
        rm -f "$NOTIFIED_DIR/domain-notified"
    fi
    if [[ -n "$certs" ]]; then
        notify_once cert-notified "$cert_key" "AWG ${node}: заканчивается срок TLS-сертификата${newline}${certs}"
    else
        rm -f "$NOTIFIED_DIR/cert-notified"
    fi
}

run_checks() {
    local temporary refresh="${1:-refresh}"
    install -d -m 0700 "$STATE_DIR"
    temporary="$(mktemp "$STATE_DIR/.state.XXXXXX")"
    {
        printf '#checked\t%s\n' "$(date -u '+%Y-%m-%d %H:%M UTC')"
        [[ "$refresh" != refresh ]] || refresh_package_lists
        check_kernel
{% if awg_node_role in ['entry', 'exit'] %}
        check_amneziawg
{% endif %}
{% if awg_node_role == 'front' %}
        check_xray
        check_domains
        check_certificates
{% endif %}
    } >"$temporary"
    chmod 0600 "$temporary"
    mv -f "$temporary" "$STATE_FILE"
}

# В терминале итог - рамка: зелёная OK, если всё актуально и репозитории
# ответили, жёлтая WARN с командами установки, если есть обновления или
# проверка неполная. Критичного состояния у этой команды нет: найденное
# обновление на работу каскада не влияет.
show_state() {
    local level component message action checked='' updates=0 warnings=0 stale=false
    while IFS=$'\t' read -r level component message action; do
        case "$level" in
            '#checked') checked="$component" ;;
            WARN)
                warnings=$((warnings + 1))
                report_line WARN "$message"
                [[ -z "$action" ]] || printf '     → %s\n' "$action"
                report_note WARN "$message" "$action"
                ;;
            UPD)
                updates=$((updates + 1))
                report_line UPD "$message"
                [[ -z "$action" ]] || printf '     → %s\n' "$action"
                report_note WARN "$message" "$action"
                ;;
            OK|INFO)
                report_line "$level" "$message"
                if [[ "$level" == INFO && "$component" == apt ]]; then
                    stale=true
                    report_note WARN "$message" \
                        'проверьте DNS сервера и зеркало Ubuntu (например, mirror.yandex.ru), затем повторите kalimera-updates'
                fi
                ;;
        esac
    done <"$STATE_FILE"
    if [[ "$report_fancy" != true ]]; then
        printf 'Доступно обновлений: %d; проверено: %s (%s)\n' "$updates" "${checked:-?}" "$ROLE"
        return 0
    fi
    report_note_lines
    report_box_lines+=("Проверено: ${checked:-?}")
    if (( warnings > 0 )); then
        report_box WARN "kalimera-updates $ROLE: замечаний: $warnings; доступно обновлений: $updates" "${report_box_lines[@]}"
    elif (( updates > 0 )); then
        report_box WARN "kalimera-updates $ROLE: доступно обновлений: $updates" "${report_box_lines[@]}"
    elif [[ "$stale" == true ]]; then
        report_box WARN "kalimera-updates $ROLE: обновлений не найдено, но проверка неполная" "${report_box_lines[@]}"
    else
        report_box OK "kalimera-updates $ROLE: всё актуально" "${report_box_lines[@]}"
    fi
}

install_kernel() {
    local running meta
    local -a packages=()
    running="$(uname -r)"
    meta="$(kernel_meta_package "$running")"
    packages+=("$meta")
{% if awg_node_role in ['entry', 'exit'] %}
    # Заголовки нужны DKMS, чтобы собрать модуль AmneziaWG под новое ядро.
    packages+=("${meta/linux-image-/linux-headers-}")
{% endif %}
    export DEBIAN_FRONTEND=noninteractive
    exec 9>"$APT_LOCK"
    flock -w 600 9 || { echo 'Другое обслуживание пакетов не завершилось за 10 минут.' >&2; exit 75; }
    apt-get -o DPkg::Lock::Timeout=600 update
    apt-get -o DPkg::Lock::Timeout=600 install -y "${packages[@]}"
{% if awg_node_role in ['entry', 'exit'] %}
    /usr/local/sbin/awg-kernel-guard
{% endif %}
    flock -u 9
    exec 9>&-
    run_checks no-refresh
    show_state
    # Сообщение о перезагрузке - только если новое ядро действительно установлено.
    # Раньше оно выводилось и тогда, когда ставить было нечего.
    if grep -Eq $'^UPD\tkernel\tядро [^\t]+ установлено' "$STATE_FILE"; then
        printf '%s\n' \
            'Ядро установлено, но начнёт работать после перезагрузки: sudo reboot' \
            'Серверы одного каскада перезагружайте по очереди: следующий - только после awg-health --strict на предыдущем.'
    elif grep -q $'^UPD\tkernel\t' "$STATE_FILE"; then
        printf '%s\n' 'Новое ядро доступно, но не установилось: причина в выводе apt выше.' >&2
    else
        printf '%s\n' 'Новое ядро не требуется: работает актуальное, перезагрузка не нужна.'
    fi
}

case "${1:-}" in
    # check - прежнее имя той же команды; оставлено для совместимости.
    ''|check) [[ $# -le 1 ]] || { usage >&2; exit 2; }; run_checks; show_state ;;
    # Запуск по таймеру: та же проверка и уведомление в Telegram о найденном.
    --scheduled) [[ $# -eq 1 ]] || { usage >&2; exit 2; }; run_checks; show_state; notify_news ;;
    install)
        [[ $# -eq 2 && "$2" == kernel ]] || { usage >&2; exit 2; }
        install_kernel
        ;;
    --help|-h) [[ $# -eq 1 ]] || { usage >&2; exit 2; }; usage ;;
    *) usage >&2; exit 2 ;;
esac
