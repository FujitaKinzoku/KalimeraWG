#!/usr/bin/env bash
set -Eeuo pipefail
[[ $EUID -eq 0 ]] || { echo 'Запустите команду от root.' >&2; exit 1; }
usage() { echo 'Использование: update-all'; }
case "${1:-}" in
  '') [[ $# -eq 0 ]] || { usage >&2; exit 2; } ;;
  --help|-h) [[ $# -eq 1 ]] || { usage >&2; exit 2; }; usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac
export DEBIAN_FRONTEND=noninteractive

{% include 'apt-full-upgrade.inc.j2' %}

exec 9>/run/awg-apt-maintenance.lock
flock -w 600 9 || { echo 'Другое обслуживание пакетов не завершилось за 10 минут.' >&2; exit 75; }
awg_full_upgrade
{% if awg_node_role | default('') in ['entry', 'exit'] %}
/usr/local/sbin/awg-kernel-guard
{% endif %}
flock -u 9
exec 9>&-
{{ kalimera_updates_path | default('/usr/local/sbin/kalimera-updates') | quote }} >/dev/null 2>&1 || true
{{ awg_server_audit_path | quote }}
{% if awg_node_role | default('') in ['entry', 'exit'] %}
printf '%s\n' \
  'AmneziaWG и sing-box не обновляются обычным update-all.' \
  'Пакеты AmneziaWG на ENTRY и EXIT с откатом, без смены клиентских конфигов:' \
  '  kalimera-deploy --resume --update-amneziawg'
{% else %}
printf '%s\n' \
  'Xray-core обновляется с управляющего ENTRY: kalimera-deploy --resume --update-xray'
{% endif %}
[[ ! -e /var/run/reboot-required ]] ||
  echo 'Требуется перезагрузка; автоматически она не выполняется: sudo reboot (серверы одного каскада по очереди).'
