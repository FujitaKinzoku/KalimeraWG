#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
    echo 'Использование: doh-switch {status|yandex|custom IPv4 TLS_NAME [PATH]|reset}'
}

[[ $EUID -eq 0 ]] || { echo 'Запустите команду от root.' >&2; exit 1; }
readonly config={{ sing_box_config_path | quote }}
readonly override={{ sing_box_dns_override_path | quote }}
readonly backup_dir=/root/config-backups/entry/sing-box
readonly service={{ sing_box_service_name | quote }}
readonly dns_port={{ entry_dns_ru_port }}
readonly doh_tag=yandex-doh-ru
readonly secretctl={{ runtime_secrets_ctl_path | default('/usr/local/sbin/kalimera-secretctl') | quote }}

[[ -f "$config" ]] || {
    echo 'DoH через RU-прокси недоступен: sing-box не был настроен во время deploy.' >&2
    exit 1
}

validate_ipv4() {
    python3 - "$1" <<'PY'
import ipaddress
import sys

try:
    ipaddress.IPv4Address(sys.argv[1])
except ipaddress.AddressValueError as error:
    raise SystemExit(f"Некорректный IPv4-адрес: {error}")
PY
}

validate_tls_name() {
    local value="$1" label
    local -a labels=()
    [[ "$(printf '%s' "$value" | wc -c)" -le 253 ]] || return 1
    [[ "$value" != .* && "$value" != *. && "$value" != *..* ]] || return 1
    IFS=. read -ra labels <<<"$value"
    for label in "${labels[@]}"; do
        [[ "$label" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$ ]] || return 1
    done
}

action="${1:---help}"
case "$action" in
    --help|-h) [[ $# -eq 1 ]] || { usage >&2; exit 2; }; usage; exit 0 ;;
    status)
        [[ $# -eq 1 ]] || { usage >&2; exit 2; }
        jq -r --arg tag "$doh_tag" '
          .dns.servers[] | select(.tag == $tag) |
          "DoH: https://\(.tls.server_name):\(.server_port)\(.path) [адрес \(.server)]"
        ' "$config"
        [[ -e "$override" ]] && echo 'Источник: локальное переопределение doh-switch' || echo 'Источник: зашифрованный inventory'
        exit 0
        ;;
    yandex)
        [[ $# -eq 1 ]] || { usage >&2; exit 2; }
        server=77.88.8.8
        tls_name=common.dot.dns.yandex.net
        path=/dns-query
        ;;
    custom)
        [[ $# -ge 3 && $# -le 4 ]] || { usage >&2; exit 2; }
        server="$2"
        tls_name="$3"
        path="${4:-/dns-query}"
        ;;
    reset)
        [[ $# -eq 1 ]] || { usage >&2; exit 2; }
        server={{ entry_dns_doh_server | quote }}
        tls_name={{ entry_dns_doh_tls_name | quote }}
        path={{ entry_dns_doh_path | quote }}
        ;;
    *) usage >&2; exit 2 ;;
esac

validate_ipv4 "$server"
validate_tls_name "$tls_name" || { echo 'Некорректное TLS-имя DoH.' >&2; exit 2; }
[[ "$path" =~ ^/[A-Za-z0-9._~!$\&\(\)*+,\;=:@%/?-]*$ ]] || { echo 'Некорректный путь DoH.' >&2; exit 2; }

exec 9>/run/awg-doh-switch.lock
flock 9
install -d -m 0700 "$backup_dir" "$(dirname "$override")"
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
config_backup="$backup_dir/config.json.doh.$timestamp"
override_backup="$backup_dir/doh-override.json.$timestamp"
cp -a "$config" "$config_backup"
override_existed=false
if [[ -e "$override" ]]; then
    cp -a "$override" "$override_backup"
    override_existed=true
fi

tmp="$(mktemp /run/sing-box-doh.XXXXXX)"
override_tmp="$(mktemp /run/sing-box-doh-override.XXXXXX)"
committed=false
service_was_active=false
systemctl is-active --quiet "$service" && service_was_active=true
cleanup() {
    local rc=$?
    if (( rc != 0 )) && [[ "$committed" == true ]]; then
        install -m 0600 "$config_backup" "$config" || true
        if [[ "$override_existed" == true ]]; then
            install -m 0600 "$override_backup" "$override" || true
        else
            rm -f "$override"
        fi
        [[ "$service_was_active" == false ]] || systemctl restart "$service" >/dev/null 2>&1 || true
        echo 'Изменение DoH отменено; предыдущая конфигурация восстановлена.' >&2
    fi
    rm -f "$tmp" "$override_tmp"
    return "$rc"
}
trap cleanup EXIT

jq --arg tag "$doh_tag" --arg server "$server" --arg tls "$tls_name" --arg path "$path" '
  (.inbounds[] | select(.tag == "dns-in") | .override_address) = $server |
  (.dns.servers[] | select(.tag == $tag)) |=
    (.server = $server | .server_port = 443 | .path = $path | .tls.server_name = $tls)
' "$config" >"$tmp"
jq -n --arg server "$server" --arg tls_name "$tls_name" --arg path "$path" \
    '{server:$server,server_port:443,tls_name:$tls_name,path:$path}' >"$override_tmp"
sing-box check --config "$tmp" >/dev/null

committed=true
install -m 0600 "$tmp" "$config"
if [[ "$action" == reset ]]; then
    rm -f "$override"
else
    install -m 0600 "$override_tmp" "$override"
fi

if [[ "$service_was_active" == true ]]; then
    systemctl restart "$service"
    dig +short +time=7 +tries=1 @127.0.0.1 -p "$dns_port" yandex.ru A |
        grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$'
    echo 'DoH проверен через активный RU-прокси и применён.'
else
    echo 'DoH проверен синтаксически и сохранён; sing-box остаётся выключенным.'
fi
{% if runtime_secrets_enabled | default(false) | bool %}
"$secretctl" seal
{% endif %}
committed=false
