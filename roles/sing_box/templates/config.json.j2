{% set dns_override = sing_box_runtime_dns_override | default({}) %}
{% set doh_server = dns_override.server | default(entry_dns_doh_server) %}
{% set doh_port = dns_override.server_port | default(443) %}
{% set doh_path = dns_override.path | default(entry_dns_doh_path) %}
{% set doh_tls_name = dns_override.tls_name | default(entry_dns_doh_tls_name) %}
{
  "log": {
    "disabled": true
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "ru-tun",
      "interface_name": "{{ entry_ru_proxy_interface }}",
      "address": ["{{ entry_ru_tun_address }}"],
      "mtu": {{ entry_ru_tun_mtu }},
      "auto_route": false,
      "strict_route": false,
      "stack": "{{ entry_ru_tun_stack }}",
      "endpoint_independent_nat": {{ entry_ru_endpoint_independent_nat | bool | to_json }}
    },
    {
      "type": "direct",
      "tag": "dns-in",
      "listen": "127.0.0.1",
      "listen_port": {{ entry_dns_ru_port }},
      "override_address": "{{ doh_server }}",
      "override_port": 53
    }{% if reality_fallback_enabled | default(false) | bool %},
    {
      "type": "vless",
      "tag": "reality-in",
      "listen": "::",
      "listen_port": {{ reality_fallback_port }},
      "users": [
        {
          "uuid": "{{ reality_fallback_client_uuid }}",
          "flow": "xtls-rprx-vision"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "{{ reality_fallback_effective_dest | default(reality_fallback_dest) }}",
        "reality": {
          "enabled": true,
          "handshake": {
            "server": "{{ reality_fallback_effective_dest | default(reality_fallback_dest) }}",
            "server_port": {{ reality_fallback_effective_dest_port | default(reality_fallback_dest_port) }}
          },
          "private_key": "{{ reality_fallback_private_key }}",
          "short_id": ["{{ reality_fallback_short_id }}"]
        }
      }
    }{% endif %}
  ],
  "outbounds": [
    {
      "type": "socks",
      "tag": "ru-socks",
{% set proxy_override = sing_box_runtime_proxy_override | default({}) %}
{% set proxy_server = proxy_override.server | default(entry_proxy_server | default(entry_soax_server)) %}
{% set proxy_port = proxy_override.server_port | default(entry_proxy_port | default(entry_soax_port)) %}
      "server": {{ proxy_server | to_json }},
      "server_port": {{ proxy_port }},
      "version": "5",
{% set proxy_username = proxy_override.username | default(vault_proxy_username | default(vault_soax_username | default(''))) %}
{% set proxy_password = proxy_override.password | default(vault_proxy_password | default(vault_soax_password | default(''))) %}
{% if proxy_username | length > 0 %}
      "username": {{ proxy_username | to_json }},
      "password": {{ proxy_password | to_json }},
{% endif %}
      "domain_resolver": {
        "server": "bootstrap-unbound",
        "strategy": "ipv4_only"
      }
    }{% if reality_fallback_enabled | default(false) | bool %},
    {
      "type": "direct",
      "tag": "direct-exit",
      "routing_mark": "{{ entry_exit_mark }}",
      "domain_resolver": {
        "server": "bootstrap-unbound",
        "strategy": "ipv4_only"
      }
    }{% endif %}
  ],
  "route": {
    "final": "ru-socks",
    "default_interface": "{{ entry_wan_interface }}",
{% if reality_fallback_enabled | default(false) | bool %}
    "default_domain_resolver": "bootstrap-unbound",
    "rule_set": [
      {
        "type": "local",
        "tag": "reality-ru-domains",
        "format": "source",
        "path": "{{ reality_fallback_ru_rule_set_path }}"
      },
      {
        "type": "local",
        "tag": "reality-ru-zone",
        "format": "source",
        "path": "{{ reality_fallback_ru_zone_rule_set_path }}"
      }
    ],
{% endif %}
    "rules": [
      {
        "inbound": ["dns-in"],
        "action": "hijack-dns"
      }{% if reality_fallback_enabled | default(false) | bool %},
      {
        "inbound": ["reality-in"],
        "domain_suffix": [".ru", ".xn--p1ai"],
        "outbound": "ru-socks"
      },
      {
        "inbound": ["reality-in"],
        "rule_set": ["reality-ru-domains"],
        "outbound": "ru-socks"
      },
      {
        "inbound": ["reality-in"],
        "rule_set": ["reality-ru-zone"],
        "outbound": "ru-socks"
      },
      {
        "inbound": ["reality-in"],
        "outbound": "direct-exit"
      }{% endif %}
    ]
  },
  "dns": {
    "servers": [
      {
        "type": "udp",
        "tag": "bootstrap-unbound",
        "server": "127.0.0.1",
        "server_port": {{ entry_dns_default_port }}
      },
      {
        "type": "https",
        "tag": "yandex-doh-ru",
        "server": "{{ doh_server }}",
        "server_port": {{ doh_port }},
        "path": "{{ doh_path }}",
        "detour": "ru-socks",
        "tls": {
          "enabled": true,
          "server_name": "{{ doh_tls_name }}"
        }
      }
    ],
    "final": "yandex-doh-ru",
    "strategy": "ipv4_only",
    "disable_cache": true
  }
}
