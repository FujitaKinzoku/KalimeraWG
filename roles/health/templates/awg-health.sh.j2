check 'Xray не может изменять каталог конфигурации' front_xray_permissions_are_restricted
check 'Nginx не сохраняет журналы активности' nginx_no_logs_policy_is_active
check 'TLS-сертификат FRONT origin-домена не близок к истечению' \
