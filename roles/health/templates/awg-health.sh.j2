#!/usr/bin/env bash
set -Eeuo pipefail

usage() { echo 'Использование: awg-health [--strict]'; }
strict=false
case "${1:-}" in
    '') ;;
    --strict) [[ $# -eq 1 ]] || { usage >&2; exit 2; }; strict=true ;;
    --help|-h) [[ $# -eq 1 ]] || { usage >&2; exit 2; }; usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
esac
failures=0

check() {
    local label="$1"
    shift
    if "$@" >/dev/null 2>&1; then
        printf 'OK   %s\n' "$label"
    else
        printf 'FAIL %s\n' "$label"
        failures=$((failures + 1))
    fi
}

check_value() {
    local label="$1" actual="$2" expected="$3"
    if [[ "$actual" == "$expected" ]]; then
        printf 'OK   %s\n' "$label"
    else
        printf 'FAIL %s (ожидалось %s, получено %s)\n' "$label" "$expected" "$actual"
        failures=$((failures + 1))
    fi
}

has_rule() {
    local mark="$1" table="$2" priority="$3"
    ip -4 rule show | grep -Eq "^${priority}:.*fwmark ${mark}.*lookup ${table}"
}

rule_absent() {
    ! has_rule "$@"
}

service_inactive() {
    ! systemctl is-active --quiet "$1"
}

systemd_config_last_value() {
    local config="$1" key="$2"
    systemd-analyze cat-config "$config" |
        awk -F= -v wanted="$key" '
            {
                name = $1
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", name)
                if (name == wanted) {
                    value = substr($0, index($0, "=") + 1)
                    gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
                    last = value
                }
            }
            END { if (last != "") print last }
        '
}

journald_is_volatile() {
    [[ "$(systemd_config_last_value systemd/journald.conf Storage)" == volatile ]] &&
        [[ "$(systemd_config_last_value systemd/journald.conf ForwardToSyslog)" == no ]]
}

rsyslog_is_disabled() {
    local enabled
    ! systemctl is-active --quiet rsyslog.service &&
        enabled="$(systemctl is-enabled rsyslog.service 2>/dev/null || true)" &&
        [[ "$enabled" == masked || "$enabled" == not-found ]]
}

coredump_storage_is_disabled() {
    [[ "$(systemd_config_last_value systemd/coredump.conf Storage)" == none ]] &&
        [[ "$(systemd_config_last_value systemd/coredump.conf ProcessSizeMax)" == 0 ]]
}

login_accounting_is_volatile() {
    local name
    for name in wtmp btmp lastlog faillog; do
        [[ "$(readlink -f "/var/log/$name")" == "/run/kalimerawg-accounting/$name" ]] ||
            return 1
    done
}

fail2ban_state_is_volatile() {
    grep -Eq '^[[:space:]]*logtarget[[:space:]]*=[[:space:]]*SYSTEMD-JOURNAL[[:space:]]*$' \
        /etc/fail2ban/fail2ban.local &&
        grep -Eq '^[[:space:]]*dbfile[[:space:]]*=[[:space:]]*:memory:[[:space:]]*$' \
            /etc/fail2ban/fail2ban.local
}


fail2ban_sshd_policy_is_strict() {
    local jail=/etc/fail2ban/jail.d/zz-awg-sshd.local
    fail2ban-client -t >/dev/null 2>&1 &&
        fail2ban-client status sshd >/dev/null 2>&1 &&
        [[ "$(fail2ban-client get sshd maxretry 2>/dev/null)" == "{{ fail2ban_sshd.maxretry | int }}" ]] &&
        grep -Eq '^[[:space:]]*mode[[:space:]]*=[[:space:]]*aggressive[[:space:]]*$' "$jail" &&
        grep -Eq '^[[:space:]]*backend[[:space:]]*=[[:space:]]*systemd[[:space:]]*$' "$jail" &&
        grep -Eq '^[[:space:]]*banaction[[:space:]]*=[[:space:]]*ufw[[:space:]]*$' "$jail" &&
        grep -Eq '^[[:space:]]*usedns[[:space:]]*=[[:space:]]*no[[:space:]]*$' "$jail" &&
        grep -Eq '^[[:space:]]*ignoreip[[:space:]]*=[[:space:]]*127\.0\.0\.1/8[[:space:]]+::1[[:space:]]*$' "$jail"
}

ufw_logging_is_disabled() {
    ufw status verbose | grep -Eq '^Logging:[[:space:]]+off'
}

{% if security_manage_admin_account | default(false) | bool %}
managed_admin_is_ready() {
    id {{ security_admin_user | quote }} >/dev/null 2>&1 &&
        id -nG {{ security_admin_user | quote }} | tr ' ' '\n' | grep -Fxq sudo &&
        passwd -S {{ security_admin_user | quote }} | grep -Eq '^[^ ]+[[:space:]]+P[[:space:]]' &&
        passwd -S root | grep -Eq '^root[[:space:]]+P[[:space:]]' &&
        test -s {{ ('/home/' ~ security_admin_user ~ '/.ssh/authorized_keys') | quote }} &&
        test -x {{ security_admin_command_path | quote }} &&
        visudo -cf /etc/sudoers.d/90-kalimera-admin >/dev/null 2>&1 &&
        ! grep -Eq 'NOPASSWD:[[:space:]]+ALL([[:space:]]|$)' /etc/sudoers.d/90-kalimera-admin
}
{% endif %}

{% if runtime_secrets_enabled | default(false) | bool %}
runtime_secrets_are_healthy() {
    systemctl is-enabled --quiet {{ runtime_secrets_service_name | quote }} &&
        systemctl is-active --quiet {{ runtime_secrets_service_name | quote }} &&
        {{ runtime_secrets_ctl_path | quote }} verify >/dev/null 2>&1
}

runtime_secret_dependencies_are_loaded() {
    systemctl cat awg-quick@.service | grep -Fq 'LoadCredential=%i.conf:' &&
        systemctl cat {{ awg3_transit_service_name | default('awg3-transit.service') | quote }} |
            grep -Fq 'LoadCredential=awg3.conf:'
}
{% endif %}

{% if awg_node_role == 'entry' %}
dns_no_logs_policy_is_active() {
    grep -Fxq 'cache-size=0' /etc/dnsmasq.d/50-awg-base.conf &&
        ! grep -Eq '^[[:space:]]*log-queries([=[:space:]]|$)' \
            /etc/dnsmasq.d/50-awg-base.conf &&
        grep -Fxq 'Cache=no' {{ entry_dns_resolved_dropin_path | quote }} &&
        grep -Eq '^[[:space:]]*log-queries:[[:space:]]*no[[:space:]]*$' \
            /etc/unbound/unbound.conf.d/90-awg-dot.conf &&
        grep -Eq '^[[:space:]]*log-replies:[[:space:]]*no[[:space:]]*$' \
            /etc/unbound/unbound.conf.d/90-awg-dot.conf
}

sing_box_no_logs_policy_is_active() {
    [[ ! -e /etc/sing-box/config.json ]] ||
        jq -e '.log.disabled == true and .dns.disable_cache == true' \
            /etc/sing-box/config.json >/dev/null
}
{% endif %}

handshake_recent() {
    local interface="$1" max_age="$2" tool="${3:-awg}" latest now
    latest="$("$tool" show "$interface" latest-handshakes |
        awk '{print $2}' | sort -nr | head -n 1)"
    now="$(date +%s)"
    [[ "$latest" =~ ^[0-9]+$ ]] &&
        (( latest > 0 && now >= latest && now - latest <= max_age ))
}

has_default_route() {
    local table="$1" interface="$2"
    ip -4 route show table "$table" | grep -Eq "^default .*dev ${interface}( |$)"
}

ufw_active() {
    ufw status | grep -Eq '^Status: active$'
}

ufw_matches_managed_snapshot() {
    local marker={{ security_ufw_policy_marker | quote }} expected actual status
    [[ -r "$marker" ]] || return 1
    expected="$(cut -d '|' -f 2 "$marker")"
    # Fail2Ban закономерно добавляет и удаляет временные REJECT-правила. Они
    # имеют собственный комментарий и не являются изменением постоянной
    # управляемой политики KalimeraWG. Все остальные правила остаются частью
    # контролируемого отпечатка.
    status="$(
        LC_ALL=C ufw status |
            sed -E \
                '/#[[:space:]]+by Fail2Ban after [0-9]+ attempts against sshd[[:space:]]*$/d'
    )"
    actual="$(printf '%s' "$status" | sha256sum | awk '{print $1}')"
    [[ -n "$expected" && "$actual" == "$expected" ]]
}

interface_mtu_is() {
    local interface="$1" expected="$2" actual
    actual="$(ip -o link show dev "$interface" | sed -n 's/.* mtu \([0-9][0-9]*\).*/\1/p')"
    [[ "$actual" == "$expected" ]]
}

aaaa_filtered() {
    [[ -z "$(dig +short +time=3 +tries=1 @{{ entry_client_listen_address | default('127.0.0.1') }} example.com AAAA)" ]]
}

ufw_interserver_restricted() {
    local interface="$1" peer="$2" port="$3"
    iptables -w 10 -C ufw-user-input -i "$interface" -p udp \
        -s "${peer}/32" --dport "$port" -j ACCEPT
}

ufw_interserver_has_no_broad_allow() {
    local interface="$1" peer="$2" port="$3" rule
    while IFS= read -r rule; do
        [[ "$rule" == *"-s ${peer}/32"* ]] || return 1
    done < <(
        iptables -w 10 -S ufw-user-input |
            grep -F -- "-i ${interface}" |
            grep -F -- '-p udp' |
            grep -F -- "--dport ${port}" |
            grep -F -- '-j ACCEPT' || true
    )
}

ufw_client_destination_denied() {
    local interface="$1" source="$2" destination="$3"
    iptables -w 10 -C ufw-user-forward -i "$interface" \
        -s "$source" -d "$destination" -j DROP
}

ufw_client_zones_isolated() {
    ufw_client_destination_denied "$1" "$2" "$3" &&
        ufw_client_destination_denied "$4" "$5" "$6"
}

route_uses_interface() {
    local destination="$1" mark="$2" interface="$3"
    ip -4 route get "$destination" mark "$mark" | grep -Eq " dev ${interface}( |$)"
}

mail_port_25_absent() {
    ! ipset test ru_direct_tcp_ports 25 >/dev/null 2>&1
}

direct_bypass_absent() {
    [[ "$(ipset list ru_direct_tcp_ports 2>/dev/null | sed -n 's/^Number of entries: //p')" == 0 ]]
}

direct_port_bypasses_proxy() {
    local set_name="$1" port="$2"
    ipset test ru_direct_tcp_ports "$port" >/dev/null 2>&1 &&
    iptables -w 10 -t mangle -C AWG_RU_PROXY -p tcp \
        -m set --match-set "$set_name" dst \
        -m set --match-set ru_direct_tcp_ports dst -j RETURN
}

udp_ru_bypasses_proxy() {
    local set_name="$1"
    iptables -w 10 -t mangle -C AWG_RU_PROXY -p udp \
        -m set --match-set "$set_name" dst -j RETURN
}

udp_ru_bypass_absent() {
    ! iptables -w 10 -t mangle -S AWG_RU_PROXY |
        grep -Eq -- '-p udp .*--match-set (force_ru|ru) dst .* -j RETURN'
}

{% if reality_fallback_enabled | default(false) | bool %}
tcp_port_listening() {
    local port="$1"
    ss -H -ltn "( sport = :${port} )" | grep -q .
}
