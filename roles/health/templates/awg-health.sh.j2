nginx_no_logs_policy_is_active() {
    local effective
    effective="$(nginx -T 2>&1)" || return 1
    grep -Eq '^[[:space:]]*access_log[[:space:]]+off;' <<<"$effective" &&
        grep -Eq '^[[:space:]]*error_log[[:space:]]+/dev/null[[:space:]]+crit;' <<<"$effective" &&
        ! find /var/log/nginx -type f -size +0c -print -quit 2>/dev/null | grep -q .
}

check 'UFW активен' ufw_active
