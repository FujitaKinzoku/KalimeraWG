check 'systemd journal хранится только в RAM' journald_is_volatile
check 'постоянный rsyslog отключён' rsyslog_is_disabled
check 'coredump не сохраняются' coredump_storage_is_disabled
check 'учёт входов хранится только в RAM' login_accounting_is_volatile
# Xray-core поднимает исходящее REALITY-соединение к ENTRY лениво - только
# когда через XHTTP приходит настоящий клиент. Во время deploy клиентов нет,
# поэтому проверка established-соединения всегда падала бы, а health
# запускается с --strict и заблокировал бы установку. Проверяем то, что
# обязано быть верно всегда: reality-порт ENTRY доступен с FRONT.
front_entry_reality_reachable() {
    timeout 5 bash -c \
        'exec 3<>/dev/tcp/{{ front_entry_address }}/{{ front_entry_reality_port }}'
}

front_vless_users_are_consistent() {
    local state_ids active_ids
    state_ids="$(jq -r '.users[].id' {{ front_vless_users_path | quote }} | sort)" || return 1
    active_ids="$(jq -r '.inbounds[0].settings.clients[].id' {{ front_xray_config_path | quote }} | sort)" || return 1
    [[ -n "$state_ids" && "$state_ids" == "$active_ids" ]] &&
        {{ front_vless_user_command_path | quote }} list >/dev/null
}

front_vless_encryption_is_enabled() {
    jq -e '
        .inbounds[0].settings.decryption |
        type == "string" and
        startswith("mlkem768x25519plus.native.600s.")
    ' {{ front_xray_config_path | quote }} >/dev/null 2>&1 &&
        jq -e '
            .encryption |
            type == "string" and
            startswith("mlkem768x25519plus.native.0rtt.")
        ' {{ front_vless_client_settings_path | quote }} >/dev/null 2>&1
}

front_xray_permissions_are_restricted() {
    local state_dir resolved mode numeric_mode
    state_dir={{ front_xray_state_dir | quote }}
    resolved="$(readlink -f -- "$state_dir")" || return 1
    [[ -d "$resolved" ]] || return 1
{% if runtime_secrets_enabled | default(false) | bool %}
    [[ "$resolved" == {{ (runtime_secrets_runtime_root ~ '/xray') | quote }} ]] || return 1
{% endif %}
    [[ "$(stat -Lc %U -- "$state_dir")" == root ]] || return 1
    mode="$(stat -Lc %a -- "$state_dir")" || return 1
    numeric_mode=$((8#$mode))
    (( (numeric_mode & 0022) == 0 )) &&
        ! systemctl cat {{ front_xray_service_name | quote }} |
            grep -Fq 'ReadWritePaths='
}

front_tls_endpoint_ready() {
    local domain="$1"
    getent ahostsv4 "$domain" >/dev/null 2>&1 &&
        printf '' | timeout 10 openssl s_client \
            -connect "${domain}:443" -servername "$domain" \
            -verify_return_error >/dev/null 2>&1
}

check 'служба Xray-core FRONT-релея' systemctl is-active --quiet {{ front_xray_service_name }}
check 'служба Nginx FRONT-релея' systemctl is-active --quiet nginx.service
