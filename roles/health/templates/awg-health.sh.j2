{% if awg_node_role == 'entry' and entry_mobile_client_available | default(false) | bool %}
mobile_awg31_profile_is_complete() {
    local config
    config="$({{ awg3_mobile_tools_binary_path | quote }} showconf {{ entry_mobile_client_interface | quote }} 2>/dev/null)" || return 1
    for field in HeaderProtectionKey ContentPaddingAddition RekeyAfterTime \
        RekeyTimeout RejectAfterTime KeepaliveTimeout MaxHandshakeAttempts \
        RandomTrailers DisableCookies I1 I2 I3 I4 I5; do
        grep -Eq "^${field}[[:space:]]*=[[:space:]]*[^[:space:]].*$" <<<"$config" || return 1
    done
}
{% endif %}

{% if awg_node_role == 'entry' %}
dns_no_logs_policy_is_active() {
    grep -Fxq 'cache-size=0' /etc/dnsmasq.d/50-awg-base.conf &&
        ! grep -Eq '^[[:space:]]*log-queries([=[:space:]]|$)' \
            /etc/dnsmasq.d/50-awg-base.conf &&
        grep -Fxq 'Cache=no' {{ entry_dns_resolved_dropin_path | quote }} &&
        grep -Eq '^[[:space:]]*log-queries:[[:space:]]*no[[:space:]]*$' \
            /etc/unbound/unbound.conf.d/90-awg-dot.conf &&
        grep -Eq '^[[:space:]]*log-replies:[[:space:]]*no[[:space:]]*$' \
            /etc/unbound/unbound.conf.d/90-awg-dot.conf
}

sing_box_no_logs_policy_is_active() {
    [[ ! -e /etc/sing-box/config.json ]] ||
        jq -e '.log.disabled == true and .dns.disable_cache == true' \
            /etc/sing-box/config.json >/dev/null
}
