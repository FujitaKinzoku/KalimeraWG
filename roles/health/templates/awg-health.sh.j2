    [[ -z "$direct_port" ]] && continue
    direct_ports_present=true
    check "прямой порт $direct_port force_ru обходит прокси" direct_port_bypasses_proxy force_ru "$direct_port"
    check "прямой российский порт $direct_port обходит прокси" direct_port_bypasses_proxy ru "$direct_port"
done <{{ entry_ru_direct_tcp_ports_file | quote }}
if [[ "$direct_ports_present" == false ]]; then
    check 'политика прямых российских портов пуста' direct_bypass_absent
else
    printf 'OK   все прямые российские TCP-порты применены без ограничения multiport\n'
fi
check 'почтовый порт 25 не обходится' mail_port_25_absent
check 'исходящий TCP MSS clamp ENTRY сервера' iptables -w 10 -t mangle -C FORWARD -i {{ entry_client_interface | quote }} -s {{ entry_client_subnet | quote }} -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
check 'входящий TCP MSS clamp ENTRY сервера' iptables -w 10 -t mangle -C FORWARD -o {{ entry_client_interface | quote }} -d {{ entry_client_subnet | quote }} -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
{% if entry_ru_proxy_enabled | bool %}
{% if entry_ru_proxy_manual_disabled_flag is defined %}
if [[ -e {{ entry_ru_proxy_manual_disabled_flag | quote }} ]]; then
    check 'sing-box вручную отключён' service_inactive {{ sing_box_service_name | quote }}
    check 'watchdog российского прокси вручную отключён' service_inactive {{ entry_ru_proxy_watch_timer_name | quote }}
    check 'правило policy routing для mark 0x2 отсутствует' rule_absent {{ entry_ru_mark | quote }} {{ entry_ru_table }} {{ entry_ru_rule_priority }}
    check 'российские назначения идут напрямую через ENTRY сервер' route_uses_interface {{ entry_dns_doh_server | quote }} 0x0 {{ entry_wan_interface | quote }}
else
{% endif %}
check 'служба sing-box' systemctl is-active --quiet {{ sing_box_service_name | quote }}
check 'российский TUN-интерфейс' ip link show {{ entry_ru_proxy_interface | quote }}
check 'таймер watchdog российского прокси' systemctl is-active --quiet {{ entry_ru_proxy_watch_timer_name | quote }}
if [[ ! -e {{ entry_ru_proxy_disabled_flag | quote }} ]]; then
    check 'правило policy routing для mark 0x2' has_rule {{ entry_ru_mark | quote }} {{ entry_ru_table }} {{ entry_ru_rule_priority }}
    check 'маршрут по умолчанию в таблице 200' has_default_route {{ entry_ru_table }} {{ entry_ru_proxy_interface | quote }}
    check 'mark 0x2 направляется через российский TUN' route_uses_interface {{ entry_dns_doh_server | quote }} {{ entry_ru_mark | quote }} {{ entry_ru_proxy_interface | quote }}
    check 'прослушивание российского DoH' dig +time=5 +tries=1 @127.0.0.1 -p {{ entry_dns_ru_port | int }} yandex.ru A
    proxy_udp_mode="$(cat {{ entry_ru_proxy_udp_mode_path | quote }} 2>/dev/null || printf direct)"
    if [[ "$proxy_udp_mode" == proxy ]]; then
        check 'RU UDP направляется через SOCKS5' udp_ru_bypass_absent
    else
        check 'force_ru UDP обходит несовместимый SOCKS5' udp_ru_bypasses_proxy force_ru
        check 'российский UDP обходит несовместимый SOCKS5' udp_ru_bypasses_proxy ru
    fi
else
    printf 'OK   активен fail-open российского прокси\n'
fi
{% if entry_ru_proxy_manual_disabled_flag is defined %}
fi
{% endif %}
{% else %}
check 'sing-box намеренно отключён' service_inactive {{ sing_box_service_name | quote }}
check 'watchdog российского прокси намеренно отключён' service_inactive {{ entry_ru_proxy_watch_timer_name | quote }}
check 'правило policy routing для mark 0x2 отсутствует' rule_absent {{ entry_ru_mark | quote }} {{ entry_ru_table }} {{ entry_ru_rule_priority }}
check 'российские назначения идут напрямую через ENTRY сервер' route_uses_interface {{ entry_dns_doh_server | quote }} 0x0 {{ entry_wan_interface | quote }}
{% endif %}
{% if reality_fallback_enabled | default(false) | bool %}
check 'запасной транспорт REALITY прослушивает порт' tcp_port_listening {{ reality_fallback_port | int }}
check 'rule-set REALITY для ru-domain/se-domain корректен' jq -e . {{ reality_fallback_ru_rule_set_path | quote }}
check 'rule-set REALITY для российских подсетей корректен' jq -e . {{ reality_fallback_ru_zone_rule_set_path | quote }}
{% endif %}
{% elif awg_node_role == 'exit' %}
{% if awg3_transit_enabled | default(false) | bool %}
check 'служба AWG 3+ EXIT сервера' systemctl is-active --quiet {{ awg3_transit_service_name | quote }}
{% else %}
check 'служба AWG EXIT сервера' systemctl is-active --quiet awg-quick@{{ exit_awg_interface }}.service
{% endif %}
check 'интерфейс AWG EXIT сервера' ip link show {{ exit_awg_interface | quote }}
{% if awg3_transit_enabled | default(false) | bool %}
check 'состояние AWG 3+ EXIT сервера доступно' {{ awg3_tools_binary_path | quote }} show {{ exit_awg_interface | quote }}
{% else %}
check 'состояние AWG EXIT сервера доступно' awg show {{ exit_awg_interface | quote }}
{% endif %}
{% if awg3_transit_enabled | default(false) | bool %}
check 'свежий handshake EXIT–ENTRY' handshake_recent {{ exit_awg_interface | quote }} 180 {{ awg3_tools_binary_path | quote }}
check 'MTU межсерверного интерфейса EXIT применён' interface_mtu_is {{ exit_awg_interface | quote }} {{ awg3_transit_effective_mtu | int }}
{% else %}
check 'свежий handshake EXIT–ENTRY' handshake_recent {{ exit_awg_interface | quote }} 180
{% endif %}
check 'ограниченный NAT EXIT сервера' iptables -w 10 -t nat -C POSTROUTING -s {{ exit_awg_subnet | quote }} -o {{ exit_wan_interface | quote }} -j MASQUERADE
check 'изоляция клиентов EXIT сервера' iptables -w 10 -C FORWARD -i {{ exit_awg_interface | quote }} -o {{ exit_awg_interface | quote }} -j DROP
{% if awg3_transit_enabled | default(false) | bool %}
check 'исходящий TCP MSS EXIT сервера' iptables -w 10 -t mangle -C FORWARD -o {{ exit_awg_interface | quote }} -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
check 'входящий TCP MSS EXIT сервера' iptables -w 10 -t mangle -C FORWARD -i {{ exit_awg_interface | quote }} -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
{% else %}
check 'исходящий TCP MSS EXIT сервера' iptables -w 10 -t mangle -C FORWARD -o {{ exit_awg_interface | quote }} -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss {{ exit_tcp_mss }}
check 'входящий TCP MSS EXIT сервера' iptables -w 10 -t mangle -C FORWARD -i {{ exit_awg_interface | quote }} -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss {{ exit_tcp_mss }}
{% endif %}
{% if entry_dns_default_via_exit | default(false) | bool %}
check 'рекурсивный DNS EXIT сервера активен' systemctl is-active --quiet unbound.service
check 'рекурсивный DNS EXIT сервера отвечает' dig +time=3 +tries=1 @{{ exit_awg_address | ansible.utils.ipaddr('address') }} example.com A
{% endif %}
{% endif %}

if [[ "$failures" -eq 0 ]]; then
    printf 'GOOD: все проверки пройдены\n'
    exit 0
fi

printf 'BAD: ошибок проверки: %d\n' "$failures"
[[ "$strict" == true ]] && exit 1
exit 0
