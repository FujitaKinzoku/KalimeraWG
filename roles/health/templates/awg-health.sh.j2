#!/usr/bin/env bash
set -Eeuo pipefail

usage() { echo 'Использование: awg-health [--strict]'; }
strict=false
case "${1:-}" in
    '') ;;
    --strict) [[ $# -eq 1 ]] || { usage >&2; exit 2; }; strict=true ;;
    --help|-h) [[ $# -eq 1 ]] || { usage >&2; exit 2; }; usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
esac
failures=0
critical=0
passed=0

{% raw %}
# >>> kalimera-report: общий блок оформления отчёта.
# Блок одинаков в awg-health, server-audit и kalimera-updates, совпадение
# проверяет tests/test_report_style.py. Цвет, итоговая рамка и рекомендации
# выводятся только в терминал. В файл, журнал, Ansible и Telegram-монитор
# уходит прежний текст: без управляющих символов, с префиксами
# OK/FAIL/WARN/UPD/INFO, по которым эти строки разбирают.
# KALIMERA_REPORT_STYLE=fancy|plain нужен тестам; sudo эту переменную не
# пропускает.
case "${KALIMERA_REPORT_STYLE:-auto}" in
    fancy) report_fancy=true ;;
    plain) report_fancy=false ;;
    *)
        report_fancy=false
        if [[ -t 1 && -z "${NO_COLOR:-}" && "${TERM:-dumb}" != dumb ]]; then
            report_fancy=true
        fi
        ;;
esac
report_reset=$'\033[0m'
# KALIMERA_REPORT_RESULTS - файл для cascade-check: report_line записывает OK,
# report_note - FAIL и WARN с рекомендацией. Переменная сбрасывается сразу, чтобы
# вложенные awg-health или server-audit не дописывали свои строки в тот же файл.
report_results_file="${KALIMERA_REPORT_RESULTS:-}"
unset KALIMERA_REPORT_RESULTS
# Замечания для итоговой рамки: "FAIL|WARN<TAB>что не так<TAB>что сделать".
# FAIL - работа каскада нарушена критически, WARN - каскад работает.
report_notes=()
report_box_lines=()

# Строка результата: OK зелёная, FAIL и WARN жёлтые, UPD голубая.
report_line() {
    local level="$1" text="$2" color=''
    if [[ "$report_fancy" == true ]]; then
        case "$level" in
            OK) color=$'\033[32m' ;;
            FAIL|WARN) color=$'\033[33m' ;;
            UPD) color=$'\033[36m' ;;
        esac
    fi
    printf '%s%-4s %s%s\n' "$color" "$level" "$text" "${color:+$report_reset}"
    [[ "$level" != OK ]] || report_export OK "$text"
}

# Строка в файл результатов: "СТАТУС<TAB>проверка<TAB>рекомендация".
report_export() {
    [[ -n "$report_results_file" ]] || return 0
    printf '%s\t%s\t%s\n' "$1" "$2" "${3:-}" >>"$report_results_file"
}

report_note() {
    report_notes+=("$1"$'\t'"$2"$'\t'"${3:-}")
    report_export "$1" "$2" "${3:-}"
}

# $1 - цвет рамки, $2 - ширина текста, $3 - строка, $4 - цвет строки.
report_box_emit() {
    local pad=$(( $2 - ${#3} ))
    (( pad > 0 )) || pad=0
    printf '%s│%s %s%s%s%*s %s│%s\n' "$1" "$report_reset" "${4:-}" "$3" \
        "${4:+$report_reset}" "$pad" '' "$1" "$report_reset"
}

# Перенос по словам. Продолжение строки с маркером (→, ✗, !) выравнивается
# по тексту после маркера.
report_box_row() {
    local lead rest hang line word has_word=false
    local -a words=()
    lead="${3%%[![:space:]]*}"
    rest="${3#"$lead"}"
    hang="$lead"
    case "$rest" in
        '→ '*|'✗ '*|'! '*) hang+='  ' ;;
    esac
    read -r -a words <<<"$rest" || true
    line="$lead"
    for word in "${words[@]}"; do
        if [[ "$has_word" == true ]] && (( ${#line} + 1 + ${#word} > $2 )); then
            report_box_emit "$1" "$2" "$line" "${4:-}"
            line="$hang$word"
        elif [[ "$has_word" == true ]]; then
            line+=" $word"
        else
            line+="$word"
        fi
        has_word=true
    done
    report_box_emit "$1" "$2" "$line" "${4:-}"
}

# Итоговая рамка: $1 - OK (зелёная), WARN (жёлтая) или FAIL (красная),
# $2 - заголовок, дальше строки содержимого.
report_box() {
    [[ "$report_fancy" == true ]] || return 0
    local LC_ALL=C.UTF-8
    local status="$1" title="$2" color width inner rule line
    shift 2
    case "$status" in
        OK) color=$'\033[1;32m' ;;
        WARN) color=$'\033[1;33m' ;;
        *) color=$'\033[1;31m' ;;
    esac
    width="$(tput cols 2>/dev/null || true)"
    [[ "$width" =~ ^[0-9]+$ ]] || width=80
    (( width <= 100 )) || width=100
    (( width >= 40 )) || width=40
    inner=$(( width - 4 ))
    printf -v rule '%*s' "$(( width - 2 ))" ''
    rule="${rule// /─}"
    printf '\n%s┌%s┐%s\n' "$color" "$rule" "$report_reset"
    report_box_row "$color" "$inner" "$status  $title" "$color"
    if (( $# > 0 )); then
        printf '%s├%s┤%s\n' "$color" "$rule" "$report_reset"
        for line in "$@"; do
            report_box_row "$color" "$inner" "$line"
        done
    fi
    printf '%s└%s┘%s\n' "$color" "$rule" "$report_reset"
}

# Замечания -> строки рамки в report_box_lines: сначала критичные (✗), потом
# остальные (!). Одинаковая рекомендация печатается один раз после всех
# замечаний, к которым она относится. Не больше 12 замечаний: остальные
# видны в строках выше.
report_note_lines() {
    local severity marker note level text hint key shown=0 hidden=0 group_shown
    local -a order=()
    local -A texts=()
    report_box_lines=()
    for severity in FAIL WARN; do
        marker='!'
        [[ "$severity" != FAIL ]] || marker='✗'
        order=()
        texts=()
        for note in "${report_notes[@]}"; do
            IFS=$'\t' read -r level text hint <<<"$note" || true
            [[ "$level" == "$severity" ]] || continue
            key="k:$hint"
            if [[ -z "${texts[$key]+set}" ]]; then
                order+=("$key")
                texts[$key]=''
            fi
            texts[$key]+="$text"$'\n'
        done
        for key in "${order[@]}"; do
            group_shown=false
            while IFS= read -r text; do
                [[ -n "$text" ]] || continue
                if (( shown < 12 )); then
                    report_box_lines+=("$marker $text")
                    shown=$((shown + 1))
                    group_shown=true
                else
                    hidden=$((hidden + 1))
                fi
            done <<<"${texts[$key]}"
            hint="${key#k:}"
            if [[ "$group_shown" == true && -n "$hint" ]]; then
                report_box_lines+=("  → $hint")
            fi
        done
    done
    if (( hidden > 0 )); then
        report_box_lines+=("… и ещё замечаний: $hidden, они отмечены в строках выше")
    fi
}
# <<< kalimera-report
{% endraw %}

# check - проверка, без которой каскад не работает или открыта граница
# безопасности: её провал даёт красную рамку FAIL. check_minor - замечание:
# трафик идёт, но нарушена гигиена (журналы, Fail2Ban, таймеры, срок
# сертификата, синтаксис конфигурации работающей службы) - жёлтая рамка WARN.
# Обе печатают FAIL и обе проваливают --strict: deploy по-прежнему требует
# всех проверок. Код --strict: 1 - есть критичные ошибки, 3 - только
# замечания; так server-audit отличает одно от другого.
check() { run_check FAIL "$@"; }
check_minor() { run_check WARN "$@"; }

run_check() {
    local severity="$1" label="$2"
    shift 2
    if "$@" >/dev/null 2>&1; then
        check_passed "$label"
    else
        check_failed "$severity" "$label" "$(health_hint "$label" "$@")"
    fi
}

check_passed() {
    report_line OK "$1"
    passed=$((passed + 1))
}

# $1 - FAIL или WARN, $2 - проверка, $3 - рекомендация, $4 - подробности.
check_failed() {
    report_line FAIL "$2${4:+ $4}"
    failures=$((failures + 1))
    [[ "$1" != FAIL ]] || critical=$((critical + 1))
    report_note "$1" "$2" "$3"
}

# $4 - FAIL (по умолчанию) или WARN.
check_value() {
    local label="$1" actual="$2" expected="$3" severity="${4:-FAIL}"
    if [[ "$actual" == "$expected" ]]; then
        check_passed "$label"
    else
        check_failed "$severity" "$label" "$(health_hint "$label")" \
            "(ожидалось $expected, получено $actual)"
    fi
}

# Рекомендация для непройденной проверки: по смыслу проверки, затем по
# команде (служба или таймер systemd), иначе общая. Команды kalimera
# запускаются без sudo; kalimera-deploy - на ENTRY, он настраивает весь
# каскад.
health_hint() {
    local label="$1" hint='' unit
    shift
    case "$label" in
        'запуск от root')
            hint='запускайте от пользователя kalimera без sudo: awg-health --strict' ;;
        'Ubuntu 24.04')
            hint='поддерживается только Ubuntu 24.04; не обновляйте выпуск системы (do-release-upgrade)' ;;
        'модуль AmneziaWG')
            hint='модуль не собран под текущее ядро: sudo /usr/local/sbin/awg-kernel-guard, затем sudo reboot' ;;
        *'завершилась с ошибкой'*)
            hint='служба видна в sudo systemctl --failed; причина: sudo journalctl -u ИМЯ -b --no-pager; затем на ENTRY: kalimera-deploy --resume' ;;
        *networkd*)
            hint='на ENTRY: kalimera-deploy --resume (вернёт защиту правил маршрутизации)' ;;
        *'только в RAM'*|*'журналирование UFW'*|*rsyslog*|*coredump*|*'не журналир'*|*'не сохраняет журналы'*)
            hint='на ENTRY: kalimera-deploy --resume восстановит политику без журналов' ;;
        *'mark 0x2'*|*'таблице 200'*|*'российский TUN'*|*'российского DoH'*|*'RU UDP'*|*'российский UDP'*|*'force_ru UDP'*|*'российского прокси'*|*sing-box*|*SOAX*)
            hint='ru-proxy status; если SOCKS5 недоступен - ru-proxy-set (новые данные) или ru-proxy off' ;;
        *'policy routing'*|*'mark 0x1'*|*'таблице 100'*|*'через EXIT'*|*'идут напрямую'*|*'цепочка маршрутизации'*|*ipset*|*'прямой'*|*'прямых'*|*'порт 25'*|*'служба маршрутизации'*|*'перенаправление DNS'*|*'принудительный DNS'*)
            hint='sudo systemctl reload {{ entry_routing_service_name | default("awg-entry-routing.service") }}; если ошибка вернётся - на ENTRY: kalimera-deploy --resume' ;;
        *handshake*)
            hint='проверьте, что второй сервер каскада включён и хостинг не блокирует его UDP-порт; затем на ENTRY: kalimera-deploy --resume' ;;
        *MTU*|*'полный профиль'*)
            hint='на ENTRY: kalimera-deploy --resume (профиль AWG и MTU задаются при установке)' ;;
        *'DNS EXIT'*)
            hint='sudo systemctl restart unbound.service; если не помогло - на ENTRY: kalimera-deploy --resume' ;;
        *DNS*|*Unbound*|*dnsmasq*|*резолвер*|*AAAA*|*'разрешение имён'*)
            hint='sudo systemctl restart unbound.service dnsmasq.service; текущие DNS-серверы: dns-status' ;;
        *Fail2Ban*)
            hint='sudo systemctl restart fail2ban.service; если не помогло - на ENTRY: kalimera-deploy --resume' ;;
        *'TLS-сертификат'*)
            hint='sudo systemctl start certbot.service; origin-домен должен указывать на FRONT, TCP/80 открыт' ;;
        *'TLS endpoint'*)
            hint='проверьте DNS-запись домена и nginx: sudo systemctl status nginx.service --no-pager' ;;
        *аплинк*)
            hint='проверьте ресурс CDN: источник - origin-домен FRONT, HTTP/2, без кеширования; см. docs/front-relay.md' ;;
        *'dest-сайт REALITY'*)
            hint='reality-dest-switch list, затем reality-dest-switch set ДОМЕН' ;;
        *'REALITY-порт ENTRY'*)
            hint='на ENTRY: awg-health --strict (служба backend FRONT и правило UFW для адреса FRONT)' ;;
        *'пороговое хранилище'*|*'systemd credentials'*)
            hint='kalimera-secretctl status; если хранилище закрыто - на ENTRY: kalimera-deploy --resume' ;;
        *VLESS*)
            hint='vless-user list; при расхождении - на ENTRY: kalimera-deploy --resume' ;;
        *синтаксис*)
            hint='служба работает на прежней конфигурации, но после перезапуска не стартует; на ENTRY: kalimera-deploy --resume' ;;
        *UFW*|*изолирован*|*изоляция*|*NAT*|*MSS*)
            hint='на ENTRY: kalimera-deploy --resume восстановит правила UFW и iptables' ;;
    esac
    if [[ -z "$hint" && "${1:-}" == systemctl && "${2:-}" == is-active ]]; then
        unit="${*: -1}"
        if [[ "$unit" == *.timer ]]; then
            hint="sudo systemctl enable --now $unit"
        else
            hint="причина: sudo systemctl status $unit --no-pager -l; после исправления: sudo systemctl restart $unit"
        fi
    fi
    printf '%s\n' "${hint:-на ENTRY: kalimera-deploy --resume; если ошибка повторяется - сообщите вывод awg-health --strict}"
}

# Итог: рамка в терминале, прежняя строка GOOD/BAD в остальных случаях.
health_finish() {
    local title={{ ('awg-health ' ~ (awg_node_role | default(''))) | quote }}
    if [[ "$report_fancy" == true ]]; then
        report_note_lines
        if (( failures == 0 )); then
            report_box OK "$title: все проверки пройдены ($passed)"
        elif (( critical == 0 )); then
            report_box WARN "$title: каскад работает, замечаний: $failures" \
                "${report_box_lines[@]}"
        else
            report_box FAIL "$title: работа каскада нарушена, критичных ошибок: $critical из $failures" \
                "${report_box_lines[@]}"
        fi
    elif (( failures == 0 )); then
        printf 'GOOD: все проверки пройдены\n'
    else
        printf 'BAD: ошибок проверки: %d\n' "$failures"
    fi
    (( failures > 0 )) || exit 0
    [[ "$strict" == true ]] || exit 0
    (( critical == 0 )) || exit 1
    exit 3
}

has_rule() {
    local mark="$1" table="$2" priority="$3"
    ip -4 rule show | grep -Eq "^${priority}:.*fwmark ${mark}.*lookup ${table}"
}

rule_absent() {
    ! has_rule "$@"
}

service_inactive() {
    ! systemctl is-active --quiet "$1"
}

systemd_config_last_value() {
    local config="$1" key="$2"
    systemd-analyze cat-config "$config" |
        awk -F= -v wanted="$key" '
            {
                name = $1
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", name)
                if (name == wanted) {
                    value = substr($0, index($0, "=") + 1)
                    gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
                    last = value
                }
            }
            END { if (last != "") print last }
        '
}

journald_is_volatile() {
    [[ "$(systemd_config_last_value systemd/journald.conf Storage)" == volatile ]] &&
        [[ "$(systemd_config_last_value systemd/journald.conf ForwardToSyslog)" == no ]]
}

rsyslog_is_disabled() {
    local enabled
    ! systemctl is-active --quiet rsyslog.service &&
        enabled="$(systemctl is-enabled rsyslog.service 2>/dev/null || true)" &&
        [[ "$enabled" == masked || "$enabled" == not-found ]]
}

coredump_storage_is_disabled() {
    [[ "$(systemd_config_last_value systemd/coredump.conf Storage)" == none ]] &&
        [[ "$(systemd_config_last_value systemd/coredump.conf ProcessSizeMax)" == 0 ]]
}

login_accounting_is_volatile() {
    local name
    for name in wtmp btmp lastlog faillog; do
        [[ "$(readlink -f "/var/log/$name")" == "/run/kalimerawg-accounting/$name" ]] ||
            return 1
    done
}

fail2ban_state_is_volatile() {
    grep -Eq '^[[:space:]]*logtarget[[:space:]]*=[[:space:]]*SYSTEMD-JOURNAL[[:space:]]*$' \
        /etc/fail2ban/fail2ban.local &&
        grep -Eq '^[[:space:]]*dbfile[[:space:]]*=[[:space:]]*:memory:[[:space:]]*$' \
            /etc/fail2ban/fail2ban.local
}


fail2ban_sshd_policy_is_strict() {
    local jail=/etc/fail2ban/jail.d/zz-awg-sshd.local
    fail2ban-client -t >/dev/null 2>&1 &&
        fail2ban-client status sshd >/dev/null 2>&1 &&
        [[ "$(fail2ban-client get sshd maxretry 2>/dev/null)" == "{{ fail2ban_sshd.maxretry | int }}" ]] &&
        grep -Eq '^[[:space:]]*mode[[:space:]]*=[[:space:]]*aggressive[[:space:]]*$' "$jail" &&
        grep -Eq '^[[:space:]]*backend[[:space:]]*=[[:space:]]*systemd[[:space:]]*$' "$jail" &&
        grep -Eq '^[[:space:]]*banaction[[:space:]]*=[[:space:]]*ufw[[:space:]]*$' "$jail" &&
        grep -Eq '^[[:space:]]*usedns[[:space:]]*=[[:space:]]*no[[:space:]]*$' "$jail" &&
        grep -Fqx {{ ('ignoreip = 127.0.0.1/8 ::1 ' ~ security_automation_source_ipv4) | quote }} "$jail"
}

ufw_logging_is_disabled() {
    ufw status verbose | grep -Eq '^Logging:[[:space:]]+off'
}

{% if awg_node_role | default('') in ['entry', 'exit', 'front'] and security_manage_admin_account | default(false) | bool %}
managed_admin_is_ready() {
    id {{ security_admin_user | quote }} >/dev/null 2>&1 &&
        id -nG {{ security_admin_user | quote }} | tr ' ' '\n' | grep -Fxq sudo &&
        passwd -S {{ security_admin_user | quote }} | grep -Eq '^[^ ]+[[:space:]]+P[[:space:]]' &&
        passwd -S root | grep -Eq '^root[[:space:]]+P[[:space:]]' &&
        test -s {{ ('/home/' ~ security_admin_user ~ '/.ssh/authorized_keys') | quote }} &&
        test -x {{ security_admin_command_path | default('/usr/local/libexec/kalimera-admin-command') | quote }} &&
        visudo -cf /etc/sudoers.d/90-kalimera-admin >/dev/null 2>&1 &&
        ! grep -Eq 'NOPASSWD:[[:space:]]+ALL([[:space:]]|$)' /etc/sudoers.d/90-kalimera-admin
}
{% endif %}

{% if runtime_secrets_enabled | default(false) | bool %}
runtime_secrets_are_healthy() {
    systemctl is-enabled --quiet {{ runtime_secrets_service_name | quote }} &&
        systemctl is-active --quiet {{ runtime_secrets_service_name | quote }} &&
        {{ runtime_secrets_ctl_path | quote }} verify >/dev/null 2>&1
}

runtime_secret_dependencies_are_loaded() {
{% if awg_node_role == 'front' %}
    systemctl cat {{ front_xray_service_name | default('xray.service') | quote }} |
        grep -Fq 'LoadCredential=config.json:' &&
        systemctl cat nginx.service |
            grep -Fq 'Requires={{ runtime_secrets_service_name }}' &&
        systemctl cat certbot.service |
            grep -Fq 'Requires={{ runtime_secrets_service_name }}'
{% elif awg_node_role == 'entry' and front_backend_enabled | default(false) | bool %}
    systemctl cat awg-quick@.service | grep -Fq 'LoadCredential=%i.conf:' &&
{% if awg3_transit_enabled | default(false) | bool %}
        systemctl cat {{ awg3_transit_service_name | default('awg3-transit.service') | quote }} |
            grep -Fq 'LoadCredential=awg3.conf:' &&
{% endif %}
        systemctl cat {{ front_backend_service_name | default('kalimera-front-backend.service') | quote }} |
            grep -Fq 'LoadCredential=front-backend.json:'
{#
   Юнита awg3-transit.service на чистом kernel-каскаде нет: роль awg3_transit
   ставит его только для userspace-движка. На существующих каскадах файл
   остался с прежнего движка, поэтому проверка без этого условия проходила на
   них и падала только на чистой установке.
#}
{% elif awg3_transit_enabled | default(false) | bool %}
    systemctl cat awg-quick@.service | grep -Fq 'LoadCredential=%i.conf:' &&
        systemctl cat {{ awg3_transit_service_name | default('awg3-transit.service') | quote }} |
            grep -Fq 'LoadCredential=awg3.conf:'
{% else %}
    systemctl cat awg-quick@.service | grep -Fq 'LoadCredential=%i.conf:'
{% endif %}
}
{% endif %}

{% if awg_node_role == 'entry' and entry_mobile_client_available | default(false) | bool %}
{#
   ContentPaddingAddition со значением 0 showconf не печатает, поэтому поле
   требуется только при включённой рандомизации. Булевы RandomTrailers и
   DisableCookies печатаются и в значении off: DisableCookies = off проходил
   эту проверку на живом kernel-интерфейсе mobile.
#}
{% set mobile_profile_fields = [
       'HeaderProtectionKey', 'RekeyAfterTime', 'RekeyTimeout',
       'RejectAfterTime', 'KeepaliveTimeout', 'MaxHandshakeAttempts',
       'RandomTrailers', 'DisableCookies', 'I1', 'I2', 'I3', 'I4', 'I5'] %}
{% if (awg3_mobile_content_padding_addition | default('0') | string) not in ['0', '0-0'] %}
{% set mobile_profile_fields = ['ContentPaddingAddition'] + mobile_profile_fields %}
{% endif %}
mobile_awg31_profile_is_complete() {
    local config
    config="$({{ awg3_mobile_tools_binary_path | quote }} showconf {{ entry_mobile_client_interface | quote }} 2>/dev/null)" || return 1
    for field in {{ mobile_profile_fields | join(' ') }}; do
        grep -Eq "^${field}[[:space:]]*=[[:space:]]*[^[:space:]].*$" <<<"$config" || return 1
    done
}
{% endif %}

{#
   Проверка полноты профиля нужна в обоих режимах движка. Раньше она
   определялась только при включённом userspace, и после перевода канала на
   kernel-модуль молча переставала существовать - вместе с проверкой MTU это
   оставляло без контроля ровно то, что переезд и менял.

   Наборы полей различаются намеренно. У userspace проверяется весь набор -
   он давно подтверждён на реальном showconf. В kernel-режиме из списка
   исключены ContentPaddingAddition, RandomTrailers и DisableCookies: на
   межсерверном канале они намеренно стоят в 0/off, а печатает ли kernel
   showconf поля с нулевыми значениями, на живом канале пока не подтверждено.
   Требовать их присутствия означало бы рисковать ложным FAIL на исправном
   каскаде, а различающую силу они всё равно не несут - её дают
   HeaderProtectionKey и I1-I5, которые никогда не совпадают с умолчанием.
#}
{% if awg3_transit_enabled | default(false) | bool %}
{% set awg3_profile_tool = awg3_tools_binary_path %}
{% set awg3_profile_fields = [
       'HeaderProtectionKey', 'ContentPaddingAddition', 'RekeyAfterTime',
       'RekeyTimeout', 'RejectAfterTime', 'KeepaliveTimeout',
       'MaxHandshakeAttempts', 'RandomTrailers', 'DisableCookies',
       'I1', 'I2', 'I3', 'I4', 'I5'] %}
{% else %}
{% set awg3_profile_tool = 'awg' %}
{% set awg3_profile_fields = [
       'HeaderProtectionKey', 'RekeyAfterTime', 'RekeyTimeout',
       'RejectAfterTime', 'KeepaliveTimeout', 'MaxHandshakeAttempts',
       'I1', 'I2', 'I3', 'I4', 'I5'] %}
{% endif %}
awg3_transit_profile_is_complete() {
    local interface="$1" config
    config="$({{ awg3_profile_tool | quote }} showconf "$interface" 2>/dev/null)" || return 1
    for field in {{ awg3_profile_fields | join(' ') }}; do
        grep -Eq "^${field}[[:space:]]*=[[:space:]]*[^[:space:]].*$" <<<"$config" || return 1
    done
}

{% if awg_node_role == 'entry' %}
dns_no_logs_policy_is_active() {
    grep -Fxq 'cache-size=0' /etc/dnsmasq.d/50-awg-base.conf &&
        ! grep -Eq '^[[:space:]]*log-queries([=[:space:]]|$)' \
            /etc/dnsmasq.d/50-awg-base.conf &&
        grep -Fxq 'Cache=no' {{ entry_dns_resolved_dropin_path | quote }} &&
        grep -Eq '^[[:space:]]*log-queries:[[:space:]]*no[[:space:]]*$' \
            /etc/unbound/unbound.conf.d/90-awg-dot.conf &&
        grep -Eq '^[[:space:]]*log-replies:[[:space:]]*no[[:space:]]*$' \
            /etc/unbound/unbound.conf.d/90-awg-dot.conf
}

sing_box_no_logs_policy_is_active() {
    [[ ! -e /etc/sing-box/config.json ]] ||
        jq -e '.log.disabled == true and .dns.disable_cache == true' \
            /etc/sing-box/config.json >/dev/null
}
