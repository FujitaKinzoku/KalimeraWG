handshake_recent() {
    local interface="$1" max_age="$2" tool="${3:-awg}" latest now
    latest="$("$tool" show "$interface" latest-handshakes |
        awk '{print $2}' | sort -nr | head -n 1)"
    now="$(date +%s)"
    [[ "$latest" =~ ^[0-9]+$ ]] &&
        (( latest > 0 && now >= latest && now - latest <= max_age ))
}

has_default_route() {
    local table="$1" interface="$2"
    ip -4 route show table "$table" | grep -Eq "^default .*dev ${interface}( |$)"
}

ufw_active() {
    ufw status | grep -Eq '^Status: active$'
}

{% if awg_node_role | default('') in ['entry', 'exit', 'front'] %}
ufw_matches_managed_snapshot() {
    local marker={{ security_ufw_policy_marker | quote }} expected actual status
    [[ -r "$marker" ]] || return 1
    expected="$(cut -d '|' -f 2 "$marker")"
    # Fail2Ban закономерно добавляет и удаляет временные REJECT-правила. Они
    # имеют собственный комментарий и не являются изменением постоянной
    # управляемой политики KalimeraWG. Все остальные правила остаются частью
    # контролируемого отпечатка.
    status="$(
        LC_ALL=C ufw status |
            sed -E \
                '/#[[:space:]]+by Fail2Ban after [0-9]+ attempts against sshd[[:space:]]*$/d'
    )"
    actual="$(printf '%s' "$status" | sha256sum | awk '{print $1}')"
    [[ -n "$expected" && "$actual" == "$expected" ]]
}
{% endif %}

interface_mtu_is() {
    local interface="$1" expected="$2" actual
    actual="$(ip -o link show dev "$interface" | sed -n 's/.* mtu \([0-9][0-9]*\).*/\1/p')"
    [[ "$actual" == "$expected" ]]
}

aaaa_filtered() {
    [[ -z "$(dig +short +time=3 +tries=1 @{{ entry_client_listen_address | default('127.0.0.1') }} example.com AAAA)" ]]
}

# dig возвращает 0 и при SERVFAIL, а при таймауте пишет ошибку в stdout,
# поэтому успехом считается только полученный IPv4-адрес.
dns_resolves_a() {
    local answer
    answer="$(dig +short +time=5 +tries=1 "@$1" "$2" A 2>/dev/null)" || return 1
    grep -Eq '^[0-9]+(\.[0-9]+){3}$' <<<"$answer"
}

ufw_interserver_restricted() {
    local interface="$1" peer="$2" port="$3" proto="${4:-udp}"
    iptables -w 10 -C ufw-user-input -i "$interface" -p "$proto" \
        -s "${peer}/32" --dport "$port" -j ACCEPT
}

ufw_interserver_has_no_broad_allow() {
    local interface="$1" peer="$2" port="$3" proto="${4:-udp}" rule
    while IFS= read -r rule; do
        [[ "$rule" == *"-s ${peer}/32"* ]] || return 1
    done < <(
        iptables -w 10 -S ufw-user-input |
            grep -F -- "-i ${interface}" |
            grep -F -- "-p ${proto}" |
            grep -F -- "--dport ${port}" |
            grep -F -- '-j ACCEPT' || true
    )
}

ufw_client_destination_denied() {
    local interface="$1" source="$2" destination="$3"
    iptables -w 10 -C ufw-user-forward -i "$interface" \
        -s "$source" -d "$destination" -j DROP
}

ufw_client_zones_isolated() {
    ufw_client_destination_denied "$1" "$2" "$3" &&
        ufw_client_destination_denied "$4" "$5" "$6"
}

route_uses_interface() {
    local destination="$1" mark="$2" interface="$3"
    ip -4 route get "$destination" mark "$mark" | grep -Eq " dev ${interface}( |$)"
}

mail_port_25_absent() {
    ! ipset test ru_direct_tcp_ports 25 >/dev/null 2>&1
}

direct_bypass_absent() {
    [[ "$(ipset list ru_direct_tcp_ports 2>/dev/null | sed -n 's/^Number of entries: //p')" == 0 ]]
}

direct_port_bypasses_proxy() {
    local set_name="$1" port="$2"
    ipset test ru_direct_tcp_ports "$port" >/dev/null 2>&1 &&
    iptables -w 10 -t mangle -C AWG_RU_PROXY -p tcp \
        -m set --match-set "$set_name" dst \
        -m set --match-set ru_direct_tcp_ports dst -j RETURN
}

udp_ru_bypasses_proxy() {
    local set_name="$1"
    iptables -w 10 -t mangle -C AWG_RU_PROXY -p udp \
        -m set --match-set "$set_name" dst -j RETURN
}

udp_ru_bypass_absent() {
    ! iptables -w 10 -t mangle -S AWG_RU_PROXY |
        grep -Eq -- '-p udp .*--match-set (force_ru|ru) dst .* -j RETURN'
}

{% if reality_fallback_enabled | default(false) | bool %}
tcp_port_listening() {
    local port="$1"
    ss -H -ltn "( sport = :${port} )" | grep -q .
}

reality_dest_tls13() {
    local host="$1" port="$2"
    # "Protocol  : TLSv1.3" эхом повторяет запрошенную версию даже при
    # провале хендшейка - надёжен только "New, TLSv1.3, Cipher is TLS_...".
    timeout 10 openssl s_client -connect "${host}:${port}" -servername "$host" -tls1_3 </dev/null 2>/dev/null |
        grep -Eq 'New,[[:space:]]*TLSv1\.3,[[:space:]]*Cipher is[[:space:]]*TLS_'
}

reality_ru_failover_synced() {
    local config="$1" disabled_flag="$2" manual_flag="$3" expected current
    expected=ru-socks
    # Ручное отключение прокси оператором ставит собственный флаг, отличный от
    # watchdog-флага; учитывать нужно оба, иначе REALITY продолжит слать
    # RU-ветку в отключённый SOAX, пока ядро уже ходит напрямую.
    { [[ -e "$disabled_flag" ]] || [[ -e "$manual_flag" ]]; } && expected=direct-entry
    # Именно правило по российским подсетям, а не «первое правило с rule_set»:
    # выше него стоит правило se-domain, ведущее в direct-exit, и по позиции
    # проверка брала бы его.
    current="$(jq -r '
        [.route.rules[] | select((.rule_set? // []) | index("reality-ru-zone"))][0].outbound // empty
    ' "$config")"
    [[ "$current" == "$expected" ]]
}
{% endif %}

