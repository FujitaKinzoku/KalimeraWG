#!/usr/bin/env bash
set -Eeuo pipefail

readonly PRIMARY_URL={{ entry_ru_zone_primary_url | quote }}
readonly FALLBACK_URL={{ entry_ru_zone_fallback_url | quote }}
readonly CACHE={{ entry_ru_zone_cache_path | quote }}
readonly MIN_NETWORKS={{ entry_ru_zone_min_networks }}
readonly RU_SET=ru
readonly TMP_SET=ru_tmp

tmp="$(mktemp /run/awg-ru-zone.XXXXXX)"
trap 'rm -f -- "$tmp"' EXIT

fetch() {
    curl --fail --silent --show-error --location \
        --retry 2 --retry-delay 2 --connect-timeout 10 --max-time 60 \
        --output "$tmp" "$1"
}

if ! fetch "$PRIMARY_URL" && ! fetch "$FALLBACK_URL"; then
    if [[ -s "$CACHE" ]]; then
        cp -- "$CACHE" "$tmp"
    else
        echo "Нет доступного источника российских сетей или последней корректной кэшированной копии" >&2
        exit 1
    fi
fi

valid_count="$({
    sed -E 's/[[:space:]]*#.*$//; /^[[:space:]]*$/d' "$tmp" |
        grep -Ec '^([0-9]{1,3}\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$'
} || true)"

if (( valid_count < MIN_NETWORKS )); then
    echo "Проверка списка российских сетей не пройдена: записей — ${valid_count}" >&2
    exit 1
fi

ipset create "$RU_SET" hash:net family inet maxelem 65536 -exist
ipset create "$TMP_SET" hash:net family inet maxelem 65536 -exist
ipset flush "$TMP_SET"

while IFS= read -r net; do
    [[ "$net" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$ ]] || continue
    ipset add "$TMP_SET" "$net" -exist
done < <(sed -E 's/[[:space:]]*#.*$//; /^[[:space:]]*$/d' "$tmp")

ipset swap "$TMP_SET" "$RU_SET"
ipset flush "$TMP_SET"
install -o root -g root -m 0644 "$tmp" "$CACHE"
