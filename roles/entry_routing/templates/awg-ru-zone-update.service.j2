[Unit]
Description=Атомарное обновление ipset RU-сетей
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart={{ entry_ru_zone_update_script_path }}
User=root
Group=root
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths={{ entry_ru_zone_state_dir }} /run {{ (reality_fallback_rule_set_dir | default('/etc/sing-box/reality/rules')) if (reality_fallback_enabled | default(false) | bool) else '' }}
ProtectClock=true
ProtectControlGroups=true
ProtectKernelModules=true
RestrictRealtime=true
SystemCallArchitectures=native
