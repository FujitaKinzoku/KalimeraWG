#!/usr/bin/env python3
from __future__ import annotations

import argparse
import copy
import fcntl
import json
import os
import pwd
import re
import subprocess
import sys
import tempfile
import uuid
from pathlib import Path

BASE_CONFIG = Path({{ front_xray_base_config_path | to_json }})
ACTIVE_CONFIG = Path({{ front_xray_config_path | to_json }})
USERS_FILE = Path({{ front_vless_users_path | to_json }})
SETTINGS_FILE = Path({{ front_vless_client_settings_path | to_json }})
EXPORT_DIR = Path({{ front_vless_export_dir | to_json }})
XRAY = {{ front_xray_binary_path | to_json }}
SERVICE = {{ front_xray_service_name | to_json }}
SYSTEMCTL = {{ front_systemctl_path | to_json }}
SECRETCTL = {{ runtime_secrets_ctl_path | default('/usr/local/sbin/kalimera-secretctl') | to_json }}
INTEGRITY = "/usr/local/sbin/awg-managed-integrity"
XRAY_USER = {{ front_xray_user | to_json }}
XRAY_GROUP = {{ front_xray_group | to_json }}
ADMIN_USER = {{ security_admin_user | default('kalimera') | to_json }}
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$")


def fail(message: str, code: int = 1) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(code)


def load_json(path: Path) -> dict:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as error:
        fail(f"Не удалось прочитать {path.name}: {type(error).__name__}")
    if not isinstance(value, dict):
        fail(f"Файл {path.name} должен содержать JSON-объект")
    return value


def atomic_write(path: Path, data: bytes, mode: int, owner: tuple[int, int]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "wb") as output:
            output.write(data)
            output.flush()
            os.fsync(output.fileno())
        os.chmod(temporary, mode)
        os.chown(temporary, owner[0], owner[1])
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def validate_state(state: dict, settings: dict) -> list[dict]:
    if state.get("schema") != 1 or not isinstance(state.get("users"), list):
        fail("Неподдерживаемая схема реестра VLESS-пользователей")
    modes = settings.get("access_modes")
    if not isinstance(modes, list) or not modes or set(modes) - {"direct", "cdn"}:
        fail("Некорректный список режимов FRONT")
    seen_names: set[str] = set()
    seen_ids: set[str] = set()
    users: list[dict] = []
    for record in state["users"]:
        if not isinstance(record, dict):
            fail("Повреждён реестр VLESS-пользователей")
        name = record.get("name")
        identifier = record.get("id")
        mode = record.get("mode")
        if not isinstance(name, str) or not NAME_RE.fullmatch(name):
            fail("Некорректное имя в реестре VLESS-пользователей")
        try:
            normalized_id = str(uuid.UUID(str(identifier)))
        except ValueError:
            fail(f"Некорректный UUID пользователя {name}")
        if mode not in modes:
            fail(f"Режим пользователя {name} не включён на FRONT")
        if name in seen_names or normalized_id in seen_ids:
            fail("В реестре VLESS-пользователей обнаружен дубликат")
        seen_names.add(name)
        seen_ids.add(normalized_id)
        users.append({"name": name, "id": normalized_id, "mode": mode})
    if not users:
        fail("Xray FRONT не может работать без VLESS-пользователей")
    return users


def render_active_config(users: list[dict]) -> bytes:
    config = copy.deepcopy(load_json(BASE_CONFIG))
    inbounds = config.get("inbounds")
    if not isinstance(inbounds, list) or len(inbounds) != 1:
        fail("Базовая конфигурация Xray содержит неожиданные inbound")
    settings = inbounds[0].get("settings")
    if not isinstance(settings, dict):
        fail("В базовой конфигурации Xray отсутствует settings")
    settings["clients"] = [{"id": record["id"]} for record in users]
    return (json.dumps(config, ensure_ascii=False, indent=2) + "\n").encode("utf-8")


def sync_config(users: list[dict]) -> bool:
    rendered = render_active_config(users)
    current = ACTIVE_CONFIG.read_bytes() if ACTIVE_CONFIG.is_file() else b""
    if current == rendered:
        return False
    account = pwd.getpwnam(XRAY_USER)
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{ACTIVE_CONFIG.stem}.candidate.",
        suffix=".json",
        dir=ACTIVE_CONFIG.parent,
    )
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "wb") as output:
            output.write(rendered)
            output.flush()
            os.fsync(output.fileno())
        os.chmod(temporary, 0o640)
        os.chown(temporary, 0, account.pw_gid)
        validation = subprocess.run(
            [XRAY, "run", "-test", "-c", str(temporary)],
            text=True,
            capture_output=True,
            check=False,
        )
        if validation.returncode != 0:
            fail("Кандидат конфигурации отклонён Xray")
        os.replace(temporary, ACTIVE_CONFIG)
    finally:
        temporary.unlink(missing_ok=True)
    return True


def save_state(state: dict) -> None:
    payload = (json.dumps(state, ensure_ascii=False, indent=2) + "\n").encode("utf-8")
    atomic_write(USERS_FILE, payload, 0o600, (0, 0))


def seal_runtime() -> None:
    if os.path.isfile(SECRETCTL) and os.access(SECRETCTL, os.X_OK):
        subprocess.run([SECRETCTL, "seal"], check=True, stdout=subprocess.DEVNULL)


def seal_integrity() -> None:
    if os.path.isfile(INTEGRITY) and os.access(INTEGRITY, os.X_OK):
        subprocess.run([INTEGRITY, "seal"], check=True, stdout=subprocess.DEVNULL)


def persist_protected_state() -> None:
    seal_runtime()
    seal_integrity()


def restart_xray() -> None:
    subprocess.run([SYSTEMCTL, "restart", SERVICE], check=True)


def uplink_sends_get_body(xhttp: dict) -> bool:
    """Отправит ли клиент Xray пакеты аплинка GET-запросом с телом.

    При наличии extra Xray-core берёт из xhttpSettings снаружи только host,
    path и mode (infra/conf/transport_method.go, SplitHTTPConfig.Build), а
    uplinkDataPlacement body и auto (как и отсутствие поля) клиент кладёт в
    тело запроса (transport/internet/splithttp/config.go, FillPacketRequest).
    """
    extra = xhttp.get("extra")
    effective = extra if isinstance(extra, dict) else xhttp
    method = str(effective.get("uplinkHTTPMethod") or "POST").upper()
    placement = effective.get("uplinkDataPlacement") or "auto"
    return method == "GET" and placement in ("body", "auto")


def proxy_outbound(record: dict, settings: dict, mode: str, tag: str) -> dict:
    """VLESS-outbound этого FRONT для режима mode (direct или cdn)."""
    domains = settings.get("domains", {})
    domain = domains.get(mode) if isinstance(domains, dict) else None
    if not isinstance(domain, str) or not domain:
        fail(f"Для режима {mode} не задан клиентский домен")
    xhttp = settings.get("xhttp")
    if not isinstance(xhttp, dict):
        fail("Параметры XHTTP отсутствуют")
    # Yandex Cloud CDN отвечает 413 на любой GET с телом, и такой профиль не
    # пропустил бы через CDN ни одного пакета аплинка. Прямой путь через
    # nginx FRONT тело в GET принимает, поэтому запрет только для CDN.
    if mode == "cdn" and uplink_sends_get_body(xhttp):
        fail(
            "Параметры экспорта устарели: CDN-профиль отправлял бы аплинк телом "
            "GET-запроса, а CDN отвечает на такой запрос 413. Обновите FRONT "
            "(kalimera-deploy --resume) и повторите экспорт."
        )
    encryption = settings.get("encryption", "none")
    xhttp_settings = copy.deepcopy(xhttp)
    xhttp_settings["host"] = domain
    return {
        "tag": tag,
        "protocol": "vless",
        "settings": {
            "vnext": [
                {
                    "address": domain,
                    "port": 443,
                    "users": [
                        {
                            "id": record["id"],
                            "encryption": encryption,
                            "flow": "",
                        }
                    ],
                }
            ]
        },
        "streamSettings": {
            "network": "xhttp",
            "security": "tls",
            "tlsSettings": {
                "alpn": ["h2", "http/1.1"],
                "fingerprint": "firefox",
                "serverName": domain,
            },
            "xhttpSettings": xhttp_settings,
        },
    }


def base_profile(settings: dict) -> dict:
    """Общая часть клиентского профиля: DNS, локальные inbound и журнал."""
    dns = settings.get("dns")
    if not isinstance(dns, dict):
        fail("Параметры DNS клиентского профиля отсутствуют")
    return {
        "dns": copy.deepcopy(dns),
        "inbounds": [
            {
                "listen": "127.0.0.1",
                "port": 10808,
                "protocol": "socks",
                "settings": {"auth": "noauth", "udp": True},
                "sniffing": {
                    "destOverride": ["http", "tls", "quic"],
                    "enabled": True,
                },
                "tag": "socks-in",
            },
            {
                "listen": "127.0.0.1",
                "port": 10809,
                "protocol": "http",
                "sniffing": {
                    "destOverride": ["http", "tls", "quic"],
                    "enabled": True,
                },
                "tag": "http-in",
            },
        ],
        # HAPP подставляет собственный локальный путь access.log после импорта.
        # Жёстко заданный iOS AppGroup здесь сделал бы JSON непереносимым.
        "log": {"dnsLog": True, "loglevel": "Warning"},
        "stats": {},
    }


def client_config(record: dict, settings: dict) -> dict:
    profile = base_profile(settings)
    profile["outbounds"] = [
        proxy_outbound(record, settings, record["mode"], "proxy"),
        {"protocol": "freedom", "tag": "direct"},
        {"protocol": "blackhole", "tag": "block"},
    ]
    # V3: аплинк GET без тела, нагрузка в заголовках. Новое имя профиля
    # позволяет в клиенте отличить перевыпущенный JSON от старого V2,
    # который через CDN больше не работает.
    profile["remarks"] = "Kalimera-FRONT-disguiseV3"
    profile["routing"] = {
        "domainStrategy": "AsIs",
        "rules": [
            {
                "network": "tcp,udp",
                "outboundTag": "proxy",
                "type": "field",
            }
        ],
    }
    return profile


# Профиль с резервом: до шести независимых каскадов. Основной - CDN этого
# FRONT (прямой путь только у FRONT без CDN), резервные - экспорты других
# каскадов в порядке очереди. Поведение выбрано по исходникам Xray-core
# (app/router/strategy_leastload.go, app/observatory/burst) и проверено
# живым тестом переключения на настоящем Xray:
#
# * Резерв стоит внутри балансировщика с огромной ценой, а не в fallbackTag:
#   пока наблюдатель ещё не получил ни одного результата (первые доли
#   секунды после запуска), leastLoad не видит узлов и отдаёт fallbackTag.
#   С резервом в fallbackTag каждый запуск начинался бы через резервный
#   каскад с другим внешним IP. Поэтому fallbackTag - основной путь.
# * leastLoad сортирует по разбросу RTT, умноженному на корень из цены.
#   Цена первого резерва 1e8 (множитель 10 000): резерв выбирается, только
#   когда основной путь исключён, - разброс живого пути меньше таймаута 5 с.
#   Следующие резервы (до пяти, всего шесть каскадов) получают множители,
#   растущие с равным шагом до 3e9. Больше нельзя: разброс живого пути
#   доходит до 2,5 с (2,5e9 нс), а Xray переводит произведение в
#   time.Duration (int64, до 9,2e18). При переполнении на amd64 получается
#   отрицательное число, и последний резерв встал бы впереди основного.
#   Шаг между резервами тем меньше, чем их больше (2 резерва - 300 000,
#   5 резервов - 23), поэтому при многих резервах порядок между ними мягче:
#   резерв с разбросом в 23 раза больше следующего уступит ему очередь.
#   Цены задаются регулярными выражениями с якорями: без них совпадение по
#   подстроке отдало бы kalimera-reserve-1 цену kalimera-reserve-10.
# * Узел исключается, когда провалились 2 из 3 последних проверок
#   (интервал 10 с - минимум Xray; проверки идут в случайные моменты
#   раунда), и возвращается, когда провалов снова не больше одного.
#   Одиночный провал переключения не вызывает. maxRTT не задан: на
#   медленной мобильной сети он увёл бы трафик в резерв с другим IP без
#   настоящего отказа; путь, который не отвечает за 5 с, и так провал.
#   Быстрее без ложных переключений нельзя: Xray проверяет путь не чаще
#   раза в 10 с, и скорость определяется только числом провалов. Модель
#   алгоритма (Монте-Карло по healthping.go): 3 проверки - переключение в
#   среднем через 15 с (9 из 10 - до 27 с), обрыв на 10 с уводит в резерв в
#   26% случаев; 4 проверки - 26 с и 6%. Выбраны 3 проверки (решение
#   владельца: быстрее переключение ценой редких лишних переходов).
# * connectivity не задан. С ним Xray после неудачной проверки через каскад
#   проверяет сеть обычным HTTP-клиентом и не записывает провал, если сеть
#   «недоступна». На телефоне этот клиент разрешает имя через системный DNS,
#   а DNS идёт в туннель - через тот самый упавший основной каскад. Проверка
#   сети проваливается вместе с ним, провалы не записываются, и резерв
#   включается только после устаревания старых результатов (80 с).
#   Без connectivity при полном отсутствии сети
#   проваливаются оба пути, живых нет, и балансировщик отдаёт fallbackTag -
#   основной путь, так что метро и лифт в резерв не уводят.
# * Адреса обоих каскадов Xray разрешает сам (sockopt.domainStrategy) через
#   DNS по TCP напрямую (tcp+local), минуя маршрутизацию. Без этого имя
#   сервера разрешает система, а системный DNS телефона идёт в туннель, то
#   есть через балансировщик и основной каскад, и при его отказе имя
#   резервного сервера может не разрешиться.
# * Клиент должен пускать мимо туннеля соединения Xray к обоим серверам.
#   Happ для iOS с включённым No Limit Mode пропускает только основной:
#   соединения к резерву возвращались в туннель через основной каскад
#   (access.log: "tcp:<CDN резерва>:443 [socks-in -> kalimera-main]"), и
#   резерв не включался. С выключенным No Limit Mode переключение проверено
#   на iPhone с двумя настоящими каскадами.
AUTO_BALANCER_TAG = "kalimera-auto"
AUTO_MAIN_TAG = "kalimera-main"
AUTO_MAX_RESERVES = 5
AUTO_FIRST_RESERVE_FACTOR = 10_000
AUTO_FACTOR_BUDGET = 3_000_000_000
AUTO_PROBE_URL = "https://www.gstatic.com/generate_204"
AUTO_MAX_RESERVE_BYTES = 262144
AUTO_HOSTNAME = re.compile(
    r"(?=.{1,253}$)[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?"
    r"(?:\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*"
)


def reserve_tag(position: int) -> str:
    return f"kalimera-reserve-{position}"


def reserve_costs(count: int) -> list:
    """Цены резервов по порядку: каждый следующий дороже предыдущего."""
    factors = [AUTO_FIRST_RESERVE_FACTOR]
    if count > 1:
        step = int((AUTO_FACTOR_BUDGET / AUTO_FIRST_RESERVE_FACTOR) ** (1 / (count - 1)))
        for _ in range(count - 1):
            factors.append(factors[-1] * step)
    return [
        {"regexp": True, "match": f"^{reserve_tag(position)}$", "value": factor * factor}
        for position, factor in enumerate(factors, 1)
    ]


def load_reserves(sources: list, settings: dict) -> list:
    if len(sources) > AUTO_MAX_RESERVES:
        fail(
            f"Резервов не больше {AUTO_MAX_RESERVES} (всего {AUTO_MAX_RESERVES + 1} "
            "каскадов): при большем числе Xray не может гарантировать, что "
            "основной каскад останется первым.",
            2,
        )
    if sources.count("-") > 1:
        fail("Из stdin можно передать только один резерв", 2)
    reserves = [
        load_reserve_outbound(source, settings, reserve_tag(position))
        for position, source in enumerate(sources, 1)
    ]
    addresses = [item["settings"]["vnext"][0]["address"] for item in reserves]
    if len(set(addresses)) != len(addresses):
        fail("Один и тот же каскад указан резервом дважды", 2)
    return reserves


def load_reserve_outbound(source: str, settings: dict, tag: str) -> dict:
    """Основной outbound из JSON, выданного 'vless-user export' другого каскада."""
    try:
        if source == "-":
            raw = sys.stdin.buffer.read(AUTO_MAX_RESERVE_BYTES + 1)
        else:
            with open(source, "rb") as handle:
                raw = handle.read(AUTO_MAX_RESERVE_BYTES + 1)
    except OSError as error:
        fail(f"Не удалось прочитать профиль резерва: {type(error).__name__}", 2)
    if len(raw) > AUTO_MAX_RESERVE_BYTES:
        fail("Профиль резерва слишком большой для клиентского JSON", 2)
    try:
        profile = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        fail(
            "Профиль резерва - не JSON. Выполните 'vless-user export ИМЯ' на FRONT "
            "резервного каскада и передайте полученный JSON целиком.",
            2,
        )
    outbounds = profile.get("outbounds") if isinstance(profile, dict) else None
    reserve = None
    if isinstance(outbounds, list):
        reserve = next(
            (
                item
                for item in outbounds
                if isinstance(item, dict) and item.get("tag") == "proxy"
            ),
            None,
        )
    if reserve is None:
        fail(
            "В профиле резерва нет outbound 'proxy'. Нужен обычный JSON от "
            "'vless-user export ИМЯ' резервного каскада, а не профиль с резервом.",
            2,
        )
    try:
        vnext = reserve["settings"]["vnext"][0]
        address = vnext["address"]
        uuid.UUID(str(vnext["users"][0]["id"]))
        stream = reserve["streamSettings"]
    except (KeyError, IndexError, TypeError, ValueError):
        fail("Профиль резерва повреждён: нет адреса, UUID или streamSettings", 2)
    if reserve.get("protocol") != "vless" or not isinstance(address, str) or not isinstance(stream, dict):
        fail("Профиль резерва должен быть VLESS-профилем KalimeraWG", 2)
    # Мессенджеры и заметки при копировании превращают www.example.com в
    # [www.example.com](https://www.example.com). Xray такой профиль
    # принимает, но резерв никогда не отвечает, и переключение молча не
    # происходит. Поэтому имена проверяются до сборки профиля.
    tls = stream.get("tlsSettings") if isinstance(stream.get("tlsSettings"), dict) else {}
    xhttp_names = stream.get("xhttpSettings") if isinstance(stream.get("xhttpSettings"), dict) else {}
    names = [address, tls.get("serverName", address), xhttp_names.get("host", address)]
    if not all(isinstance(name, str) and AUTO_HOSTNAME.fullmatch(name) for name in names):
        fail(
            "Профиль резерва испорчен при копировании: адрес сервера не является "
            "доменным именем (например, превращён в ссылку [домен](https://домен)). "
            "Передайте JSON на этот FRONT без мессенджеров и заметок, например "
            "через scp, или вставьте его в nano прямо из терминала резервного FRONT.",
            2,
        )
    domains = settings.get("domains", {})
    own = set(domains.values()) if isinstance(domains, dict) else set()
    if address in own:
        fail(
            "Профиль резерва выдан этим же FRONT. Резерв должен быть другим "
            "каскадом: выполните 'vless-user export ИМЯ' на его FRONT.",
            2,
        )
    xhttp = stream.get("xhttpSettings")
    if isinstance(xhttp, dict) and uplink_sends_get_body(xhttp):
        fail(
            "Профиль резерва устарел: аплинк идёт телом GET-запроса, через CDN "
            "такой профиль не работает. Обновите резервный каскад "
            "(kalimera-deploy --resume) и выпустите профиль заново.",
            2,
        )
    reserve = copy.deepcopy(reserve)
    reserve["tag"] = tag
    return reserve


def auto_config(record: dict, settings: dict, reserves: list) -> dict:
    # Основной путь - CDN этого каскада; прямой путь только у FRONT без CDN.
    mode = "cdn" if "cdn" in settings["access_modes"] else "direct"
    profile = base_profile(settings)
    profile["dns"]["servers"] = [
        server if not isinstance(server, str) or "://" in server else f"tcp+local://{server}"
        for server in profile["dns"].get("servers", [])
    ]
    main = proxy_outbound(record, settings, mode, AUTO_MAIN_TAG)
    cascades = [main, *reserves]
    tags = [outbound["tag"] for outbound in cascades]
    for outbound in cascades:
        sockopt = outbound["streamSettings"].setdefault("sockopt", {})
        sockopt["domainStrategy"] = "UseIPv4"
    profile["outbounds"] = [
        *cascades,
        {"protocol": "freedom", "tag": "direct"},
        {"protocol": "blackhole", "tag": "block"},
    ]
    profile["burstObservatory"] = {
        "subjectSelector": tags,
        "pingConfig": {
            "destination": AUTO_PROBE_URL,
            "interval": "10s",
            "sampling": 3,
            "timeout": "5s",
        },
    }
    profile["remarks"] = f"Kalimera-AUTO {record['name']}"
    profile["routing"] = {
        "domainStrategy": "AsIs",
        "balancers": [
            {
                "tag": AUTO_BALANCER_TAG,
                "selector": tags,
                "fallbackTag": AUTO_MAIN_TAG,
                "strategy": {
                    "type": "leastLoad",
                    "settings": {
                        "expected": 1,
                        "tolerance": 0.5,
                        "costs": reserve_costs(len(reserves)),
                    },
                },
            }
        ],
        "rules": [
            {
                "network": "tcp,udp",
                "balancerTag": AUTO_BALANCER_TAG,
                "type": "field",
            },
        ],
    }
    return profile


def json_payload(profile: dict) -> bytes:
    return (json.dumps(profile, ensure_ascii=False, indent=2) + "\n").encode("utf-8")


def export_payload(record: dict, settings: dict) -> bytes:
    return json_payload(client_config(record, settings))


def write_export(filename: str, payload: bytes) -> Path:
    account = pwd.getpwnam(ADMIN_USER)
    EXPORT_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(EXPORT_DIR, 0o700)
    os.chown(EXPORT_DIR, account.pw_uid, account.pw_gid)
    path = EXPORT_DIR / filename
    atomic_write(path, payload, 0o600, (account.pw_uid, account.pw_gid))
    return path


def save_export(record: dict, settings: dict) -> Path:
    return write_export(f"{record['name']}.json", export_payload(record, settings))


def emit_export(path: Path, payload: bytes) -> None:
    sys.stdout.buffer.write(payload)
    sys.stdout.flush()
    print(f"Файл JSON сохранён: {path}", file=sys.stderr)
    print(f"Открыть конфигурацию: nano {path}", file=sys.stderr)


def print_export(record: dict, settings: dict) -> Path:
    path = save_export(record, settings)
    emit_export(path, export_payload(record, settings))
    return path


def print_auto_export(record: dict, settings: dict, reserves: list) -> Path:
    payload = json_payload(auto_config(record, settings, reserves))
    path = write_export(f"{record['name']}-auto.json", payload)
    emit_export(path, payload)
    return path


def main() -> int:
    parser = argparse.ArgumentParser(prog="vless-user")
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("list")
    subparsers.add_parser("backup", help=argparse.SUPPRESS)
    create = subparsers.add_parser("create")
    create.add_argument("name")
    create.add_argument("mode", nargs="?", choices=("direct", "cdn"))
    export = subparsers.add_parser("export")
    export.add_argument("name")
    auto = subparsers.add_parser(
        "auto",
        help="профиль с резервным каскадом и автоматическим переключением",
    )
    auto.add_argument("name")
    auto.add_argument(
        "reserve",
        nargs="+",
        help=(
            "JSON от 'vless-user export ИМЯ' резервных каскадов в порядке очереди; "
            "- читать из stdin"
        ),
    )
    delete = subparsers.add_parser("delete")
    delete.add_argument("name")
    delete.add_argument("--yes", action="store_true")
    sync = subparsers.add_parser("sync")
    sync.add_argument("--no-restart", action="store_true")
    args = parser.parse_args()

    if os.geteuid() != 0:
        fail("Команда должна запускаться через управление KalimeraWG")

    lock_path = Path("/run/kalimera-vless-user.lock")
    with lock_path.open("w", encoding="utf-8") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state = load_json(USERS_FILE)
        settings = load_json(SETTINGS_FILE)
        users = validate_state(state, settings)

        if args.command == "list":
            for record in users:
                print(f"{record['name']}\t{record['mode']}")
            return 0
        if args.command == "backup":
            print(json.dumps({"schema": 1, "users": users}, ensure_ascii=False))
            return 0
        if args.command == "export":
            record = next((item for item in users if item["name"] == args.name), None)
            if record is None:
                fail(f"Пользователь {args.name} не найден", 2)
            print_export(record, settings)
            return 0
        if args.command == "auto":
            record = next((item for item in users if item["name"] == args.name), None)
            if record is None:
                fail(f"Пользователь {args.name} не найден", 2)
            reserves = load_reserves(args.reserve, settings)
            print_auto_export(record, settings, reserves)
            print(
                "Профиль с резервом: основной каскад - этот FRONT, резервные "
                "включаются по очереди, только когда недоступны все каскады "
                "перед ними. Для CDN-профиля резервы должны быть CDN-экспортами "
                "других каскадов.",
                file=sys.stderr,
            )
            return 0
        if args.command == "sync":
            changed = sync_config(users)
            if changed and not args.no_restart:
                restart_xray()
                persist_protected_state()
            print("changed" if changed else "unchanged")
            return 0

        if not NAME_RE.fullmatch(args.name):
            fail("Имя: 1-32 символа, только латиница, цифры, _ и -", 2)

        previous_state = USERS_FILE.read_bytes()
        previous_config = ACTIVE_CONFIG.read_bytes() if ACTIVE_CONFIG.is_file() else None
        try:
            if args.command == "create":
                if any(record["name"] == args.name for record in users):
                    fail(f"Пользователь {args.name} уже существует", 2)
                available_modes = settings["access_modes"]
                mode = args.mode or ("cdn" if "cdn" in available_modes else "direct")
                if mode not in available_modes:
                    fail(f"Режим {mode} не включён на FRONT", 2)
                record = {"name": args.name, "id": str(uuid.uuid4()), "mode": mode}
                state["users"].append(record)
                save_state(state)
                sync_config(validate_state(state, settings))
                restart_xray()
                persist_protected_state()
                print(
                    f"Пользователь {args.name} создан. JSON передан в stdout.",
                    file=sys.stderr,
                )
                print_export(record, settings)
                return 0

            if len(users) == 1:
                fail("Нельзя удалить последнего VLESS-пользователя", 2)
            if not args.yes:
                fail("Для удаления повторите команду с --yes", 2)
            remaining = [record for record in users if record["name"] != args.name]
            if len(remaining) == len(users):
                fail(f"Пользователь {args.name} не найден", 2)
            state["users"] = remaining
            save_state(state)
            sync_config(validate_state(state, settings))
            restart_xray()
            persist_protected_state()
            (EXPORT_DIR / f"{args.name}.json").unlink(missing_ok=True)
            (EXPORT_DIR / f"{args.name}-auto.json").unlink(missing_ok=True)
            print(f"Пользователь {args.name} удалён")
            return 0
        except BaseException:
            atomic_write(USERS_FILE, previous_state, 0o600, (0, 0))
            if previous_config is not None:
                account = pwd.getpwnam(XRAY_USER)
                atomic_write(
                    ACTIVE_CONFIG,
                    previous_config,
                    0o640,
                    (0, account.pw_gid),
                )
                subprocess.run([SYSTEMCTL, "try-restart", SERVICE], check=False)
            if os.path.isfile(SECRETCTL) and os.access(SECRETCTL, os.X_OK):
                subprocess.run(
                    [SECRETCTL, "seal"],
                    check=False,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )
            if os.path.isfile(INTEGRITY) and os.access(INTEGRITY, os.X_OK):
                subprocess.run(
                    [INTEGRITY, "seal"],
                    check=False,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )
            raise


if __name__ == "__main__":
    raise SystemExit(main())
