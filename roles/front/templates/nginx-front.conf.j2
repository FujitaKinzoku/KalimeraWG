{% if front_cert_present %}
# Пустой заголовок Connection сам по себе keepalive до Xray не включает:
# nginx переиспользует соединения с upstream только при наличии директивы
# keepalive в блоке upstream. Без этого в режиме packet-up, где КАЖДЫЙ
# пакет аплинка - отдельный HTTP-запрос, на каждый пакет открывалось бы
# новое TCP-соединение к Xray.
upstream front_xhttp_backend {
    server 127.0.0.1:{{ front_xhttp_listen_port }};
    keepalive 64;
}

{% endif %}
server {
    listen 80;
    listen [::]:80;
    server_name {{ front_origin_domain }};

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
{% if front_cert_present %}
        return 301 https://$host$request_uri;
{% else %}
        return 404;
{% endif %}
    }
}
{% if front_cert_present %}

server {
    # Ubuntu 24.04 ставит из apt nginx 1.24.0 - отдельная директива
    # "http2 on;" появилась только в 1.25.1, на 1.24.0 это "unknown
    # directive". Совмещённый синтаксис "listen ... ssl http2;" работает
    # на обеих версиях (устарел в новых, но не удалён).
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ front_origin_domain }};

    ssl_certificate {{ front_origin_cert_path }};
    ssl_certificate_key {{ front_origin_key_path }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    location {{ front_xhttp_path }} {
        proxy_pass http://front_xhttp_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # XHTTP - это долгоживущий поток, а не статика. Без отключения
        # буферизации nginx накапливает ответ upstream и при превышении
        # proxy_buffers начинает писать его во временные файлы на диск:
        # мелкие запросы проходят, а длинный поток (видео) встаёт колом.
        # Пустой Connection нужен, чтобы keepalive до Xray действительно
        # работал при proxy_http_version 1.1.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_set_header Connection "";
        proxy_socket_keepalive on;

        # Даунлинк XHTTP - долгоживущий поток, который при простое телефона
        # (экран выключен) молчит дольше пяти минут; на 300s nginx рвал бы
        # его и вынуждал переподключаться. Час - то же значение, что в
        # эталонном примере nginx у XTLS.
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        client_max_body_size 0;
    }

{% if front_subscription_enabled | default(false) | bool %}
    location {{ front_subscription_path }} {
        alias {{ front_subscription_file_path }};
        default_type text/plain;
        add_header profile-title "{{ front_subscription_title }}" always;
        add_header profile-update-interval "{{ front_subscription_update_interval_hours }}" always;
    }
{% endif %}

    location / {
        return 404;
    }
}
{% endif %}
