{% if front_cert_present %}
# Пустой заголовок Connection сам по себе keepalive до Xray не включает:
# nginx переиспользует соединения с upstream только при наличии директивы
# keepalive в блоке upstream. Без этого в режиме packet-up, где КАЖДЫЙ
# пакет аплинка - отдельный HTTP-запрос, на каждый пакет открывалось бы
# новое TCP-соединение к Xray.
upstream front_xhttp_backend {
    server 127.0.0.1:{{ front_xhttp_listen_port }};
    keepalive 64;
}

{% if front_site_active | default(false) | bool %}
# Срок кэша страниц и файлов сайта по типу ответа: страницы обновляются
# быстро, файлы с хешем в имени и рисунки хранятся долго. Через переменную,
# а не отдельными location с регулярными выражениями: такие location nginx
# проверяет раньше обычных, и путь XHTTP не должен от них зависеть.
map $sent_http_content_type $front_site_expires {
    default                  off;
    ~^text/html              10m;
    ~^text/xml               1h;
    ~^text/plain             1h;
    ~^text/css               30d;
    ~^application/javascript 30d;
    ~^image/                 30d;
}

{% endif %}
{% endif %}
server {
    listen 80;
    listen [::]:80;
    server_name {{ front_origin_domain }};
    access_log off;
    error_log /dev/null crit;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
{% if front_cert_present %}
        return 301 https://$host$request_uri;
{% else %}
        return 404;
{% endif %}
    }
}
{% if front_cert_present %}

server {
    # Ubuntu 24.04 ставит из apt nginx 1.24.0 - отдельная директива
    # "http2 on;" появилась только в 1.25.1, на 1.24.0 это "unknown
    # directive". Совмещённый синтаксис "listen ... ssl http2;" работает
    # на обеих версиях (устарел в новых, но не удалён).
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ front_origin_domain }};
    access_log off;
    error_log /dev/null crit;

    ssl_certificate {{ front_origin_cert_path }};
    ssl_certificate_key {{ front_origin_key_path }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    location {{ front_xhttp_path }} {
        proxy_pass http://front_xhttp_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # XHTTP - это долгоживущий поток, а не статика. Без отключения
        # буферизации nginx накапливает ответ upstream и при превышении
        # proxy_buffers начинает писать его во временные файлы на диск:
        # мелкие запросы проходят, а длинный поток (видео) встаёт колом.
        # Пустой Connection нужен, чтобы keepalive до Xray действительно
        # работал при proxy_http_version 1.1.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_set_header Connection "";
        proxy_socket_keepalive on;

        # Даунлинк XHTTP - долгоживущий поток, который при простое телефона
        # (экран выключен) молчит дольше пяти минут; на 300s nginx рвал бы
        # его и вынуждал переподключаться. Час - то же значение, что в
        # эталонном примере nginx у XTLS.
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        client_max_body_size 0;

        # Аплинк packet-up приходит GET-запросами без тела: Yandex Cloud CDN
        # отвечает 413 на любой GET с телом, поэтому нагрузка лежит в
        # заголовках <ключ>-0, <ключ>-1 (front_xhttp_uplink_* в defaults
        # роли). Одна такая строка - около 3 КБ, весь пакет - около 5,5 КБ,
        # и встроенных large_client_header_buffers 4 8k (поле до 8 КБ, все
        # заголовки до 32 КБ, в том числе по HTTP/2) хватает с запасом -
        # директива намеренно не переопределяется. Ключ без подчёркивания:
        # при встроенном underscores_in_headers off такие заголовки nginx
        # молча выбрасывает.
    }

{% if front_site_active | default(false) | bool %}
    # Сайт в корне: всё, что не путь XHTTP, получает страницы из каталога,
    # собранного kalimera-front-site. Домен отвечает как обычный сайт: главная,
    # вложенные страницы, файлы, своя страница 404, сжатие и заголовки кэша.
    root {{ front_site_root }};
    index index.html;
    error_page 404 /404.html;

    location = /404.html {
        internal;
        charset utf-8;
    }

    location / {
        try_files $uri $uri/ =404;
        charset utf-8;
        expires $front_site_expires;
        gzip on;
        gzip_vary on;
        gzip_min_length 512;
        gzip_types text/css text/xml text/plain application/javascript image/svg+xml;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }
{% else %}
    location / {
        return 404;
    }
{% endif %}
}
{% endif %}
