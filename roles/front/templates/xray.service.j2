[Unit]
Description=Xray-core (FRONT-релей VLESS+XHTTP -> ENTRY REALITY)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart={{ front_xray_binary_path }} run -c {{ front_xray_config_path }}
Restart=on-failure
RestartSec=2
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=-{{ front_xray_state_dir }}
ProtectClock=true
ProtectControlGroups=true
ProtectKernelModules=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
