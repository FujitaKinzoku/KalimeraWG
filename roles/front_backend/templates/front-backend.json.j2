{
  "log": {
    "disabled": true
  },
  "inbounds": [
    {
      "type": "vless",
      "tag": "front-reality-in",
      "listen": "::",
      "listen_port": {{ reality_fallback_port }},
      "users": [
        {
          "uuid": "{{ reality_fallback_front_client_uuid }}",
          "flow": "xtls-rprx-vision",
          "name": "front-service"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "{{ reality_fallback_effective_dest | default(reality_fallback_dest) }}",
        "reality": {
          "enabled": true,
          "handshake": {
            "server": "{{ reality_fallback_effective_dest | default(reality_fallback_dest) }}",
            "server_port": {{ reality_fallback_effective_dest_port | default(reality_fallback_dest_port) }}
          },
          "private_key": "{{ reality_fallback_private_key }}",
          "short_id": ["{{ reality_fallback_short_id }}"]
        }
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct-exit",
      "routing_mark": "{{ entry_exit_mark }}",
      "domain_resolver": {
        "server": "bootstrap-unbound",
        "strategy": "ipv4_only"
      }
    },
    {
      "type": "direct",
      "tag": "direct-ru",
      "routing_mark": "{{ entry_ru_mark }}",
      "domain_resolver": {
        "server": "entry-split-dns",
        "strategy": "ipv4_only"
      }
    }
  ],
{#
   Российские назначения разрешает dnsmasq ENTRY, тот же, что обслуживает
   клиентов AmneziaWG, а не зарубежный Unbound. dnsmasq отправляет .ru/.рф и
   ru-domain в российский DoH (порт entry_dns_ru_port, через RU-прокси), а при
   выключенном или упавшем прокси awg-dns-policy и ru-domain sync сами
   переключают его на Unbound. Раньше backend разрешал всё через Unbound
   (DoT за рубежом или DNS через EXIT): российский сайт за гео-CDN получал
   адрес зарубежного узла, хотя трафик выходил с ENTRY. Порт 5354 напрямую
   здесь не годится: он есть только пока работает служба RU-прокси.
#}
{#
   Здесь НЕ должно быть "default_interface". Эта опция привязывает исходящий
   сокет к WAN-интерфейсу и тем самым фиксирует и интерфейс, и исходный адрес
   ещё до маршрутизации. После такой привязки "routing_mark" выше перестаёт
   работать: метка выбрала бы таблицу с маршрутом через межсерверный интерфейс
   и адресом из транзитной подсети, но сокет уже взял публичный адрес ENTRY.

   Последствие было незаметным и потому долго не находилось: туннель исправен,
   клиент не сообщает ни одной ошибки, но весь трафик VLESS/FRONT выходил в
   интернет с ENTRY, а не через EXIT. То есть маскировка работала, а смены
   страны выхода не происходило вовсе. Проверять это следует не логами, а
   внешним IP клиента: он обязан совпадать с адресом EXIT.
#}
  "route": {
    "final": "direct-exit",
    "default_domain_resolver": "bootstrap-unbound",
    "rule_set": [
      {
        "type": "local",
        "tag": "front-ru-domains",
        "format": "source",
        "path": "{{ reality_fallback_ru_rule_set_path }}"
      },
      {
        "type": "local",
        "tag": "front-ru-zone",
        "format": "source",
        "path": "{{ reality_fallback_ru_zone_rule_set_path }}"
      },
      {
        "type": "local",
        "tag": "front-se-domains",
        "format": "source",
        "path": "{{ reality_fallback_se_rule_set_path }}"
      }
    ],
    "rules": [
      {
        "inbound": ["front-reality-in"],
        "action": "sniff"
      },
      {
        "inbound": ["front-reality-in"],
        "rule_set": ["front-se-domains"],
        "outbound": "direct-exit"
      },
      {
        "inbound": ["front-reality-in"],
        "domain_suffix": [".ru", ".xn--p1ai"],
        "outbound": "direct-ru"
      },
      {
        "inbound": ["front-reality-in"],
        "rule_set": ["front-ru-domains", "front-ru-zone"],
        "outbound": "direct-ru"
      }
    ]
  },
  "dns": {
    "servers": [
      {
        "type": "udp",
        "tag": "bootstrap-unbound",
        "server": "127.0.0.1",
        "server_port": {{ entry_dns_default_port }}
      },
      {
        "type": "udp",
        "tag": "entry-split-dns",
        "server": "{{ entry_client_listen_address }}",
        "server_port": 53
      }
    ],
    "final": "bootstrap-unbound",
    "strategy": "ipv4_only",
    "disable_cache": true
  }
}

