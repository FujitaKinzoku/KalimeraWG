[Interface]
PrivateKey = {{ vault_awg_entry_standby_exit_private_key }}
Address = {{ entry_standby_exit_tunnel_address }}
ListenPort = {{ entry_standby_exit_listen_port }}
MTU = {{ awg3_shared_effective_mtu | default(entry_awg1_mtu, true) | int }}
Table = off
PostUp = ip -4 route replace {{ entry_standby_exit_peer_tunnel_address }}/32 dev %i
PostDown = ip -4 route del {{ entry_standby_exit_peer_tunnel_address }}/32 dev %i 2>/dev/null || true
Jc = {{ entry_standby_exit_obfuscation.jc }}
Jmin = {{ entry_standby_exit_obfuscation.jmin }}
Jmax = {{ entry_standby_exit_obfuscation.jmax }}
S1 = {{ entry_standby_exit_obfuscation.s1 }}
S2 = {{ entry_standby_exit_obfuscation.s2 }}
S3 = {{ entry_standby_exit_obfuscation.s3 }}
S4 = {{ entry_standby_exit_obfuscation.s4 }}
H1 = {{ entry_standby_exit_obfuscation.h1 }}
H2 = {{ entry_standby_exit_obfuscation.h2 }}
H3 = {{ entry_standby_exit_obfuscation.h3 }}
H4 = {{ entry_standby_exit_obfuscation.h4 }}
I1 = {{ entry_standby_exit_obfuscation.i1 }}
I2 = {{ entry_standby_exit_obfuscation.i2 }}
I3 = {{ entry_standby_exit_obfuscation.i3 }}
I4 = {{ entry_standby_exit_obfuscation.i4 }}
I5 = {{ entry_standby_exit_obfuscation.i5 }}
HeaderProtectionKey = {{ vault_awg_standby_header_protection_key }}
ContentPaddingAddition = {{ awg3_content_padding_addition }}
RekeyAfterTime = {{ awg3_rekey_after_time }}
RekeyTimeout = {{ awg3_rekey_timeout }}
RejectAfterTime = {{ awg3_reject_after_time }}
KeepaliveTimeout = {{ awg3_keepalive_timeout }}
MaxHandshakeAttempts = {{ awg3_max_handshake_attempts }}
RandomTrailers = {{ 'on' if awg3_random_trailers | bool else 'off' }}
DisableCookies = {{ 'on' if awg3_disable_cookies | bool else 'off' }}

[Peer]
#_Name = exit-standby
PublicKey = {{ vault_awg_entry_standby_exit_peer_public_key }}
PresharedKey = {{ vault_awg_entry_standby_exit_psk }}
AllowedIPs = {{ entry_standby_exit_allowed_ips | join(', ') }}
Endpoint = {{ entry_standby_exit_endpoint }}
PersistentKeepalive = {{ entry_standby_exit_persistent_keepalive }}
