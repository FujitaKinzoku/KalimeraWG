[Unit]
Description=Выбор пути до EXIT: основной или резервный сервер
After={{ entry_routing_service_name }} awg-quick@{{ entry_exit_interface }}.service awg-quick@{{ entry_standby_exit_interface }}.service
ConditionPathExists={{ entry_exit_path_config_dir }}/config.json

[Service]
Type=oneshot
ExecStart={{ entry_exit_path_script_path }} tick
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run -{{ entry_exit_path_mode_file | dirname }}
ProtectClock=true
ProtectControlGroups=true
ProtectKernelModules=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0022
TimeoutStartSec=60
