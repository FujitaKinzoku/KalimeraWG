# Сформировано Ansible. Явные правила EXIT имеют приоритет над RU-зонами.
{% if entry_ru_proxy_enabled | bool %}
# Только RU-DoH, без фолбэка на дефолтную/зарубежную ветку. Две строки
# server= на один домен конкурировали за выбор dnsmasq по внутренней
# эвристике (обычно в пользу более быстрой дефолтной ветки), и .ru/.рф
# мог молча резолвиться не через RU-DoH, а через EXIT — недоступность
# RU-DoH теперь честно даёт отказ резолвинга, а не утечку геолокации.
server=/ru/127.0.0.1#{{ entry_dns_ru_port }}
server=/xn--p1ai/127.0.0.1#{{ entry_dns_ru_port }}
{% endif %}
# Резолвинг любого .ru/.рф автоматически добавляет полученный IP в ipset ru —
# закрывает дрейф CDN (сервис на общем зарубежном IP-пуле) тем же механизмом,
# что уже используется для явных ru-domain/se-domain (dnsmasq --ipset).
ipset=/ru/ru
ipset=/xn--p1ai/ru
