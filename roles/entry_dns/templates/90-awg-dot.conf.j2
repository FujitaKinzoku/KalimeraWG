server:
    interface: 127.0.0.1
    port: {{ entry_dns_default_port }}
    access-control: 127.0.0.0/8 allow
    do-ip4: yes
    do-ip6: no
    do-udp: yes
    do-tcp: yes
    hide-identity: yes
    hide-version: yes
    # Минимальный TTL ответов в кэше Unbound: короткие записи CDN не запрашиваются
    # заново при каждом подключении. Значение задаёт entry_dns_cache_min_ttl.
    cache-min-ttl: {{ entry_dns_cache_min_ttl | default(300) | int }}
    # Prefetch обновляет популярные записи до истечения TTL, поэтому клиент реже
    # ждёт промах. Запросы идут только к именам, которые уже запрашивались.
    prefetch: {{ 'yes' if (entry_dns_prefetch | default(true) | bool) else 'no' }}
    qname-minimisation: yes
    aggressive-nsec: yes
    tls-cert-bundle: "/etc/ssl/certs/ca-certificates.crt"
    verbosity: 0
    statistics-interval: 0
    extended-statistics: no
    log-queries: no
    log-replies: no
    log-tag-queryreply: no
    log-local-actions: no
    log-servfail: no

remote-control:
    control-enable: yes
    control-interface: /run/unbound.ctl

forward-zone:
    name: "."
{% if entry_dns_default_via_exit | default(false) | bool %}
    forward-addr: {{ awg3_peer_tunnel_address }}@53
{% else %}
    forward-tls-upstream: yes
{% for upstream in entry_dns_effective_dot_upstreams | default(entry_dns_dot_upstreams_resolved) %}
    forward-addr: {{ upstream.address }}@853#{{ upstream.tls_name }}
{% endfor %}
{% endif %}
