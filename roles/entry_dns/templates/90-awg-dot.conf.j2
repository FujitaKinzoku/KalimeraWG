server:
    interface: 127.0.0.1
    port: {{ entry_dns_default_port }}
    access-control: 127.0.0.0/8 allow
    do-ip4: yes
    do-ip6: no
    do-udp: yes
    do-tcp: yes
    hide-identity: yes
    hide-version: yes
    # Минимальный TTL ответов в кэше Unbound: короткие записи CDN не запрашиваются
    # заново при каждом подключении. Значение задаёт entry_dns_cache_min_ttl.
    cache-min-ttl: {{ entry_dns_cache_min_ttl | default(300) | int }}
    # Prefetch обновляет популярные записи до истечения TTL, поэтому клиент реже
    # ждёт промах. Запросы идут только к именам, которые уже запрашивались.
    prefetch: {{ 'yes' if (entry_dns_prefetch | default(true) | bool) else 'no' }}
    # Данные о задержке до серверов DoT живут дольше, чем по умолчанию: реже
    # проверяется второй сервер, а его проверки не попадают на запросы клиентов.
    infra-host-ttl: {{ entry_dns_infra_host_ttl | default(3600) | int }}
    # Размеры кэша ответов и RRset: больше записей остаётся в памяти без вытеснения.
    msg-cache-size: {{ entry_dns_msg_cache_size | default('32m') }}
    rrset-cache-size: {{ entry_dns_rrset_cache_size | default('64m') }}
    # Prefetch DNSKEY: ключи популярных зон не запрашиваются заново при каждой проверке.
    prefetch-key: {{ 'yes' if (entry_dns_prefetch_key | default(true) | bool) else 'no' }}
{% if (entry_dns_serve_expired_ttl | default(3600) | int) > 0 %}
    # Устаревший ответ отдаётся сразу, пока Unbound обновляет запись в фоне. Окно не
    # дольше entry_dns_serve_expired_ttl секунд после истечения TTL.
    serve-expired: yes
    serve-expired-ttl: {{ entry_dns_serve_expired_ttl | default(3600) | int }}
    # 0 = отвечать из кэша сразу, не дожидаясь DoT-сервера. Задано явно, чтобы
    # поведение не зависело от значения по умолчанию в версии Unbound.
    serve-expired-client-timeout: 0
{% endif %}
    qname-minimisation: yes
    aggressive-nsec: yes
    tls-cert-bundle: "/etc/ssl/certs/ca-certificates.crt"
    verbosity: 0
    statistics-interval: 0
    extended-statistics: no
    log-queries: no
    log-replies: no
    log-tag-queryreply: no
    log-local-actions: no
    log-servfail: no

remote-control:
    control-enable: yes
    control-interface: /run/unbound.ctl

forward-zone:
    name: "."
{% if entry_dns_via_exit_effective | default(entry_dns_default_via_exit | default(false)) | bool %}
    # Резолвер EXIT внутри туннеля: запросы о зарубежных узлах с ENTRY наружу не
    # уходят. При работе через резервный EXIT адрес меняет переключатель путей.
    forward-addr: {{ awg3_peer_tunnel_address }}@53
{% else %}
    forward-tls-upstream: yes
{% for upstream in entry_dns_effective_dot_upstreams | default(entry_dns_dot_upstreams_resolved) %}
    forward-addr: {{ upstream.address }}@853#{{ upstream.tls_name }}
{% endfor %}
{% endif %}
