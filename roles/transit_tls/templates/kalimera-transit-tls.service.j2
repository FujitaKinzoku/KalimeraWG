[Unit]
Description=KalimeraWG: запасной транспорт туннеля ENTRY - EXIT (TLS по TCP)
After=network-online.target
Wants=network-online.target
{% if runtime_secrets_enabled | default(false) | bool %}
Requires={{ runtime_secrets_service_name | default('kalimera-secrets-unlock.service') }}
After={{ runtime_secrets_service_name | default('kalimera-secrets-unlock.service') }}
{% endif %}
ConditionPathExists={{ transit_tls_server_config_path }}

# Служба намеренно не включается при загрузке: порт слушается только тогда,
# когда сторож транспорта открыл этот транспорт по запросу ENTRY.
# Конфигурация с закрытым ключом передаётся через systemd credentials: служба
# работает от непривилегированного пользователя и самого файла не читает.
[Service]
Type=simple
User=sing-box
Group=sing-box
LoadCredential=transit.json:{{ transit_tls_server_config_path }}
ExecStart=/usr/bin/sing-box -D {{ transit_tls_state_dir }} -c %d/transit.json run
Restart=on-failure
RestartSec=2
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectClock=true
ProtectControlGroups=true
ProtectKernelModules=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0077
ReadWritePaths={{ transit_tls_state_dir }}
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
