{#
  Запасной транспорт на EXIT: VLESS внутри TLS 1.3. Принимает только UDP-пакеты
  туннеля и отдаёт их интерфейсу AmneziaWG на этом же сервере; любое другое
  назначение отклоняется. Сертификат закрытый: подключается только ENTRY, а в
  TLS 1.3 сертификат сервера наблюдателю не виден. Журнал выключен.
#}
{{ {
  'log': {'disabled': true},
  'inbounds': [{
    'type': 'vless',
    'tag': 'transit-in',
    'listen': '0.0.0.0',
    'listen_port': transit_tls_port | int,
    'users': [{'uuid': transit_tls_material.uuid}],
    'tls': {
      'enabled': true,
      'server_name': transit_tls_server_name,
      'min_version': '1.3',
      'alpn': ['h2', 'http/1.1'],
      'certificate': transit_tls_material.certificate.strip().splitlines(),
      'key': transit_tls_material.private_key.strip().splitlines()
    }
  }],
  'outbounds': [{'type': 'direct', 'tag': 'awg'}],
  'route': {
    'rules': [
      {
        'network': ['udp'],
        'ip_cidr': ['127.0.0.1/32'],
        'port': [exit_awg_listen_port | int],
        'action': 'route',
        'outbound': 'awg'
      },
      {'action': 'reject'}
    ]
  }
} | to_nice_json(ensure_ascii=False) }}
