[Unit]
Requires={{ runtime_secrets_service_name }}
After={{ runtime_secrets_service_name }}

[Service]
LoadCredential=%i.conf:{{ runtime_secrets_runtime_root }}/amneziawg/%i.conf
ExecStart=
ExecStart=/usr/bin/awg-quick up %d/%i.conf
ExecStop=
# awg-quick down перечитывает исходный конфиг, чтобы знать, какие маршруты и
# iptables-правила снимать — но при restart credential-каталог %d иногда уже
# недоступен к моменту ExecStop, и awg-quick down тогда завершается ошибкой,
# не удалив интерфейс. Осиротевший интерфейс потом ломает следующий ExecStart
# ("already exists"). Резервное прямое удаление интерфейса гарантирует, что
# после stop его точно не останется, независимо от доступности credential.
ExecStop=/bin/sh -c '/usr/bin/awg-quick down %d/%i.conf || { /usr/sbin/ip link delete dev %i 2>/dev/null || true; }'
