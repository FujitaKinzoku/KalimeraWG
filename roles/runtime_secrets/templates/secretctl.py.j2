#!/usr/bin/env python3
"""Пороговое открытие зашифрованного runtime-пакета KalimeraWG."""

from __future__ import annotations

import argparse
import base64
import concurrent.futures
import fcntl
import gzip
import hashlib
import hmac
import io
import itertools
import json
import os
import pathlib
import re
import shutil
import stat
import subprocess
import sys
import tarfile
import tempfile

from cryptography.hazmat.primitives.ciphers.aead import AESGCM

CONFIG_PATH = pathlib.Path(
    os.environ.get("KALIMERA_SECRET_CONFIG", {{ runtime_secrets_config_path | to_json }})
)
SHARE_PATTERN = re.compile(r"^[A-Za-z0-9_.-]+-[1-9][0-9]*-[0-9a-f]+$")
AAD_PREFIX = b"KalimeraWG runtime secrets v1\0"


class SecretError(RuntimeError):
    pass


def load_config() -> dict:
    try:
        config = json.loads(CONFIG_PATH.read_text(encoding="utf-8"))
    except (OSError, ValueError) as error:
        raise SecretError("конфигурация runtime-секретов недоступна") from error
    required = {
        "cluster_id", "threshold", "total_shares", "key_sha256",
        "runtime_root", "bundle_path", "local_share_path", "identity_path",
        "known_hosts_path", "peers", "mappings",
    }
    if not required.issubset(config):
        raise SecretError("конфигурация runtime-секретов неполна")
    if config["threshold"] != 2:
        raise SecretError("эта версия поддерживает проверенный threshold=2")
    if not re.fullmatch(r"[0-9a-f]{64}", str(config["key_sha256"])):
        raise SecretError("контрольная сумма ключа повреждена")
    runtime = pathlib.Path(config["runtime_root"])
    if not runtime.is_absolute() or runtime.parts[:2] != ("/", "run"):
        raise SecretError("runtime_root должен находиться в /run")
    return config


def read_share(path: pathlib.Path) -> str:
    try:
        value = path.read_text(encoding="ascii").splitlines()[0].strip()
    except (OSError, IndexError, UnicodeError) as error:
        raise SecretError("локальная доля недоступна") from error
    if not SHARE_PATTERN.fullmatch(value):
        raise SecretError("доля имеет недопустимый формат")
    return value


def share_index(share: str) -> int:
    try:
        return int(share.rsplit("-", 2)[1])
    except (IndexError, ValueError) as error:
        raise SecretError("индекс доли повреждён") from error


def fetch_peer_share(config: dict, peer: dict) -> str:
    timeout = max(2, min(int(config.get("peer_timeout_seconds", 7)), 30))
    command = [
        "/usr/bin/ssh", "-T", "-o", "BatchMode=yes", "-o", "IdentitiesOnly=yes",
        "-o", "StrictHostKeyChecking=yes", "-o", f"ConnectTimeout={timeout}",
        "-o", "ConnectionAttempts=1", "-o", "LogLevel=ERROR",
        "-o", f"UserKnownHostsFile={config['known_hosts_path']}",
        "-i", config["identity_path"], "-p", str(int(peer["port"])),
        f"{peer.get('user', 'root')}@{peer['host']}", "get-share", config["cluster_id"],
    ]
    result = subprocess.run(
        command, text=True, capture_output=True, timeout=timeout + 2, check=False
    )
    value = result.stdout.strip().splitlines()
    if result.returncode != 0 or len(value) != 1 or not SHARE_PATTERN.fullmatch(value[0]):
        raise SecretError("peer не выдал допустимую долю")
    return value[0]


def collect_shares(config: dict, recovery_path: str | None = None) -> list[str]:
    shares = [read_share(pathlib.Path(config["local_share_path"]))]
    peers = list(config.get("peers", []))
    if peers:
        workers = min(len(peers), 8)
        with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as executor:
            futures = [executor.submit(fetch_peer_share, config, peer) for peer in peers]
            for future in concurrent.futures.as_completed(futures):
                try:
                    shares.append(future.result())
                except (SecretError, OSError, subprocess.SubprocessError):
                    continue
    if recovery_path:
        shares.append(read_share(pathlib.Path(recovery_path)))
    unique: dict[int, str] = {}
    for share in shares:
        unique.setdefault(share_index(share), share)
    return list(unique.values())


def combine(config: dict, shares: list[str]) -> bytes:
    threshold = int(config["threshold"])
    if len(shares) < threshold:
        raise SecretError("недостаточно разных долей для открытия пакета")
    for selected in itertools.combinations(shares, threshold):
        result = subprocess.run(
            ["/usr/bin/ssss-combine", "-t", str(threshold), "-x", "-Q"],
            input="\n".join(selected) + "\n",
            text=True,
            capture_output=True,
            check=False,
        )
        if result.returncode != 0:
            continue
        candidates = [
            value.lower()
            for value in re.findall(
                r"(?<![0-9a-f])[0-9a-f]{64}(?![0-9a-f])",
                (result.stdout + "\n" + result.stderr).lower(),
            )
        ]
        for candidate in candidates:
            key = bytes.fromhex(candidate)
            if hashlib.sha256(key).hexdigest() == config["key_sha256"]:
                return key
    raise SecretError("доли не прошли криптографическую проверку")


def atomic_write(path: pathlib.Path, content: bytes, mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = pathlib.Path(temporary_name)
    try:
        os.fchmod(descriptor, mode)
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        temporary.unlink(missing_ok=True)


def archive_runtime(config: dict) -> bytes:
    runtime = pathlib.Path(config["runtime_root"])
    tar_stream = io.BytesIO()

    def scrub(info: tarfile.TarInfo) -> tarfile.TarInfo:
        if info.issym() or info.islnk() or info.isdev():
            raise SecretError("runtime-пакет не допускает ссылок и устройств")
        info.uid = 0
        info.gid = 0
        info.uname = "root"
        info.gname = "root"
        info.mtime = 0
        return info

    with tarfile.open(fileobj=tar_stream, mode="w") as archive:
        for child in sorted(runtime.iterdir(), key=lambda item: item.name):
            if child.name == ".unlocked":
                continue
            archive.add(child, arcname=child.name, recursive=True, filter=scrub)
    compressed = io.BytesIO()
    with gzip.GzipFile(
        filename="", mode="wb", compresslevel=6, fileobj=compressed, mtime=0
    ) as stream:
        stream.write(tar_stream.getvalue())
    return compressed.getvalue()


def decrypt_bundle(config: dict, key: bytes) -> bytes:
    bundle_path = pathlib.Path(config["bundle_path"])
    try:
        document = json.loads(bundle_path.read_text(encoding="ascii"))
        nonce = base64.b64decode(document["nonce"], validate=True)
        ciphertext = base64.b64decode(document["ciphertext"], validate=True)
    except (OSError, ValueError, KeyError) as error:
        raise SecretError("зашифрованный runtime-пакет повреждён или отсутствует") from error
    if document.get("version") != 1 or document.get("cluster_id") != config["cluster_id"]:
        raise SecretError("runtime-пакет относится к другой версии или инсталляции")
    try:
        aad = AAD_PREFIX + config["cluster_id"].encode("ascii")
        return AESGCM(key).decrypt(nonce, ciphertext, aad)
    except Exception as error:
        raise SecretError("аутентификация runtime-пакета не пройдена") from error


def seal(config: dict, recovery_path: str | None) -> bool:
    runtime = pathlib.Path(config["runtime_root"])
    if not runtime.is_dir():
        raise SecretError("runtime-каталог ещё не подготовлен")
    key = bytearray(combine(config, collect_shares(config, recovery_path)))
    try:
        plaintext = archive_runtime(config)
        bundle_path = pathlib.Path(config["bundle_path"])
        if bundle_path.is_file() and hmac.compare_digest(
            decrypt_bundle(config, bytes(key)), plaintext
        ):
            return False
        nonce = os.urandom(12)
        aad = AAD_PREFIX + config["cluster_id"].encode("ascii")
        ciphertext = AESGCM(bytes(key)).encrypt(nonce, plaintext, aad)
        document = {
            "version": 1,
            "cluster_id": config["cluster_id"],
            "algorithm": "AES-256-GCM",
            "nonce": base64.b64encode(nonce).decode("ascii"),
            "ciphertext": base64.b64encode(ciphertext).decode("ascii"),
        }
        atomic_write(
            bundle_path,
            (json.dumps(document, sort_keys=True, separators=(",", ":")) + "\n").encode("ascii"),
        )
    finally:
        for index in range(len(key)):
            key[index] = 0
    return True


def safe_members(archive: tarfile.TarFile) -> list[tarfile.TarInfo]:
    members = archive.getmembers()
    for member in members:
        path = pathlib.PurePosixPath(member.name)
        if path.is_absolute() or ".." in path.parts or member.issym() or member.islnk() or member.isdev():
            raise SecretError("зашифрованный пакет содержит небезопасный путь")
    return members


def unlock(config: dict, recovery_path: str | None) -> bool:
    key = bytearray(combine(config, collect_shares(config, recovery_path)))
    try:
        plaintext = decrypt_bundle(config, bytes(key))
    finally:
        for index in range(len(key)):
            key[index] = 0

    runtime = pathlib.Path(config["runtime_root"])
    if runtime.is_symlink():
        raise SecretError("runtime_root не может быть символической ссылкой")
    temporary = runtime.with_name(f".{runtime.name}.{os.getpid()}")
    shutil.rmtree(temporary, ignore_errors=True)
    temporary.mkdir(parents=True, mode=0o700)
    try:
        with tarfile.open(fileobj=io.BytesIO(plaintext), mode="r:gz") as archive:
            archive.extractall(temporary, members=safe_members(archive), filter="data")
        if runtime.exists():
            shutil.rmtree(runtime)
        os.replace(temporary, runtime)
        os.chmod(runtime, 0o700)
        (runtime / ".unlocked").write_text(config["cluster_id"] + "\n", encoding="ascii")
        os.chmod(runtime / ".unlocked", 0o600)
    finally:
        shutil.rmtree(temporary, ignore_errors=True)
    return True


def reject_links_in_tree(source: pathlib.Path) -> None:
    if source.is_symlink():
        raise SecretError(f"ссылка внутри открытого источника запрещена: {source}")
    if not source.is_dir():
        return
    for root, directories, files in os.walk(source, followlinks=False):
        root_path = pathlib.Path(root)
        for name in directories + files:
            candidate = root_path / name
            if candidate.is_symlink():
                raise SecretError(
                    f"ссылка внутри открытого источника запрещена: {candidate}"
                )


def copy_source(source: pathlib.Path, target: pathlib.Path) -> None:
    if source.is_symlink():
        if source.resolve(strict=False) != target.resolve(strict=False):
            raise SecretError(f"неожиданная ссылка в управляемом пути {source}")
        return
    if not source.exists():
        return
    reject_links_in_tree(source)
    target.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    if source.is_dir():
        target.mkdir(parents=True, exist_ok=True, mode=0o700)
        shutil.copytree(source, target, dirs_exist_ok=True, symlinks=False)
    elif source.is_file():
        shutil.copy2(source, target)
        os.chmod(target, stat.S_IMODE(source.stat().st_mode) & 0o700 or 0o600)
    else:
        raise SecretError(f"неподдерживаемый тип управляемого пути {source}")


def adopt(config: dict) -> bool:
    runtime = pathlib.Path(config["runtime_root"])
    if runtime.is_symlink():
        raise SecretError("runtime_root не может быть символической ссылкой")
    runtime.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(runtime, 0o700)
    changed = False
    for mapping in config["mappings"]:
        source = pathlib.Path(mapping["source"])
        target = runtime / mapping["target"]
        if not target.resolve(strict=False).is_relative_to(runtime.resolve()):
            raise SecretError("цель управляемого пути выходит за runtime_root")
        if source.exists() and not source.is_symlink():
            changed = True
        copy_source(source, target)
    return changed


def link(config: dict) -> bool:
    runtime = pathlib.Path(config["runtime_root"])
    changed = False
    for mapping in config["mappings"]:
        source = pathlib.Path(mapping["source"])
        target = runtime / mapping["target"]
        if not target.exists():
            if source.exists() or source.is_symlink():
                raise SecretError(
                    f"управляемый источник существует без runtime-копии: {source}"
                )
            continue
        if source.is_symlink() and source.resolve(strict=False) == target.resolve(strict=False):
            continue
        source.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        if source.is_symlink() or source.is_file():
            source.unlink()
        elif source.is_dir():
            shutil.rmtree(source)
        elif source.exists():
            raise SecretError(f"невозможно заменить управляемый путь {source}")
        source.symlink_to(target, target_is_directory=target.is_dir())
        changed = True
    marker = runtime / ".unlocked"
    expected_marker = config["cluster_id"] + "\n"
    if not marker.is_file() or marker.read_text(encoding="ascii") != expected_marker:
        marker.write_text(expected_marker, encoding="ascii")
        os.chmod(marker, 0o600)
        changed = True
    return changed


def verify(config: dict) -> None:
    runtime = pathlib.Path(config["runtime_root"])
    bundle = pathlib.Path(config["bundle_path"])
    local_share = pathlib.Path(config["local_share_path"])
    identity = pathlib.Path(config["identity_path"])
    marker = runtime / ".unlocked"
    if runtime.is_symlink() or not runtime.is_dir() or not marker.is_file():
        raise SecretError("runtime-пакет не открыт")
    if marker.read_text(encoding="ascii").strip() != config["cluster_id"]:
        raise SecretError("маркер runtime-пакета относится к другой инсталляции")
    for path in (bundle, local_share, identity, CONFIG_PATH):
        if not path.is_file() or stat.S_IMODE(path.stat().st_mode) & 0o077:
            raise SecretError(f"небезопасные права или отсутствует {path}")
    for mapping in config["mappings"]:
        source = pathlib.Path(mapping["source"])
        target = runtime / mapping["target"]
        if target.exists():
            if (
                not source.is_symlink()
                or source.resolve(strict=False) != target.resolve(strict=False)
            ):
                raise SecretError(f"открытая копия осталась вне /run: {source}")
        elif source.exists() or source.is_symlink():
            raise SecretError(
                f"управляемый источник существует без runtime-копии: {source}"
            )


def check_bundle(config: dict, recovery_path: str | None) -> None:
    key = bytearray(combine(config, collect_shares(config, recovery_path)))
    try:
        plaintext = decrypt_bundle(config, bytes(key))
        with tarfile.open(fileobj=io.BytesIO(plaintext), mode="r:gz") as archive:
            safe_members(archive)
    finally:
        for index in range(len(key)):
            key[index] = 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Runtime-секреты KalimeraWG")
    parser.add_argument(
        "action",
        choices=("adopt", "seal", "link", "unlock", "verify", "check", "status"),
    )
    parser.add_argument("--recovery-share-file")
    args = parser.parse_args()
    config = load_config()
    runtime = pathlib.Path(config["runtime_root"])
    lock_path = runtime.parent / f".{runtime.name}.lock"
    descriptor = os.open(lock_path, os.O_RDWR | os.O_CREAT, 0o600)
    try:
        os.fchmod(descriptor, 0o600)
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        changed = False
        if args.action == "adopt":
            changed = adopt(config)
        elif args.action == "seal":
            changed = seal(config, args.recovery_share_file)
        elif args.action == "link":
            changed = link(config)
        elif args.action == "unlock":
            marker = runtime / ".unlocked"
            if not marker.is_file():
                changed = unlock(config, args.recovery_share_file)
        elif args.action == "verify":
            verify(config)
        elif args.action == "check":
            verify(config)
            check_bundle(config, args.recovery_share_file)
        else:
            marker = runtime / ".unlocked"
            print("unlocked" if marker.is_file() else "locked")
            return 0
    finally:
        os.close(descriptor)
    print("changed" if changed else "unchanged")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except SecretError as error:
        print(f"Runtime-секреты: {error}", file=sys.stderr)
        raise SystemExit(1) from None
