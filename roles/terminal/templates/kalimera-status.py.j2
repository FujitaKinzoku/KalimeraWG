RESET = "\033[0m"
BLUE = "\033[1;34m"
CYAN = "\033[1;36m"
GREEN = "\033[1;32m"
YELLOW = "\033[1;33m"
WHITE = "\033[1;37m"
DIM = "\033[2m"


def colour_enabled() -> bool:
    return (
        sys.stdout.isatty()
        and not os.environ.get("NO_COLOR")
        and os.environ.get("TERM", "dumb") != "dumb"
    )


USE_COLOUR = colour_enabled()


def paint(value: str, colour: str) -> str:
    return f"{colour}{value}{RESET}" if USE_COLOUR else value


def run(argv: list[str], timeout: int = 5) -> subprocess.CompletedProcess[str] | None:
    process: subprocess.Popen[str] | None = None
    try:
        process = subprocess.Popen(
            argv,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            start_new_session=True,
        )
        stdout, stderr = process.communicate(timeout=timeout)
        return subprocess.CompletedProcess(argv, process.returncode, stdout, stderr)
    except subprocess.TimeoutExpired:
        if process is not None:
            try:
                os.killpg(process.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
            process.communicate()
        return None
    except (FileNotFoundError, PermissionError):
        return None


def service_active(unit: str) -> bool:
    result = run(["systemctl", "is-active", "--quiet", unit])
    return result is not None and result.returncode == 0


def interface_mtu(interface: str) -> int | None:
    value = Path(f"/sys/class/net/{interface}/mtu")
    try:
        return int(value.read_text(encoding="ascii").strip())
    except (OSError, ValueError):
        return None


def mtu_state() -> dict[str, int]:
    result: dict[str, int] = {}
    path = Path("/var/lib/awg-iac/mtu.yml")
    try:
        for line in path.read_text(encoding="utf-8").splitlines():
            match = re.fullmatch(r"\s*([a-z_]+):\s*([0-9]+)\s*", line)
            if match:
                result[match.group(1)] = int(match.group(2))
    except OSError:
        pass
    return result


def current_dot() -> str:
    path = Path("/etc/unbound/unbound.conf.d/90-awg-dot.conf")
    try:
        values = re.findall(
            r"^\s*forward-addr:\s*([^\s#]+(?:@\d+)?(?:#[^\s]+)?)",
            path.read_text(encoding="utf-8"),
            flags=re.MULTILINE,
        )
        return ", ".join(values) if values else CONFIG["default_dot"]
    except OSError:
        return CONFIG["default_dot"]


def current_doh() -> str:
    path = Path("/etc/sing-box/config.json")
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        servers = data.get("dns", {}).get("servers", [])
        server = next(item for item in servers if item.get("tag") == "yandex-doh-ru")
        address = str(server.get("server", CONFIG["default_doh_server"]))
        endpoint = server.get("tls", {}).get("server_name", CONFIG["default_doh_tls"])
        path_value = server.get("path", CONFIG["default_doh_path"])
        return f"{address}{path_value} (TLS: {endpoint})"
    except (OSError, ValueError, TypeError, StopIteration):
        return (
            f"{CONFIG['default_doh_server']}{CONFIG['default_doh_path']} "
            f"(TLS: {CONFIG['default_doh_tls']})"
        )


def audit_state() -> tuple[str, str]:
    result = run(["/usr/local/sbin/server-audit", "--quiet"], timeout=12)
    if result is None:
        return "WARN", "полная проверка недоступна или превысила 12 секунд"
    if result.returncode == 0:
        return "OK", "server-audit: все проверки пройдены"
    return "FAIL", f"server-audit: обнаружены ошибки (код {result.returncode})"


def ssh_key_only() -> bool:
    result = run(["sshd", "-T"], timeout=4)
    if result is None or result.returncode != 0:
        return False
    settings = dict(
        line.split(None, 1) for line in result.stdout.splitlines() if " " in line
    )
    return (
        settings.get("pubkeyauthentication") == "yes"
        and settings.get("passwordauthentication") == "no"
        and settings.get("kbdinteractiveauthentication") == "no"
    )


def no_logs_baseline() -> bool:
    expected = {
        Path("{{ security_journald_dropin_path | default('/etc/systemd/journald.conf.d/zz-kalimerawg-no-logs.conf') }}"): (
            "Storage=volatile",
            "ForwardToSyslog=no",
        ),
        Path("/etc/systemd/coredump.conf.d/90-kalimerawg-no-storage.conf"): (
            "Storage=none",
            "ProcessSizeMax=0",
        ),
        Path("/etc/fail2ban/fail2ban.local"): (
            "logtarget = SYSTEMD-JOURNAL",
            "dbfile = :memory:",
        ),
    }
    try:
        return all(
            all(value in path.read_text(encoding="utf-8") for value in values)
            for path, values in expected.items()
        )
    except OSError:
        return False


def state_word(active: bool, available: bool = True) -> str:
    if not available:
        return "не предусмотрен текущей конфигурацией"
    return "включён" if active else "выключен до создания совместимого клиента"


def format_mtu(value: int | None) -> str:
    return str(value) if value is not None else "не определён"


def proxy_route() -> tuple[str, str]:
    if not CONFIG["proxy_configured"]:
        return "VPN-клиент → ENTRY → Интернет", "SOCKS5 не настроен"
    manual = Path(CONFIG["proxy_manual_flag"]).exists()
    fail_open = Path(CONFIG["proxy_disabled_flag"]).exists()
    active = service_active("sing-box.service") and not manual and not fail_open
    if active:
        return (
            "VPN-клиент → ENTRY → SOCKS5/TUN → Интернет",
            "DoH через активный RU-прокси",
        )
    reason = "ручное отключение" if manual else "автоматический fail-open"
    return f"VPN-клиент → ENTRY → Интернет ({reason})", "RU DoH настроен, прокси сейчас неактивен"


def panel(title: str, rows: list[tuple[str, str, str]]) -> None:
    terminal_width = shutil.get_terminal_size((88, 24)).columns
    width = max(44, min(96, terminal_width - 2))
    inner = width - 2
    label_width = min(28, max(len(label) for label, _, _ in rows))
    value_width = max(12, width - label_width - 7)
    heading = f" {title} "
    top = "┌" + heading + "─" * max(0, inner - len(heading)) + "┐"
    print(paint(top, BLUE))
    for label, value, level in rows:
        prefix = "✓ " if level == "OK" else ("! " if level in {"WARN", "FAIL"} else "")
        wrapped = textwrap.wrap(
            prefix + value,
            width=value_width,
            replace_whitespace=False,
            drop_whitespace=False,
            break_long_words=False,
            break_on_hyphens=False,
        ) or [""]
        for index, part in enumerate(wrapped):
            shown_label = label if index == 0 else ""
            label_text = f"{shown_label:<{label_width}}"
            value_text = f"{part:<{value_width}}"
            value_colour = GREEN if level == "OK" else (YELLOW if level in {"WARN", "FAIL"} else WHITE)
            print(
                paint("│ ", BLUE)
                + paint(label_text, CYAN)
                + paint(" │ ", BLUE)
                + paint(value_text, value_colour)
                + paint(" │", BLUE)
            )
    print(paint("└" + "─" * inner + "┘", BLUE))


