def main() -> int:
    with_commands = False
    if len(sys.argv) > 1:
        if len(sys.argv) == 2 and sys.argv[1] in {"-h", "--help"}:
            print("Использование: kalimera-status [--with-commands]")
            return 0
        if len(sys.argv) == 2 and sys.argv[1] == "--with-commands":
            with_commands = True
        else:
            print("Использование: kalimera-status [--with-commands]", file=sys.stderr)
            return 2

    role = CONFIG["role"].upper()
    panel(
        f"KALIMERAWG · ТЕКУЩАЯ КОНФИГУРАЦИЯ · {role} СЕРВЕР",
        [
            ("Состояние", "адреса, режимы и MTU считываются из установленной системы", "OK"),
            ("Безопасность", "закрытые ключи, PSK, пароли и токены не выводятся", "INFO"),
        ],
    )

    old_active = service_active(f"awg-quick@{CONFIG['legacy_interface']}.service")
    mobile_active = service_active(f"awg-quick@{CONFIG['mobile_interface']}.service")
    if CONFIG["role"] == "entry":
        old_text = state_word(old_active, CONFIG["legacy_available"])
        mobile_text = f"QUIC-профиль; {state_word(mobile_active, CONFIG['mobile_available'])}"
        old_level = "OK" if old_active else "INFO"
        mobile_level = "OK" if mobile_active else "INFO"
    else:
        old_text = (
            "предусмотрен; фактическое состояние проверяется на ENTRY"
            if CONFIG["legacy_available"]
            else "не предусмотрен текущей конфигурацией"
        )
        mobile_text = (
            "QUIC-профиль предусмотрен; фактическое состояние проверяется на ENTRY"
            if CONFIG["mobile_available"]
            else "не предусмотрен текущей конфигурацией"
        )
        old_level = "INFO"
        mobile_level = "INFO"
    local_transit = (
        CONFIG["entry_transit_interface"]
        if CONFIG["role"] == "entry"
        else CONFIG["exit_transit_interface"]
    )
    transit_active = interface_mtu(local_transit) is not None

    panel(
        "ПОДКЛЮЧЕНИЯ",
        [
            ("SSH ENTRY", f"{CONFIG['entry_user']}@{CONFIG['entry_host']}:{CONFIG['entry_ssh_port']}", "INFO"),
            ("SSH EXIT", f"{CONFIG['exit_user']}@{CONFIG['exit_host']}:{CONFIG['exit_ssh_port']}", "INFO"),
            ("VPN-клиенты", f"{CONFIG['entry_host']}:{CONFIG['client_port']}/UDP", "INFO"),
            ("Старые клиенты", f"{CONFIG['entry_host']}:{CONFIG['legacy_port']}/UDP; {old_text}", old_level),
            ("Мобильные клиенты", f"{CONFIG['entry_host']}:{CONFIG['mobile_port']}/UDP; {mobile_text}", mobile_level),
            ("Канал ENTRY–EXIT", f"{CONFIG['exit_host']}:{CONFIG['exit_transit_port']} · AWG 3+ userspace; {'активен' if transit_active else 'не обнаружен'}", "OK" if transit_active else "FAIL"),
        ],
    )

    if CONFIG["role"] == "entry":
        ru_route, doh_note = proxy_route()
        panel(
            "СХЕМА РАБОТЫ И DNS",
            [
                ("Основной маршрут", "VPN-клиент → ENTRY → EXIT → Интернет", "INFO"),
                ("RU-трафик", ru_route, "INFO"),
                ("RU DNS", f"{doh_note}: {current_doh()}", "INFO"),
                ("Основной DNS", f"Unbound DoT: {current_dot()}", "INFO"),
            ],
        )
    else:
        panel(
            "СХЕМА РАБОТЫ И DNS",
            [
                ("Транзит", "ENTRY → EXIT → Интернет", "INFO"),
                ("RU-трафик", "SOCKS5/TUN управляется и проверяется на ENTRY сервере", "INFO"),
                ("DNS", "DoT/DoH управляются и проверяются на ENTRY сервере", "INFO"),
            ],
        )

    saved_mtu = mtu_state()
    transit_mtu = interface_mtu(local_transit) or saved_mtu.get("transit_mtu")
    client_mtu = interface_mtu(CONFIG["entry_client_interface"]) or saved_mtu.get("client_mtu")
    old_mtu = interface_mtu(CONFIG["legacy_interface"]) or min(transit_mtu or 1280, 1280)
    mobile_mtu = interface_mtu(CONFIG["mobile_interface"]) or saved_mtu.get("mobile_client_mtu")
    panel(
        "АВТОМАТИЧЕСКИ СОГЛАСОВАННЫЙ MTU",
        [
            ("Внешний PMTU", format_mtu(saved_mtu.get("shared_outer_pmtu")), "INFO"),
            ("MTU AWG 3+", format_mtu(transit_mtu), "OK" if transit_mtu else "WARN"),
            ("MTU клиентов", format_mtu(client_mtu), "OK" if client_mtu else "WARN"),
            ("MTU old-клиентов", format_mtu(old_mtu), "OK" if old_active else "INFO"),
            ("MTU mobile-клиентов", format_mtu(mobile_mtu), "OK" if mobile_active else "INFO"),
        ],
    )

    ufw_active = run(["ufw", "status"], timeout=4)
    ufw_ok = ufw_active is not None and "Status: active" in ufw_active.stdout
    fail2ban_ok = service_active("fail2ban.service")
    ssh_ok = ssh_key_only()
    no_logs_ok = no_logs_baseline()
    audit_level, audit_text = audit_state()
    entry_policy = (
        f"TCP/{CONFIG['entry_ssh_port']} SSH; UDP/{CONFIG['client_port']} клиенты; "
        f"UDP/{CONFIG['mobile_port']} mobile при включении; UDP/{CONFIG['entry_transit_port']} "
        f"только от {CONFIG['exit_host']}"
    )
    exit_policy = (
        f"TCP/{CONFIG['exit_ssh_port']} SSH; UDP/{CONFIG['exit_transit_port']} "
        f"только от {CONFIG['entry_host']}"
    )
    panel(
        "ЗАЩИТА ВНЕШНИХ ИНТЕРФЕЙСОВ",
        [
            ("UFW ENTRY", entry_policy, "INFO"),
            ("UFW EXIT", exit_policy, "INFO"),
            ("Локальный UFW", "активен" if ufw_ok else "неактивен или недоступен", "OK" if ufw_ok else "FAIL"),
            ("Доступ SSH", "только по публичному ключу" if ssh_ok else "политика key-only не подтверждена", "OK" if ssh_ok else "WARN"),
            ("Fail2Ban", "активен" if fail2ban_ok else "неактивен", "OK" if fail2ban_ok else "FAIL"),
            (
                "No-logs",
                "активность не сохраняется на диск" if no_logs_ok else "политика не подтверждена",
                "OK" if no_logs_ok else "FAIL",
            ),
            ("Полная проверка", audit_text, audit_level),
        ],
    )
    if with_commands:
        command_panels()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
