#!/usr/bin/env bash
set -uo pipefail

usage() { echo 'Использование: kalimera-test'; }
case "${1:-}" in
    '') [[ $# -eq 0 ]] || { usage >&2; exit 2; } ;;
    --help|-h) [[ $# -eq 1 ]] || { usage >&2; exit 2; }; usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
esac

[[ $EUID -eq 0 ]] || { echo 'Запустите команду через управление KalimeraWG.' >&2; exit 1; }

readonly role={{ awg_node_role | default('unknown') | quote }}
failures=0

printf 'KalimeraWG: полная проверка роли %s\n' "$role"

if ! /usr/local/sbin/awg-health --strict; then
    failures=$((failures + 1))
fi

if ! /usr/local/sbin/server-audit; then
    failures=$((failures + 1))
fi

failed_units="$(systemctl --failed --no-legend --plain --no-pager || true)"
if [[ -n "$failed_units" ]]; then
    printf 'FAIL обнаружены неисправные модули systemd:\n%s\n' "$failed_units"
    failures=$((failures + 1))
else
    printf 'OK   неисправные модули systemd отсутствуют\n'
fi

case "$role" in
    entry)
        if systemctl is-enabled --quiet kalimera-front-backend.service 2>/dev/null; then
            if systemctl is-active --quiet kalimera-front-backend.service &&
                ! systemctl cat sing-box.service 2>/dev/null | grep -Fq 'front-backend.json'; then
                printf 'OK   FRONT backend изолирован от RU-прокси\n'
            else
                printf 'FAIL FRONT backend не изолирован от RU-прокси\n'
                failures=$((failures + 1))
            fi
        fi
        printf 'INFO проверены клиенты, AWG 3+, DNS, RU-маршрутизация и FRONT backend\n'
        ;;
    exit)
        printf 'INFO проверены AWG 3+, NAT, изоляция и внешний маршрут\n'
        ;;
    front)
        user_count="$(/usr/local/sbin/vless-user list 2>/dev/null | awk 'NF {count++} END {print count+0}')"
        if [[ "$user_count" =~ ^[1-9][0-9]*$ ]]; then
            printf 'OK   VLESS-пользователей: %s\n' "$user_count"
        else
            printf 'FAIL реестр VLESS-пользователей пуст или недоступен\n'
            failures=$((failures + 1))
        fi
        printf 'INFO проверены Nginx, Xray-core, TLS, доступ к ENTRY и внешняя защита\n'
        ;;
esac

if (( failures == 0 )); then
    printf 'GOOD: полная проверка роли %s пройдена\n' "$role"
    exit 0
fi
printf 'BAD: роль %s, ошибок: %d\n' "$role" "$failures"
exit 1
